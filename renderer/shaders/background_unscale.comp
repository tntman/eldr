#version 450

// Refraction's copy of the opaque colour (Transparency::RecordBackground)
// without the light path intensities (Frame::directIntensity,
// indirectIntensity): the shading pass scaled each pixel's direct and
// indirect light, its light splits (aov.h) keep them unscaled, so glass
// scales what it refracts once, as traced refraction does.
// The splits are unfogged, the colour fogged: the difference goes through
// the fog's transmittance (layer 0's alpha).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba16f) uniform image2D background;  // level 0
layout(set = 0, binding = 1, rgba16f) uniform readonly image2DArray splits;
layout(push_constant) uniform Params {
    vec4 lightPath;  // x: direct, y: indirect intensity
} pc;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(background)))) {
        return;
    }
    vec4 first = imageLoad(splits, ivec3(p, 0));
    vec3 direct = first.rgb + imageLoad(splits, ivec3(p, 2)).rgb;
    vec3 indirect = imageLoad(splits, ivec3(p, 1)).rgb + imageLoad(splits, ivec3(p, 3)).rgb;
    vec4 c = imageLoad(background, p);
    c.rgb += first.a * ((1.0 - pc.lightPath.x) * direct + (1.0 - pc.lightPath.y) * indirect);
    imageStore(background, p, c);
}
