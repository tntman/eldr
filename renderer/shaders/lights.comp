#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#define LIGHTS_WRITABLE
#include "frame.glsl"
#include "lights.glsl"

// Clustered light assignment, one invocation per cluster: the cluster's
// world-space bounds (its frustum slice; for the world light grid's cells,
// their box) against every sphere/rect light's range sphere.
// ponytail: every cluster loops over every light (twice when its list
// overflows); a coarser pre-pass or a light BVH if that shows up in timings.

layout(local_size_x = 64) in;

const int kImportanceBins = 24;

// How strongly the light reaches the box lo..hi: -1 not at all (past its
// range, LightRange), else log2 of (range / distance)^2 to the box's
// nearest point (its light there over the cutoff), 0 to kImportanceBins - 1.
int Importance(Light light, vec3 lo, vec3 hi)
{
    vec3 q = clamp(light.position.xyz, lo, hi) - light.position.xyz;
    float range = LightRange(light), d2 = dot(q, q);
    if (d2 > range * range) {
        return -1;
    }
    return clamp(int(log2(range * range / max(d2, 1e-20))), 0, kImportanceBins - 1);
}

vec3 Unproject(vec3 ndc)
{
    vec4 p = frame.invViewProj * vec4(ndc, 1.0);
    return p.xyz / p.w;
}

void main()
{
    uint c = gl_GlobalInvocationID.x;
    uint view = kClustersX * kClustersY * kClustersZ, n = uint(frame.lightGrid[0].w);
    if (c >= view + n * n * n) {
        return;
    }
    uint x = c % kClustersX, y = (c / kClustersX) % kClustersY, z = c / (kClustersX * kClustersY);
    float d0 = frame.clusters.x * exp2(frame.clusters.z * float(z) / float(kClustersZ));
    float d1 = frame.clusters.x * exp2(frame.clusters.z * float(z + 1u) / float(kClustersZ));

    // Each corner ray of the tile, cut at the slice's two depths. Works for
    // perspective and orthographic cameras alike. Past the view's clusters:
    // a cell of the world light grid (LightGridBase).
    vec3 lo = vec3(1e30), hi = vec3(-1e30);
    if (c >= view) {
        uint g = c - view;
        vec3 cell = vec3(g % n, (g / n) % n, g / (n * n));
        vec3 size = frame.lightGrid[1].xyz - frame.lightGrid[0].xyz;
        lo = frame.lightGrid[0].xyz + size * cell / float(n);
        hi = frame.lightGrid[0].xyz + size * (cell + 1.0) / float(n);
    }
    for (uint k = 0u; k < 4u && c < view; ++k) {
        vec2 ndc = vec2(float(x + (k & 1u)) / float(kClustersX),
                        float(y + (k >> 1u)) / float(kClustersY)) * 2.0 - 1.0;
        vec3 a = Unproject(vec3(ndc, -1.0)), b = Unproject(vec3(ndc, 0.0));
        float fa = dot(a - frame.cameraPos.xyz, frame.cameraForward.xyz);
        float fb = dot(b - frame.cameraPos.xyz, frame.cameraForward.xyz);
        vec3 p0 = a + (b - a) * ((d0 - fa) / (fb - fa));
        vec3 p1 = a + (b - a) * ((d1 - fa) / (fb - fa));
        lo = min(lo, min(p0, p1));
        hi = max(hi, max(p0, p1));
    }

    uint base = c * (kMaxClusterLights + 1u);
    uint count = 0u;
    bool overflow = false;
    for (uint i = 0u; i < frame.localLights.x; ++i) {
        if (Importance(lights[frame.counts.x + i], lo, hi) >= 0) {
            if (count == kMaxClusterLights) {
                overflow = true;
                break;
            }
            clusterLights[base + 1u + count] = frame.counts.x + i;
            ++count;
        }
    }
    if (overflow) {
        // More lights reach the cluster than its list holds: the strongest
        // there (by factors of 2 of their light at its nearest point) take
        // it; of the band where it cuts off, the first in light order.
        uint bins[kImportanceBins];
        for (int b = 0; b < kImportanceBins; ++b) {
            bins[b] = 0u;
        }
        for (uint i = 0u; i < frame.localLights.x; ++i) {
            int b = Importance(lights[frame.counts.x + i], lo, hi);
            if (b >= 0) {
                ++bins[b];
            }
        }
        int cut = kImportanceBins - 1;
        uint above = 0u;  // lights in the bins above `cut`
        while (cut > 0 && above + bins[cut] <= kMaxClusterLights) {
            above += bins[cut];
            --cut;
        }
        uint quota = kMaxClusterLights - above;  // of the cut bin
        count = 0u;
        for (uint i = 0u; i < frame.localLights.x && count < kMaxClusterLights; ++i) {
            int b = Importance(lights[frame.counts.x + i], lo, hi);
            if (b > cut || (b == cut && quota > 0u)) {
                quota -= b == cut ? 1u : 0u;
                clusterLights[base + 1u + count] = frame.counts.x + i;
                ++count;
            }
        }
    }
    clusterLights[base] = count;
}
