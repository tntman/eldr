#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require
#define RAY_TRACING
#include "frame.glsl"
#include "scene.glsl"
#include "material.glsl"
#include "rt.glsl"
#include "gi.glsl"

// Shadow rays' any hit: a translucent caster (only shadow rays that tint
// see them, rt.shadowInfo.x) multiplies what passes by what it lets through,
// as its tint map would (ShadowTransmission), and the ray goes on; a cutout
// blocks it where it has a surface (rt.rahit's test). Translucent BLASes
// have no duplicate any-hit calls, so each surface counts once; a closed
// mesh counts its two sides, as the tint maps do.
hitAttributeEXT vec2 barycentrics;
layout(location = 1) rayPayloadInEXT vec4 shadowRay;

void main()
{
    uint slot = gl_InstanceCustomIndexEXT;
    if ((draws[slot].visible & kRaysShadow) == 0u) {  // a translucent mesh shadows don't see (tlas.comp)
        ignoreIntersectionEXT;
    }
    // Light linking: TraceShadow's shadow link bit, -(bit + 1) in a (its
    // rays force every surface through here); casters outside it don't
    // block, opaque ones in it do.
    int shadowLink = int(-shadowRay.a) - 1;
    if (shadowLink >= 0) {
        if ((RtLinkMask(uint(gl_InstanceID)) & (1u << uint(shadowLink))) == 0u) {
            ignoreIntersectionEXT;
        }
        if ((rtSlots[slot].flags & (kRtSlotCutout | kRtSlotTranslucent)) == 0u) {
            return;
        }
    }
    uint material = draws[slot].material;
    bool translucent = (rtSlots[slot].flags & kRtSlotTranslucent) != 0u;
    if (material == kNoMaterial) {
        if (translucent) {  // fully transparent: as the tint map (it lets all through)
            ignoreIntersectionEXT;
        }
        return;
    }
    uint triangle = uint(gl_PrimitiveID);
    vec3 b = vec3(1.0 - barycentrics.x - barycentrics.y, barycentrics);
    vec2 uv = RtUv(RtVertex(slot, triangle, 0u)) * b.x + RtUv(RtVertex(slot, triangle, 1u)) * b.y +
              RtUv(RtVertex(slot, triangle, 2u)) * b.z;
    if (translucent) {
        shadowRay.rgb *= clamp(ShadowTransmission(materials[material], uv), 0.0, 1.0);
        ignoreIntersectionEXT;
    }
    if (!Present(materials[material], uv)) {  // finest mip: no ray cone here
        ignoreIntersectionEXT;
    }
}
