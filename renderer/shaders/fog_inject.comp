#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#include "frame.glsl"
#include "lights.glsl"
#include "fog.glsl"
#include "gi.glsl"

// Volumetric fog, one invocation per froxel: the medium at a depth jittered
// within the slice (height fog: density * exp(-falloff * (height - base)))
// and the light it scatters towards the camera (Henyey-Greenstein): every
// distant light (the shadow-casting one through its cascades), the local
// lights of the froxel's cluster as points (through their atlas tiles) and
// the dome's average radiance, or with GI (kFogGiAmbient) the probes'
// light there, so interiors, whose probes see walls rather than sky, get
// less haze. Blended with last frame's grid reprojected to the same point,
// so the jitter averages out over frames.
// ponytail: single-tap shadows (no PCF: the jitter and the history blur
// them); local lights as points of their area's intensity; without GI the
// dome's light is unoccluded.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(set = 0, binding = 47, rgba16f) uniform image3D fogImages[3];  // this frame's, last frame's, integrated
layout(set = 0, binding = 4) uniform sampler2DArrayShadow shadowMap;
// The sun's tint map (Transparency, volume_shadow.frag): what volumes (and
// translucent casters) let through, receivers behind the stored depth.
layout(set = 0, binding = 43) uniform sampler2DArray sunTint;
layout(set = 0, binding = 44) uniform sampler2DArray sunTintDepth;
// The local lights' atlas tint map, tiles as the shadow atlas's.
layout(set = 0, binding = 45) uniform sampler2D atlasTint;
layout(set = 0, binding = 46) uniform sampler2D atlasTintDepth;
// Local lights' shadow atlas, as in mesh.frag.
const float kSpotShadowCone = 1.3962634;
struct ShadowTile {
    mat4 viewProj;
    vec4 rect;
    vec4 params;
    vec4 origin;
};
layout(set = 0, binding = 17) uniform sampler2DShadow shadowAtlas;
layout(std430, set = 0, binding = 18) readonly buffer LightShadows { uint lightShadow[]; };
layout(std430, set = 0, binding = 19) readonly buffer ShadowTiles { ShadowTile shadowTiles[]; };

vec3 Unproject(vec3 ndc)
{
    vec4 p = frame.invViewProj * vec4(ndc, 1.0);
    return p.xyz / p.w;
}

float SunShadow(vec3 p, float viewDepth)
{
    int c = 0;
    while (c < 4 && viewDepth > frame.cascadeSplits[c]) {
        ++c;
    }
    if (c == 4) {
        return 1.0;
    }
    vec4 clip = frame.cascadeViewProj[c] * vec4(p, 1.0);
    return texture(shadowMap, vec4(clip.xy / clip.w * 0.5 + 0.5, float(c), clip.z / clip.w * 0.5 + 0.5));
}

const uint kFeatureTranslucentShadows = 8192u;  // as transparency.glsl's

// What a tint texel (colour c, depth d) lets through to window depth ref:
// all of it behind the volumes' optical-depth range d +- w (alpha 1 -
// w^(1/4), volume_shadow.frag; 0 width for translucent casters), a linear
// share of its optical depth inside it, so fog inside a volume is shadowed
// by the part of it nearer the light.
// ponytail: one range per texel: with glass nearer the light in the same
// texel, the range centres on the glass.
vec3 TintThrough(vec4 c, float d, float ref)
{
    float w = 1.0 - c.a;
    w *= w;
    w *= w;
    float f = w > 0.0 ? clamp((ref - d + w) / (2.0 * w), 0.0, 1.0) : (ref > d ? 1.0 : 0.0);
    return pow(max(c.rgb, vec3(1e-4)), vec3(f));
}

// The sun's tint map at p (kFeatureTranslucentShadows: whenever volumes or
// translucent casters draw into it, as surfaces read it): one nearest tap.
vec3 SunTint(vec3 p, float viewDepth)
{
    int c = 0;
    while (c < 4 && viewDepth > frame.cascadeSplits[c]) {
        ++c;
    }
    if (c == 4) {
        return vec3(1.0);
    }
    vec4 clip = frame.cascadeViewProj[c] * vec4(p, 1.0);
    vec3 ndc = clip.xyz / clip.w;
    ivec2 size = textureSize(sunTint, 0).xy;
    ivec3 q = ivec3(clamp(ivec2((ndc.xy * 0.5 + 0.5) * vec2(size)), ivec2(0), size - 1), c);
    return TintThrough(texelFetch(sunTint, q, 0), texelFetch(sunTintDepth, q, 0).r, ndc.z * 0.5 + 0.5);
}

// A local light's shadow at p, its atlas tile's depth times its tint
// (kFeatureTranslucentShadows: volumes and translucent casters).
vec3 LocalShadow(uint index, Light light, vec3 p)
{
    uint tile = lightShadow[index];
    if (tile == kNone) {
        return vec3(1.0);
    }
    vec3 fromLight = p - shadowTiles[tile].origin.xyz;
    if (light.shaping.y > kSpotShadowCone) {
        vec3 a = abs(fromLight);
        tile += a.x >= a.y && a.x >= a.z ? (fromLight.x > 0.0 ? 0u : 1u)
              : a.y >= a.z               ? (fromLight.y > 0.0 ? 2u : 3u)
                                         : (fromLight.z > 0.0 ? 4u : 5u);
    }
    ShadowTile t = shadowTiles[tile];
    vec4 clip = t.viewProj * vec4(p, 1.0);
    vec3 ndc = clip.xyz / clip.w;
    if (clip.w <= 0.0 || any(greaterThan(abs(ndc.xy), vec2(1.0)))) {
        return vec3(1.0);  // outside a spot's tile: its cone doesn't light it anyway
    }
    vec2 uv = t.rect.xy + (ndc.xy * 0.5 + 0.5) * t.rect.zw;
    float ref = ndc.z * 0.5 + 0.5;
    vec3 shadow = vec3(texture(shadowAtlas, vec3(uv, ref)));
    if (Feature(kFeatureTranslucentShadows)) {
        ivec2 size = textureSize(atlasTint, 0);
        ivec2 q = clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1);
        shadow *= TintThrough(texelFetch(atlasTint, q, 0), texelFetch(atlasTintDepth, q, 0).r, ref);
    }
    return shadow;
}

float Phase(float cosTheta)
{
    float g = frame.fogMedium.w;
    float d = 1.0 + g * g - 2.0 * g * cosTheta;
    return (1.0 - g * g) / (4.0 * PI * d * sqrt(d));
}

// A local light seen from p as a point of its area's intensity, with its
// shaping, range window and shadow.
vec3 LocalLight(uint index, vec3 p, vec3 toCamera)
{
    Light light = lights[index];
    vec3 toLight = light.position.xyz - p;
    float d = length(toLight);
    float window = clamp(1.0 - pow(d / LightRange(light), 4.0), 0.0, 1.0);
    if (window <= 0.0 || d <= 0.0) {
        return vec3(0.0);
    }
    vec3 l = toLight / d;
    float cosOff = dot(-l, light.axis.xyz);
    float theta = acos(clamp(cosOff, -1.0, 1.0));
    float shaping = light.shaping.y <= light.shaping.x ? (theta <= light.shaping.y ? 1.0 : 0.0)
                                                       : 1.0 - smoothstep(light.shaping.x, light.shaping.y, theta);
    vec3 radiance = light.color.rgb * shaping * LightTint(light, p);
    if (light.shaping.z > 0.0) {
        radiance *= mix(light.focusTint.rgb, vec3(1.0), pow(abs(cosOff), light.shaping.z));
    }
    // Projected area towards p.
    uint type = uint(light.position.w);
    float area;
    if (type == kLightSphere) {
        area = PI * light.axis.w * light.axis.w;
    } else if (type == kLightCylinder) {
        float h = length(light.halfWidth.xyz);
        area = 4.0 * light.axis.w * h * length(cross(light.halfWidth.xyz / max(h, 1e-8), l));
    } else {
        area = (type == kLightRect ? 4.0 : PI) * length(cross(light.halfWidth.xyz, light.halfHeight.xyz)) *
               max(cosOff, 0.0);
    }
    return radiance * (area * window * window / (d * d) * Phase(dot(-l, toCamera)) * light.halfHeight.w) *
           LocalShadow(index, light, p);
}

vec4 History(vec3 coord)
{
    // Trilinear from texel centers at integer coordinates, edges clamped.
    ivec3 size = ivec3(frame.fogGrid.xyz) - 1;
    vec3 base = floor(coord), f = coord - base;
    vec4 sum = vec4(0.0);
    for (int i = 0; i < 8; ++i) {
        ivec3 o = ivec3(i & 1, (i >> 1) & 1, i >> 2);
        vec3 w = mix(1.0 - f, f, vec3(o));
        sum += w.x * w.y * w.z * imageLoad(fogImages[1], clamp(ivec3(base) + o, ivec3(0), size));
    }
    return sum;
}

void main()
{
    uvec3 id = gl_GlobalInvocationID;
    if (any(greaterThanEqual(id, frame.fogGrid.xyz))) {
        return;
    }
    vec3 grid = vec3(frame.fogGrid.xyz);
    vec3 jitter = vec3(0.5, 0.5, frame.fogTemporal.x);
    if (frame.sampleInfo.y != 0u) {  // a film sample: a point of the froxel's own (sample dimensions)
        vec2 q = vec2(id.xy) + vec2(id.z * 17u, id.z * 29u);
        jitter = vec3(SampleNoise(kDimFog, q, float(frame.localLights.y)),
                      SampleNoise(kDimFog, q + vec2(31.0, 7.0), float(frame.localLights.y) + 3.0),
                      SampleNoise(kDimFog, q + vec2(11.0, 47.0), float(frame.localLights.y) + 7.0));
    }
    vec2 ndc = (vec2(id.xy) + jitter.xy) / grid.xy * 2.0 - 1.0;
    float depth = FogSliceDepth((float(id.z) + jitter.z) / grid.z);
    vec3 a = Unproject(vec3(ndc, -1.0)), b = Unproject(vec3(ndc, 0.0));
    vec3 forward = frame.cameraForward.xyz;
    float fa = dot(a - frame.cameraPos.xyz, forward), fb = dot(b - frame.cameraPos.xyz, forward);
    vec3 p = a + (b - a) * ((depth - fa) / (fb - fa));
    vec3 toCamera = normalize(a - b);

    float height = frame.fogGrid.w != 0u ? p.z : p.y;
    float density = frame.fogMedium.x * exp(clamp(-frame.fogMedium.y * (height - frame.fogMedium.z), -80.0, 20.0));
    vec3 light = vec3(0.0);
    for (uint i = 0u; i < frame.counts.x; ++i) {
        Light sun = lights[i];
        vec3 shadow = vec3(i == frame.counts.y ? SunShadow(p, depth) : 1.0);
        if (i == frame.counts.y && Feature(kFeatureTranslucentShadows)) {
            shadow *= SunTint(p, depth);
        }
        light += sun.color.rgb * (sun.halfHeight.w * Phase(dot(-sun.position.xyz, toCamera)) * shadow);
    }
    if (frame.localLights.x > 0u && (frame.features.x & kFeatureClusters) != 0u) {
        uint base = ClusterIndex((vec2(id.xy) + 0.5) / grid.xy * frame.viewport.xy, depth) * (kMaxClusterLights + 1u);
        uint count = clusterLights[base];
        for (uint k = 0u; k < count; ++k) {
            light += LocalLight(ClusterLight(base, k), p, toCamera);
        }
    } else {
        for (uint i = frame.counts.x; i < frame.counts.x + frame.localLights.x; ++i) {
            light += LocalLight(i, p, toCamera);
        }
    }
    if (frame.envRadiance.w > 0.0) {
        vec3 ambient = max(frame.envSh[0].rgb, 0.0) * (0.282095 / PI) * frame.envRadiance.rgb;  // average radiance
        if ((frame.reflections.z & kFogGiAmbient) != 0u) {
            // ponytail: the up and down hemispheres' irradiance / pi for
            // the sphere's average radiance; their own light where the
            // probes don't see p.
            const vec3 up = frame.fogGrid.w != 0u ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
            vec4 a = GiIrradiance(p, up, toCamera), b = GiIrradiance(p, -up, toCamera);
            ambient = mix(ambient, 0.5 * (a.rgb + b.rgb), 0.5 * (a.a + b.a));
        }
        light += ambient;
    }
    vec4 current = vec4(density * frame.fogAlbedo.rgb * light, density);

    if (frame.fogTemporal.y > 0.0) {
        vec4 prev = frame.prevViewProj * vec4(p, 1.0);
        float prevDepth = frame.fogTemporal.w > 0.0 ? depth : prev.w;
        if (prev.w > 0.0 && prevDepth > 0.0) {
            vec3 coord = vec3((prev.xy / prev.w * 0.5 + 0.5) * grid.xy,
                              sqrt(prevDepth / frame.fogTemporal.z) * grid.z) - 0.5;
            if (all(greaterThanEqual(coord, vec3(-0.5))) && all(lessThanEqual(coord, grid - 0.5))) {
                current = mix(History(coord), current, 1.0 - frame.fogTemporal.y);
            }
        }
    }
    imageStore(fogImages[0], ivec3(id), current);
}
