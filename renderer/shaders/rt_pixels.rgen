#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require
#define RAY_TRACING
#include "frame.glsl"
#include "tiles.glsl"
#include "lights.glsl"
#include "scene.glsl"
#include "material.glsl"
#include "rt.glsl"
#include "gi.glsl"
#include "volume.glsl"
#include "rt_shade.glsl"
#include "rt_evaluate.glsl"

// Per pixel, for mesh.frag: a ray through the pixel finds the surface the
// rasterizer shades there (same jittered camera), then shadow rays towards
// the lights of rt.shadowLights (one channel each, four per layer) and reflection rays
// (GGX samples, so rough reflections are noisy per frame and TAA averages
// them). Without a hit both images get neutral values. Where the ray
// finds another surface than the prepass did (a skinned instance beyond
// Frame::rtSkinnedInstances blocks no rays, small-object culling), shadow
// rays start from the prepass's surface instead (its normal from the
// depths around) and there is no traced reflection.
// Final gather (rt.gather.y): a cosine ray shaded where it lands (direct
// light, shadowed with eldr:rtHitShadows; the probes' bounces) or, escaped,
// the dome; back faces give none. With rt.gather.x > 0 the ray stops there
// and a miss takes the probes' light at its end towards the pixel
// (irradiance / pi around the ray: their radiance, blurred): cheaper, but
// that lobe sees past the pixel's horizon, e.g. emitters under a ceiling
// that the ceiling can't see (emissive.usda's ceiling by GI alone: 0.45 for
// 0.25 at its front edge, the floor 20% dark).
layout(set = 0, binding = 53, rgba8) uniform writeonly image2D rtShadowImage;
layout(set = 0, binding = 54, rgba16f) uniform writeonly image2D rtReflectionImage;
layout(set = 0, binding = 87, rgba16f) uniform writeonly image2D rtGatherImage;
layout(set = 1, binding = 11, rgba16f) uniform writeonly image2D gatherGuide;  // octahedral geometric, shading normal
layout(set = 0, binding = 13) uniform sampler2D sceneDepth;  // the prepass depth, window [0, 1]

vec3 PrepassPoint(ivec2 pixel)
{
    pixel = clamp(pixel, ivec2(0), ivec2(gl_LaunchSizeEXT.xy) - 1);
    vec2 ndc = (vec2(pixel) + 0.5) / vec2(gl_LaunchSizeEXT.xy) * 2.0 - 1.0;
    vec4 p = frame.invViewProj * vec4(ndc, texelFetch(sceneDepth, pixel, 0).r * 2.0 - 1.0, 1.0);
    return p.xyz / p.w;
}

// For the traced shadows' denoise (gi.glsl RtTraced): the penumbra's
// half width at p in pixels (`footprint`: a pixel's size there) over 3,
// PCSS-style from the blocker's distance (a closest-hit ray towards the
// light sample u, else its center): the sun's angle, or the light's size
// over its distance from the blocker, times the blocker's from p. 0: no
// blocker found. A hard sun or a contact shadow gets ~0 (no blur).
// The nearest blocker of `light` along dir (hit.t from origin; < 0: none):
// light linking skips surfaces outside its shadow link (up to 4).
void TraceBlocker(Light light, vec3 origin, vec3 dir)
{
    TraceMask(origin, dir, 0.0, kRtMaskShadow);
    float skipped = 0.0;
    for (uint k = 0u; k < 4u && hit.t >= 0.0 && !ShadowLinked(light, RtLinkMask(hit.instance)); ++k) {
        skipped += hit.t;
        vec3 o = OffsetRay(hit.position, dot(dir, hit.geometric) > 0.0 ? hit.geometric : -hit.geometric);
        TraceMask(o, dir, 0.0, kRtMaskShadow);
        hit.t = hit.t < 0.0 ? hit.t : hit.t + skipped;
    }
    if (hit.t >= 0.0 && !ShadowLinked(light, RtLinkMask(hit.instance))) {
        hit.t = -1.0;
    }
}

float PenumbraRadius(uint index, vec3 p, vec3 ng, vec2 u, float footprint)
{
    Light light = lights[index];
    uint type = uint(light.position.w);
    vec3 origin = OffsetRay(p, ng);
    float dist;
    vec3 dir = SampleLight(light, p, u, dist);
    TraceBlocker(light, origin, dir);
    if (hit.t < 0.0 || hit.t >= dist) {
        dir = type == 0u ? light.position.xyz : normalize(light.position.xyz - p);
        dist = type == 0u ? 1e30 : distance(light.position.xyz, p) - (type == kLightSphere ? light.halfWidth.w : 0.0);
        TraceBlocker(light, origin, dir);
        if (hit.t < 0.0 || hit.t >= dist) {
            return 0.0;
        }
    }
    float size = type == 0u              ? 2.0 * tan(light.axis.w)
               : type == kLightSphere    ? 2.0 * light.halfWidth.w / max(dist - hit.t, 1e-6)
               : type == kLightCylinder  ? 2.0 * length(light.halfWidth.xyz) / max(dist - hit.t, 1e-6)
                                         : 2.0 * max(length(light.halfWidth.xyz), length(light.halfHeight.xyz)) /
                                               max(dist - hit.t, 1e-6);
    // At least a step of the encoding: found, but too small to blur.
    return clamp(0.5 * size * hit.t / footprint / 3.0, 1.0 / 255.0, 1.0);
}

// Reflections are traced up to this perceptual roughness, fading out from
// kFadeRoughness; rougher surfaces keep the dome's prefiltered light.
const float kFadeRoughness = 0.5, kMaxRoughness = 0.7;

// A film sample's turn per 8 x 8 block, in [0, 1): a hashed start (salt:
// one per effect) stepped by a Weyl sequence over the samples, so a block
// takes a share `keep` of the samples by turn < keep. Per block, not per
// pixel: a warp waits for its slowest ray, so only whole blocks save.
float BlockTurn(ivec2 pixel, uint salt)
{
    uint u = Pcg3d(uvec3(uvec2(pixel) >> 3u, salt)).x + rt.params.x * 2654435769u;
    return float(u >> 8u) * (1.0 / 16777216.0);
}

// Reflection roulette (rt.denoise.w, eldr:rtReflectionRoulette). 1: only
// a surface whose base reflects nothing (standard_surface or OpenPBR with
// specular weight 0, not metallic, no coat, no graph) skips its rays,
// exactly (mesh.frag weighs the traced light by FssEss = 0). 2, from the
// film's second sample, also: a dim reflection (its Fresnel f: Schlick's
// from the material's F0 and weight at n.v; a dielectric seen head-on
// reflects 4%) traces with probability keep = 3 f, at least 1/8 (sharp
// ones, roughness 0.05 to 0.2: at least 1 to 1/8, a mirror's traced image
// differs most from the fallback's), and its weight counts 1 / keep, so
// mesh.frag's mix(specular, traced, a) averages to the same over the
// film. Decided per 8 x 8 block, not per pixel: a warp waits for its
// slowest ray, so only whole blocks save. Each block steps a Weyl sequence
// over the samples (a hashed start), so it traces in very nearly `keep` of
// them.
float ReflectionKeep(ivec2 pixel, uint slot, vec3 baseColor, float metallic, float NoV, float perceptual)
{
    if (rt.denoise.w == 0.0) {
        return 1.0;
    }
    float dielectric = 0.04 * (1.0 - metallic), metal = metallic;
    uint material = draws[slot].material;
    if (material != kNoMaterial) {
        Material m = materials[material];
        uint model = uint(m.surface.x + 0.5);
        float weight = max(m.specular.w, 0.0), r = (m.refraction.x - 1.0) / (m.refraction.x + 1.0);
        float color = max(max(m.specular.r, m.specular.g), m.specular.b);
        dielectric = model == 0u ? (m.specularColor.w > 0.0 ? max(max(m.specularColor.r, m.specularColor.g),
                                                                   m.specularColor.b) : r * r) * (1.0 - metallic)
                                 : r * r * weight * color * (1.0 - metallic);
        metal = model == 2u ? metallic * weight : metallic;
        if (model != 0u && weight <= 0.0 && metal <= 0.0 && m.coat.x <= 0.0 && m.program.y == 0u) {
            return 0.0;
        }
    }
    if (rt.denoise.w < 2.0) {
        return 1.0;
    }
    float s = pow(1.0 - NoV, 5.0), b = max(max(baseColor.r, baseColor.g), baseColor.b);
    float f = dielectric + (1.0 - dielectric) * s * (1.0 - metallic) + metal * (b + (1.0 - b) * s);
    float keep = clamp(3.0 * f, mix(1.0, 0.125, smoothstep(0.05, 0.2, perceptual)), 1.0);
    return BlockTurn(pixel, 0x9e37u) < keep ? keep : 0.0;
}

// Whether `light` gives p nothing in mesh.frag (LocalLight: past its
// range, outside its cone; light linking by the receiver's linkMask), so
// its shadow ray can stay untraced (eldr:rtLightSampling).
bool LightCulled(Light light, vec3 p, uint linkMask)
{
    if (!LightLinked(light, linkMask)) {
        return true;
    }
    if (uint(light.position.w) == 0u) {
        return false;
    }
    vec3 fromLight = p - light.position.xyz;
    float d = length(fromLight);
    return d >= LightRange(light) ||
           acos(clamp(dot(fromLight / max(d, 1e-20), light.axis.xyz), -1.0, 1.0)) > light.shaping.y + 1e-3;
}

void main()
{
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    if (TileSkipped(pixel)) {
        return;  // a stopped tile (tiles.glsl): its images keep an earlier sample's
    }
    vec2 ndc = (vec2(pixel) + 0.5) / vec2(gl_LaunchSizeEXT.xy) * 2.0 - 1.0;
    vec4 nearPoint = frame.invViewProj * vec4(ndc, -1.0, 1.0), farPoint = frame.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 origin = nearPoint.xyz / nearPoint.w;
    vec3 dir = normalize(farPoint.xyz / farPoint.w - origin);
    TraceMask(origin, dir, 1.0 / frame.viewport.y, kRtMaskCamera);
    bool raster = texelFetch(sceneDepth, pixel, 0).r < 1.0;
    vec3 surface = PrepassPoint(pixel);
    float rasterT = distance(origin, surface);
    // 0 rays for an effect (rt.params.yz, rt.gatherInfo.x; quality below 1
    // under the film): its image stays as the last sample wrote it.
    bool gather = rt.gather.y != 0.0 && rt.gatherInfo.x > 0.0;
    if (hit.t < 0.0 && !raster) {
        if (rt.params.y != 0u) {
            imageStore(rtShadowImage, pixel, vec4(1.0));
        }
        if (rt.params.z != 0u) {
            imageStore(rtReflectionImage, pixel, vec4(0.0));
        }
        if (gather) {
            imageStore(rtGatherImage, pixel, vec4(0.0));
        }
        return;
    }
    vec3 p = hit.position, n = hit.normal, ng = hit.geometric;
    float perceptual = hit.roughness, metallic = hit.metallic;
    vec3 baseColor = hit.baseColor;  // the shadow rays below overwrite hit
    uint slot = hit.slot;
    uint linkMask = ~0u;  // the receiver's light links (LightCulled), unknown on the prepass's surface
    if (raster && (hit.t < 0.0 || abs(hit.t - rasterT) > 0.02 * rasterT)) {
        // Of the differences each way the smaller (less likely across an edge).
        vec3 dx = PrepassPoint(pixel + ivec2(1, 0)) - surface, dx2 = surface - PrepassPoint(pixel - ivec2(1, 0));
        vec3 dy = PrepassPoint(pixel + ivec2(0, 1)) - surface, dy2 = surface - PrepassPoint(pixel - ivec2(0, 1));
        dx = dot(dx2, dx2) < dot(dx, dx) ? dx2 : dx;
        dy = dot(dy2, dy2) < dot(dy, dy) ? dy2 : dy;
        ng = normalize(cross(dx, dy));
        ng = dot(ng, dir) > 0.0 ? -ng : ng;
        p = surface;
        n = ng;
        perceptual = 1.0;  // no reflection
    } else {
        linkMask = RtLinkMask(hit.instance);
    }
    uvec3 seed = uvec3(pixel, rt.params.x);

    // Shadows, rt.shadowInfo.z lights per layer of the image (four grey
    // ones, or one in colour). With the sample dimensions each film sample
    // takes a new point on every light's shape: the CPU's scrambled Sobol
    // point turned by blue noise (each light reading it elsewhere), so the
    // film converges to the exact penumbra.
    // eldr:rtLightSampling: lights that give p nothing (LightCulled) trace
    // no ray (visibility 1). From the film's second sample with over four
    // lights, each 8 x 8 block traces each light in a share rt.shadowSample.z
    // (4 / lights) of the samples, in turn, about four lights a sample;
    // the others store 0 and every texel counts 1 / share (gi.glsl
    // RtShadowTexel), so the film averages to the same.
    if ((frame.features.x & kFeatureRtShadows) != 0u && rt.params.y != 0u) {
        float share = rt.shadowSample.z > 0.0 ? rt.shadowSample.z : 1.0;
        float turn = share < 1.0 ? BlockTurn(pixel, 0x5bd1u) : 0.0;
        bool cull = rt.gatherInfo.w != 0.0;
        uint perTexel = rt.shadowInfo.z;
        vec4 shadows = vec4(1.0);
        // The denoise's penumbra radii (gi.glsl RtTraced), on the prepass's pixels.
        bool penumbra = rt.denoise.x >= 1.0 && raster;
        vec4 blockers = vec4(0.0);
        float footprint = 0.0;
        if (penumbra) {
            vec4 q = frame.invViewProj * vec4(ndc + vec2(2.0 / float(gl_LaunchSizeEXT.x), 0.0),
                                              texelFetch(sceneDepth, pixel, 0).r * 2.0 - 1.0, 1.0);
            footprint = max(distance(q.xyz / q.w, surface), 1e-20);
        }
        for (uint k = 0u; k < 16u; ++k) {
            uint light = rt.shadowLights[k >> 2u][k & 3u];
            if (light == kNone) {
                break;
            }
            vec2 u = Random2(seed + uvec3(0u, 0u, light * 64u), 0u);
            if (frame.sampleInfo.x != 0u) {
                vec4 noise = texelFetch(blueNoise, (pixel + ivec2(k * 23u + 7u, k * 41u + 13u)) & 63, 0);
                u = fract(((k & 1u) != 0u ? noise.zw : noise.xy) + rt.shadowSample.xy);
            }
            bool culled = cull && LightCulled(lights[light], p, linkMask);
            bool traced = !culled && fract(turn + float(k) * share) < share;
            vec3 v = culled ? vec3(share) : traced ? LightVisibility(light, p, ng, u, rt.params.y) : vec3(0.0);
            if (penumbra) {
                blockers[k & 3u] = traced && (perTexel == 1u ? max(max(v.r, v.g), v.b) : v.r) < 1.0
                                       ? PenumbraRadius(light, p, ng, u, footprint) : 0.0;
            }
            if (perTexel == 1u) {
                shadows.rgb = v;
            } else {
                shadows[k & 3u] = v.r;
            }
            uint next = k + 1u < 16u ? rt.shadowLights[(k + 1u) >> 2u][(k + 1u) & 3u] : kNone;
            if ((k + 1u) % perTexel == 0u || next == kNone) {
                imageStore(rtShadowImage, pixel + ivec2(0, int(k / perTexel) * int(rt.shadowSample.w)), shadows);
                shadows = vec4(1.0);
            }
            if (penumbra && ((k & 3u) == 3u || next == kNone)) {
                imageStore(rtShadowImage, pixel + ivec2(0, int(rt.denoise.z + float(k >> 2u)) * int(rt.shadowSample.w)),
                           blockers);
                blockers = vec4(0.0);
            }
        }
    }

    if ((frame.features.x & kFeatureRtReflections) != 0u && rt.params.z != 0u) {
        vec4 reflection = vec4(0.0);
        vec3 v = -dir;
        float keep = perceptual < kMaxRoughness ? ReflectionKeep(pixel, slot, baseColor, metallic, max(dot(v, n), 1e-4), perceptual) : 0.0;
        if (keep > 0.0) {
            float a = perceptual * perceptual;
            vec3 t, b;
            Basis(n, t, b);
            vec3 ve = vec3(dot(v, t), dot(v, b), max(dot(v, n), 1e-4));
            vec3 reflectOrigin = OffsetRay(p, ng);
            uint samples = rt.params.z;
            for (uint s = 0u; s < samples; ++s) {
                vec3 h = SampleGgxVndf(ve, a, Random2(seed + uvec3(0u, 0u, 7919u), s));
                vec3 l = reflect(-v, t * h.x + b * h.y + n * h.z);
                if (dot(l, ng) <= 0.0) {
                    l = reflect(-v, n);  // below the surface: the mirror direction
                }
                Trace(reflectOrigin, l, a);
                EvaluateHit(l, a);
                reflection.rgb += hit.t < 0.0 ? Dome(l, perceptual * float(frame.counts.z - 1u))
                                              : ShadeHit(l, seed, true, (rt.shadowInfo.w & 1u) != 0u);
            }
            reflection.rgb /= float(samples);
            reflection.a = (1.0 - smoothstep(kFadeRoughness, kMaxRoughness, perceptual)) / keep;
        }
        imageStore(rtReflectionImage, pixel, reflection);
    }

    // eldr:finalGatherRoulette: from the film's second sample each 8 x 8
    // block gathers in a share rt.gatherInfo.z of the samples (in turn),
    // weighted 1 / share; the others store 0 (gathered nothing: not the probes).
    float gatherShare = rt.gatherInfo.z > 0.0 ? rt.gatherInfo.z : 1.0;
    if (gather && gatherShare < 1.0 && BlockTurn(pixel, 0x6a09u) >= gatherShare) {
        imageStore(rtGatherImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(gatherGuide, pixel, vec4(OctEncode(ng), OctEncode(n)));
    } else if (gather) {
        vec3 t, b;
        Basis(n, t, b);
        vec3 o = OffsetRay(p, ng);
        float reach = rt.gather.x > 0.0 ? rt.gather.x : 1e30;
        // rt.gatherInfo.x rays. Film samples: the CPU's scrambled Sobol
        // points (the next ones each sample), turned per pixel by blue
        // noise, so each pixel's directions stratify over the samples.
        uint rays = uint(rt.gatherInfo.x);
        vec2 turn = texelFetch(blueNoise, (pixel + ivec2(5, 59)) & 63, 0).zw;
        vec3 radiance = vec3(0.0);
        for (uint i = 0u; i < 16u; ++i) {
            if (i >= rays) {
                break;  // a constant bound with an exit: a loop bounded by the uniform made the driver JIT +1 GB host memory (crowd_9k in husk)
            }
            vec4 points = rt.gatherSamples[i >> 1u];
            vec2 u = frame.sampleInfo.x != 0u ? fract(turn + ((i & 1u) != 0u ? points.zw : points.xy))
                                               : Random2(seed + uvec3(0u, 0u, 104729u), i);
            float r = sqrt(u.x), phi = 2.0 * PI * u.y;
            vec3 l = normalize((t * cos(phi) + b * sin(phi)) * r + n * sqrt(max(1.0 - u.x, 0.0)));
            if (dot(l, ng) <= 0.0) {
                l = reflect(l, ng);  // under the surface (bumped normal): mirrored above it
            }
            hit.t = 0.5;  // cone
            traceRayEXT(tlas, gl_RayFlagsNoneEXT, kRtMaskSurfaces, 0, 0, 0, o, 0.0, l, reach, 0);
            if (hit.t < 0.0 && rt.gather.x <= 0.0) {
                radiance += Dome(l, 0.5 * float(frame.counts.z));  // escaped: as the probes see the dome
            } else if (hit.t < 0.0) {
                vec4 gi = GiIrradiance(o + l * reach, l, -l);
                radiance += mix(DomeDiffuse(l), gi.rgb, gi.a);
            } else if ((hit.flags & kHitBackface) == 0u) {
                EvaluateHit(l, 0.5);
                radiance += ShadeHit(l, seed + uvec3(0u, 0u, i * 7919u), (hit.flags & kHitEmitter) == 0u,
                                     (rt.shadowInfo.w & 1u) != 0u);
            }
        }
        imageStore(rtGatherImage, pixel, vec4(radiance / (float(rays) * gatherShare), 1.0));
        imageStore(gatherGuide, pixel, vec4(OctEncode(ng), OctEncode(n)));  // gather_denoise.comp's edges
    }
}
