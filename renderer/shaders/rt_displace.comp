#version 450
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require
#include "frame.glsl"
#include "scene.glsl"
#include "displace.glsl"

// Ray tracing's displaced meshes (RayTracing, Frame::rtDisplacement): their
// rest vertices moved along the normal as mesh.vert moves them
// (displace.glsl, specialized with kDisplacement), object-space positions
// for their BLASes. x: vertex, y: the job.

layout(std430, set = 0, binding = 55) readonly buffer RtVertices { float rtVertices[]; };  // the rest Vertex pool
struct RtDisplaced {
    uint slot;         // mesh slot
    uint firstVertex;  // in rtDisplacedVertices
    uint vertexCount;
    uint pad;
};
layout(std430, set = 1, binding = 6) writeonly buffer RtDisplacedVertices { float rtDisplacedVertices[]; };
layout(std430, set = 1, binding = 7) readonly buffer RtDisplacedTable { RtDisplaced rtDisplaced[]; };

layout(local_size_x = 64) in;

void main()
{
    RtDisplaced job = rtDisplaced[gl_WorkGroupID.y];
    uint v = gl_GlobalInvocationID.x;
    if (v >= job.vertexCount) {
        return;
    }
    DrawInfo d = draws[job.slot];
    uint rest = (d.vertexBase + v) * 10u;
    vec3 position = vec3(rtVertices[rest], rtVertices[rest + 1u], rtVertices[rest + 2u]);
    vec3 normal = vec3(rtVertices[rest + 3u], rtVertices[rest + 4u], rtVertices[rest + 5u]);
    vec2 uv = vec2(rtVertices[rest + 6u], rtVertices[rest + 7u]);
    vec3 p = Displace(position, normal, d, uv);
    uint out0 = (job.firstVertex + v) * 3u;
    rtDisplacedVertices[out0] = p.x;
    rtDisplacedVertices[out0 + 1u] = p.y;
    rtDisplacedVertices[out0 + 2u] = p.z;
}
