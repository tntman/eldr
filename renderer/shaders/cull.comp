#version 450
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require
#define SCENE_WRITABLE
#include "frame.glsl"
#include "scene.glsl"
#include "displace.glsl"

// Frustum and small-object culling, one invocation per instance slot:
// survivors are appended to their mesh's visible list and counted into its
// indirect command, or a level of detail's. Instances under half a pixel in
// radius are dropped (the coarsest level, e.g. distant crowd agents).
// ponytail: no Hi-Z occlusion.

struct DrawCommand {  // VkDrawIndexedIndirectCommand
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};
layout(std430, set = 0, binding = 10) buffer Commands { DrawCommand commands[]; };

layout(push_constant) uniform CullParams {
    vec4 planes[6];  // xyz . p + w >= 0 inside, world space; [4] is the near plane
    uint instanceCapacity;
    uint drawCount;
    float pixelScale;    // perspective: pixels per world unit at view depth 1; ortho: per unit
    float nearDistance;  // view depth of the near plane
    float minRadius;     // pixels
    float orthographic;
    uint listBase;       // this pass's list of instance indices
    uint commandBase;    // and its draw commands
} pc;

// Levels of detail (Scene::Gpu::lods), per mesh slot.
struct Lod {
    uvec4 slots;    // x: level 1's command slot (2 and 3 follow), y: levels, z: level 0's command
    uvec4 regions;  // where levels 1, 2 and 3 fill their visible range from, room for every instance each
    vec4 errors;    // levels 1..3: how far the surface (or its shading) moved, relative to the bounding radius
};
layout(std430, set = 0, binding = 40) readonly buffer Lods { Lod lods[]; };
// Per instance slot two words: the camera's last level (bits 0..1) and the
// frame it picked it in (frame.geometry.z); the level it last changed from
// and the frame it did (a crossfade, frame.lodFade).
layout(std430, set = 0, binding = 41) buffer LodState { uint lodState[]; };

// The camera's crossfade of instance i: the entry flags (frame.glsl's
// kLodFading, how far, bits 24..29) and the level it fades out of, or 0
// flags when it isn't fading. Slots past 24 bits never fade.
uint fadeFrom = 0u;
uint gListBase = 0u, gCommandBase = 0u;  // the view Place appends to
uint FadeFlags(uint i, uint epoch)
{
    uint f = lodState[i * 2u + 1u], age = epoch - (f >> 2u);
    if (frame.lodFade.x == 0u || i > 0x00FFFFFFu || f == 0u || age >= frame.lodFade.x) {
        return 0u;
    }
    fadeFrom = f & 3u;
    return kLodFading | (min((age + 1u) * 64u / (frame.lodFade.x + 1u), 63u) << 24u);
}

// The coarsest level whose error stays under a pixel (times 2^bias) at
// `radius` pixels. The camera's keeps a band around its last level, so an
// instance near the threshold doesn't flicker between two. Shadows take
// the camera's level where the camera draws the instance this frame: a
// shadow map of other geometry than the shaded one shadows its facets.
uint LodLevel(Lod l, uint i, float radius)
{
    uint epoch = uint(frame.geometry.z);  // this frame, as lodState holds it
    if (gListBase != 0u && lodState[i * 2u] >> 2u == epoch) {
        return min(lodState[i * 2u] & 3u, l.slots.y);
    }
    float limit = exp2(frame.geometry.y);
    uint level = 0u, strict = 0u;
    for (uint k = 1u; k <= l.slots.y; ++k) {
        float e = l.errors[k - 1u] * radius;
        level = e <= limit ? k : level;
        strict = e <= 0.8 * limit ? k : strict;
    }
    if (gListBase != 0u) {
        return level;
    }
    uint state = lodState[i * 2u], last = min(state & 3u, l.slots.y);
    if (last > level && l.errors[last - 1u] * radius <= 1.25 * limit) {
        level = last;  // finer only clearly over the limit
    } else if (last < level) {
        level = max(strict, last);  // coarser only clearly under it
    }
    // A change of an instance drawn last frame fades (one that just came
    // into view, or was off, pops).
    if (level != last && state >> 2u == epoch - 1u) {
        lodState[i * 2u + 1u] = last | epoch << 2u;
    }
    lodState[i * 2u] = level | epoch << 2u;
    return level;
}

// Appends visible-list entry `entry` (instance i, maybe fading) to level
// `level`'s draw.
void Emit(uint level, uint i, uint entry, uint draw)
{
    uint command = gCommandBase + lods[draw].slots.z;  // commands are sorted by pipeline
    if (level == 0u) {
        uint slot = atomicAdd(commands[command].instanceCount, 1u);
        visible[gListBase + commands[command].firstInstance + slot] = entry;
        return;
    }
    Lod l = lods[draw];
    command = gCommandBase + l.slots.x + level - 1u;
    uint n = atomicAdd(commands[command].instanceCount, 1u);
    visible[gListBase + l.regions[level - 1u] + n] = entry;
}

// Tests the instance's world bounds against one view (`planes`) and
// appends it to that view's list (gListBase, gCommandBase).
void Place(uint i, Instance inst, vec3 wc, vec3 we, vec4 planes[6], float pixelScale, float nearDistance,
           float minRadius, bool orthographic)
{
    for (int p = 0; p < 6; ++p) {
        vec4 plane = planes[p];
        if (dot(plane.xyz, wc) + plane.w < -dot(abs(plane.xyz), we)) {
            return;
        }
    }
    float depth = dot(planes[4].xyz, wc) + planes[4].w + nearDistance;
    float radius = length(we) * pixelScale / (orthographic ? 1.0 : max(depth, 1e-6));
    if (radius < minRadius) {
        return;
    }
    // Levels judge their error where the bounds come nearest the camera (a
    // wall's near end, not its middle).
    float nearRadius = orthographic ? radius : length(we) * pixelScale / max(depth - length(we), 1e-6);
    bool lod = (frame.features.x & kFeatureLod) != 0u && lods[inst.draw].slots.y > 0u;
    uint level = lod ? LodLevel(lods[inst.draw], i, nearRadius) : 0u;
    // The camera's crossfade: both levels, each with its share of pixels.
    uint flags = lod && gListBase == 0u ? FadeFlags(i, uint(frame.geometry.z)) : 0u;
    if (flags != 0u && fadeFrom != level && fadeFrom <= lods[inst.draw].slots.y) {
        Emit(fadeFrom, i, i | flags | kLodFadingOut, inst.draw);
        Emit(level, i, i | flags, inst.draw);
        return;
    }
    Emit(level, i, i, inst.draw);
}

// kAllCascades as listBase: one dispatch culls for every sun cascade
// (commandBase: how many), each into list and commands 1 + cascade. The
// instance and its bounds (a skinned one's loop over its joints) are read
// once instead of once per cascade.
const uint kAllCascades = 0xFFFFFFFFu;
// The cascades' planes (as Renderer's FrustumPlanes), per workgroup.
shared vec4 cascadePlanes[4][6];

layout(local_size_x = 64) in;

void main()
{
    bool allCascades = pc.listBase == kAllCascades;
    uint cascades = allCascades ? min(pc.commandBase, 4u) : 0u;
    uint k = gl_LocalInvocationIndex;
    if (k < cascades * 6u) {
        mat4 m = transpose(frame.cascadeViewProj[k / 6u]);  // rows
        uint p = k % 6u;
        vec4 plane = m[3] + ((p & 1u) == 0u ? 1.0 : -1.0) * m[p / 2u];
        float len = length(plane.xyz);
        cascadePlanes[k / 6u][p] = plane / (len > 0.0 ? len : 1.0);
    }
    barrier();

    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.instanceCapacity) {
        return;
    }
    Instance inst = instances[i];
    // List 0 is the camera's, the others shadows'.
    if (inst.draw == kFreeSlot || inst.draw >= pc.drawCount ||
        (draws[inst.draw].visible & (pc.listBase == 0u ? kRaysCamera : kRaysShadow)) == 0u) {
        return;
    }
    DrawInfo d = draws[inst.draw];

    // World AABB of the instance, tested against each plane. A skinned
    // instance's is the union of every joint's matrix applied to the rest
    // bounds of the vertices that joint moves (conservative for linear
    // blend skinning).
    vec3 wc, we;
    if (d.jointCount > 0u) {
        vec3 lo = vec3(1e30), hi = vec3(-1e30);
        for (uint j = 0u; j < d.jointCount; ++j) {
            vec4 bmin = jointBounds[(d.jointBounds + j) * 2u], bmax = jointBounds[(d.jointBounds + j) * 2u + 1u];
            if (bmin.x > bmax.x) {
                continue;
            }
            mat4 jm = joints[inst.joints + j];
            vec3 c = 0.5 * (bmin.xyz + bmax.xyz), e = 0.5 * (bmax.xyz - bmin.xyz);
            mat3 r = mat3(jm);
            vec3 jc = (jm * vec4(c, 1.0)).xyz;
            vec3 je = abs(r[0]) * e.x + abs(r[1]) * e.y + abs(r[2]) * e.z;
            lo = min(lo, jc - je);
            hi = max(hi, jc + je);
        }
        wc = 0.5 * (lo + hi);
        we = max(0.5 * (hi - lo), vec3(0.0));
    } else {
        vec3 c = 0.5 * (d.boundsMin.xyz + d.boundsMax.xyz);
        vec3 e = 0.5 * (d.boundsMax.xyz - d.boundsMin.xyz);
        mat4 xf = InstanceTransform(inst);
        mat3 m = mat3(xf);
        wc = (xf * vec4(c, 1.0)).xyz;
        we = abs(m[0]) * e.x + abs(m[1]) * e.y + abs(m[2]) * e.z;
    }
    we += DisplacementReach(d, inst);
    if (!allCascades) {
        gListBase = pc.listBase;
        gCommandBase = pc.commandBase;
        Place(i, inst, wc, we, pc.planes, pc.pixelScale, pc.nearDistance, pc.minRadius, pc.orthographic > 0.5);
        return;
    }
    // Instances under half a shadow texel are dropped.
    for (uint c = 0u; c < cascades; ++c) {
        gListBase = (1u + c) * pc.instanceCapacity;
        gCommandBase = (1u + c) * pc.drawCount;
        Place(i, inst, wc, we, cascadePlanes[c], 1.0 / frame.cascadeTexel[c], 0.0, 0.5, true);
    }
}
