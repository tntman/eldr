#version 450
#extension GL_GOOGLE_include_directive : require
#define SCENE_WRITABLE
#include "scene.glsl"

// Frustum and small-object culling, one invocation per instance slot:
// survivors are appended to their mesh's visible list and counted into its
// indirect command. Instances under half a pixel in radius are dropped (the
// coarsest level of detail, e.g. distant crowd agents).
// ponytail: no Hi-Z occlusion, and no mesh LODs to pick from yet.

struct DrawCommand {  // VkDrawIndexedIndirectCommand
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};
layout(std430, set = 0, binding = 10) buffer Commands { DrawCommand commands[]; };

layout(push_constant) uniform CullParams {
    vec4 planes[6];  // xyz . p + w >= 0 inside, world space; [4] is the near plane
    uint instanceCapacity;
    uint drawCount;
    float pixelScale;    // perspective: pixels per world unit at view depth 1; ortho: per unit
    float nearDistance;  // view depth of the near plane
    float minRadius;     // pixels
    float orthographic;
    uint listBase;       // this pass's list of instance indices
    uint commandBase;    // and its draw commands
} pc;

layout(local_size_x = 64) in;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.instanceCapacity) {
        return;
    }
    Instance inst = instances[i];
    if (inst.draw == kFreeSlot || inst.draw >= pc.drawCount || draws[inst.draw].visible == 0u) {
        return;
    }
    DrawInfo d = draws[inst.draw];

    // World AABB of the instance, tested against each plane. A skinned
    // instance's is the union of every joint's matrix applied to the rest
    // bounds of the vertices that joint moves (conservative for linear
    // blend skinning).
    vec3 wc, we;
    if (d.jointCount > 0u) {
        vec3 lo = vec3(1e30), hi = vec3(-1e30);
        for (uint j = 0u; j < d.jointCount; ++j) {
            vec4 bmin = jointBounds[(d.jointBounds + j) * 2u], bmax = jointBounds[(d.jointBounds + j) * 2u + 1u];
            if (bmin.x > bmax.x) {
                continue;
            }
            mat4 jm = joints[inst.joints + j];
            vec3 c = 0.5 * (bmin.xyz + bmax.xyz), e = 0.5 * (bmax.xyz - bmin.xyz);
            mat3 r = mat3(jm);
            vec3 jc = (jm * vec4(c, 1.0)).xyz;
            vec3 je = abs(r[0]) * e.x + abs(r[1]) * e.y + abs(r[2]) * e.z;
            lo = min(lo, jc - je);
            hi = max(hi, jc + je);
        }
        wc = 0.5 * (lo + hi);
        we = max(0.5 * (hi - lo), vec3(0.0));
    } else {
        vec3 c = 0.5 * (d.boundsMin.xyz + d.boundsMax.xyz);
        vec3 e = 0.5 * (d.boundsMax.xyz - d.boundsMin.xyz);
        mat3 m = mat3(inst.transform);
        wc = (inst.transform * vec4(c, 1.0)).xyz;
        we = abs(m[0]) * e.x + abs(m[1]) * e.y + abs(m[2]) * e.z;
    }
    for (int p = 0; p < 6; ++p) {
        vec4 plane = pc.planes[p];
        if (dot(plane.xyz, wc) + plane.w < -dot(abs(plane.xyz), we)) {
            return;
        }
    }
    float depth = dot(pc.planes[4].xyz, wc) + pc.planes[4].w + pc.nearDistance;
    float radius = length(we) * pc.pixelScale / (pc.orthographic > 0.5 ? 1.0 : max(depth, 1e-6));
    if (radius < pc.minRadius) {
        return;
    }
    uint command = pc.commandBase + inst.draw;
    uint slot = atomicAdd(commands[command].instanceCount, 1u);
    visible[pc.listBase + commands[command].firstInstance + slot] = i;
}
