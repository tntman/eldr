#version 450
#extension GL_GOOGLE_include_directive : require
#include "frame.glsl"
#include "gi.glsl"

// Blends this frame's probe rays (rt_probes.rgen) into the probe atlases
// (DDGI, Majercik et al. 2019), one workgroup per probe tile and a thread
// per texel, border included: a border texel blends the rays for the
// interior texel it mirrors, so it stays that texel's copy (bilinear
// filtering across the octahedral seams) without a second pass.
// Irradiance: radiance weighted by the cosine to the texel's direction,
// back-face hits skipped; a probe that sees mostly back faces is in or
// behind a wall and turns inactive (alpha 0). Visibility: the mean hit
// distance and its square, sharply weighted around the direction. Both
// blend the rotated rays only; the fixed ones (kGiFixedRays, with
// relocation) move the probe instead: out of a wall through its nearest
// back face, away from a front face nearer than kGiMinFront spacings,
// else back towards its grid point, never past 0.45 spacings of it
// (RTXGI's probe relocation, Majercik et al. 2021). A probe that can't
// get out stays inactive.

layout(constant_id = 0) const int kTexels = 6;  // tile interior: kGiIrradianceTexels or kGiVisibilityTexels
layout(local_size_x = 16, local_size_y = 16) in;  // the larger tile; irradiance uses 8 x 8 of it

layout(std430, set = 1, binding = 1) readonly buffer GiRays { vec4 giRays[]; };  // radiance, distance
layout(set = 1, binding = 2, rgba16f) uniform image2D giIrradiance;
layout(set = 1, binding = 3, rg32f) uniform image2D giVisibility;
layout(set = 1, binding = 9, rgba32f) uniform image2D giOffsets;  // giAtlas[2]'s texel per probe

const float kGiMinFront = 0.2;  // spacings a relocated probe keeps from front faces

const uint kMaxRays = 512u;
shared vec4 rays[kMaxRays];
shared vec3 directions[kMaxRays];

// The interior texel a border texel copies (tile coordinates, 1..kTexels inside).
ivec2 Interior(ivec2 t)
{
    int n = kTexels;
    bool left = t.x == 0, right = t.x == n + 1, bottom = t.y == 0, top = t.y == n + 1;
    if ((left || right) && (bottom || top)) {
        return ivec2(left ? n : 1, bottom ? n : 1);  // corners: the opposite corner
    }
    if (bottom || top) {
        return ivec2(n + 1 - t.x, bottom ? 1 : n);  // rows mirror horizontally
    }
    if (left || right) {
        return ivec2(left ? 1 : n, n + 1 - t.y);  // columns mirror vertically
    }
    return t;
}

// The probe's new offset from its fixed rays (hit distances from where it
// is now; back faces stored as -0.2 times theirs).
void Relocate(uint probe, uint fixedRays)
{
    ivec2 at = ivec2(probe % rt.giCounts.w, probe / rt.giCounts.w);
    if (fixedRays == 0u) {
        imageStore(giOffsets, at, vec4(0.0));  // relocation off: back on the grid
        return;
    }
    vec3 offset = imageLoad(giOffsets, at).xyz;
    if (any(isnan(offset)) || any(isinf(offset))) {
        offset = vec3(0.0);
    }
    float spacing = rt.giOrigin.w, minFront = kGiMinFront * spacing;
    uint backfaces = 0u, closestBack = 0u, closestFront = 0u, farthestFront = 0u;
    float back = 1e27, front = 1e27, farthest = 0.0;
    for (uint r = 0u; r < fixedRays; ++r) {
        float d = rays[r].w;
        if (d < 0.0) {
            ++backfaces;
            if (-5.0 * d < back) {
                back = -5.0 * d;
                closestBack = r;
            }
            continue;
        }
        if (d < front) {
            front = d;
            closestFront = r;
        }
        if (d > farthest) {
            farthest = d;
            farthestFront = r;
        }
    }
    vec3 moved = offset;
    if (float(backfaces) > 0.25 * float(fixedRays)) {
        // Inside: out through the nearest back face, a little past it.
        moved += directions[closestBack] * (back + 0.5 * minFront);
    } else if (front < minFront) {
        // Too near a front face: towards open space, unless that is
        // towards the face too.
        vec3 away = directions[farthestFront];
        if (dot(directions[closestFront], away) <= 0.0) {
            moved += away * min(farthest, minFront);
        }
    } else if (front > minFront) {
        // Room to spare: back towards the grid point.
        float l = length(offset);
        moved -= l > 1e-6 ? offset / l * min(front - minFront, l) : vec3(0.0);
    }
    vec3 cell = moved / spacing;
    if (dot(cell, cell) < 0.45 * 0.45) {
        offset = moved;
    }
    imageStore(giOffsets, at, vec4(offset, 0.0));
}

void main()
{
    uint probe = gl_WorkGroupID.x;
    uint count = min(uint(rt.giParams.y), kMaxRays);
    uint threads = gl_WorkGroupSize.x * gl_WorkGroupSize.y;
    for (uint r = gl_LocalInvocationIndex; r < count; r += threads) {
        // A bad ray (NaN/Inf from a degenerate hit) is a miss with no light:
        // one must not poison the probe's history for good.
        vec4 ray = giRays[probe * count + r];
        rays[r] = any(isnan(ray)) || any(isinf(ray)) ? vec4(0.0, 0.0, 0.0, rt.giParams.z)
                                                     : vec4(min(ray.rgb, vec3(60000.0)), ray.w);
        directions[r] = GiRayDirection(r, count);
    }
    barrier();

    bool irradiance = kTexels == kGiIrradianceTexels;
    uint fixedRays = min(uint(rt.giParams.w), count);
    if (irradiance && gl_LocalInvocationIndex == 0u) {
        Relocate(probe, fixedRays);
    }

    ivec2 texel = ivec2(gl_LocalInvocationID.xy);
    if (any(greaterThan(texel, ivec2(kTexels + 1)))) {
        return;
    }
    vec2 octahedral = (vec2(Interior(texel) - 1) + 0.5) / float(kTexels) * 2.0 - 1.0;
    vec3 dir = OctDecode(octahedral);
    ivec2 coord = GiTile(probe, kTexels) + texel;
    float range = rt.giParams.z;
    vec4 sum = vec4(0.0);
    uint backfaces = 0u;
    for (uint r = 0u; r < count; ++r) {
        vec4 ray = rays[r];
        if (irradiance && ray.w < 0.0) {
            ++backfaces;  // classification: of every ray
        }
        if (r < fixedRays) {
            continue;
        }
        float cosine = max(dot(dir, directions[r]), 0.0);
        if (irradiance) {
            if (ray.w >= 0.0) {
                sum += vec4(ray.rgb * cosine, cosine);
            }
        } else {
            float w = pow(cosine, 50.0);
            float d = min(abs(ray.w), range) / range;
            sum += vec4(d * w, d * d * w, 0.0, w);
        }
    }
    float hysteresis = rt.giParams.x;
    if (irradiance) {
        vec4 old = imageLoad(giIrradiance, coord);
        if (any(isnan(old)) || any(isinf(old))) {
            old = vec4(0.0);
        }
        vec3 value = sum.w > 1e-6 ? sum.rgb / sum.w : old.rgb;
        float usable = float(backfaces) < 0.25 * float(count) ? 1.0 : 0.0;
        imageStore(giIrradiance, coord, mix(vec4(value, usable), old, hysteresis));
    } else {
        vec2 old = imageLoad(giVisibility, coord).rg;
        if (any(isnan(old)) || any(isinf(old))) {
            old = vec2(1.0);
        }
        vec2 value = sum.w > 1e-6 ? sum.rg / sum.w : old;
        imageStore(giVisibility, coord, vec4(mix(value, old, hysteresis), 0.0, 0.0));
    }
}
