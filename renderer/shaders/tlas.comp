#version 450
#extension GL_GOOGLE_include_directive : require
#include "frame.glsl"
#include "scene.glsl"
#include "gi.glsl"

// The TLAS's instances (VkAccelerationStructureInstanceKHR), one per
// instance slot: its transform, its mesh slot as custom index, and that
// mesh's BLAS. Free slots, hidden meshes and meshes without a BLAS
// (skinned) are inactive (no BLAS, mask 0); translucent ones have mask
// kRtMaskTranslucent and no opaque flag (gi.glsl). Then, from
// rt.skinned.x on, the skinned instances with BLASes of their own over
// posed world-space vertices (an identity transform).

struct RtSlot {  // rt.glsl
    uvec2 blas;
    uint firstIndex;
    uint flags;
};
layout(std430, set = 0, binding = 57) readonly buffer RtSlots { RtSlot rtSlots[]; };
const uint kRtSlotCutout = 2u;  // alpha-tested: any-hit shaders run, else forced opaque
const uint kRtSlotTranslucent = 4u;  // rt.glsl

// Mask (high byte of indexMask) and VkGeometryInstanceFlagsKHR (high byte
// of sbtFlags): TRIANGLE_FACING_CULL_DISABLE, and FORCE_NO_OPAQUE (cutouts
// and translucent meshes: any-hit shaders run) or FORCE_OPAQUE.
// ponytail: translucent meshes keep theirs whatever rays see them
// (rt_shadow.rahit skips those shadow rays don't see).
uint Mask(uint flags, uint rays)
{
    if ((flags & kRtSlotTranslucent) != 0u) {
        return kRtMaskTranslucent;
    }
    return ((rays & kRaysCamera) != 0u ? kRtMaskCamera : 0u) | ((rays & kRaysShadow) != 0u ? kRtMaskShadow : 0u) |
           ((rays & kRaysSecondary) != 0u ? 0xFFu & ~(kRtMaskCamera | kRtMaskShadow) : 0u);
}

uint InstanceFlags(uint flags)
{
    return 1u | ((flags & (kRtSlotCutout | kRtSlotTranslucent)) != 0u ? 8u : 4u);
}

struct RtSkinned {  // rt.glsl
    uvec2 blas;
    uint slot;
    uint firstVertex;
    uint instance;
    uint vertexCount;
    uint flags;
    uint pad;
};
layout(std430, set = 1, binding = 5) readonly buffer RtSkinnedTable { RtSkinned rtSkinned[]; };

struct TlasInstance {
    vec4 rows[3];
    uint indexMask;  // custom index (24 bits), mask (8)
    uint sbtFlags;   // hit group offset (24 bits), VkGeometryInstanceFlagsKHR (8)
    uvec2 blas;
};
layout(std430, set = 1, binding = 0) writeonly buffer TlasInstances { TlasInstance tlasInstances[]; };
// Per instance slot, a BLAS of its own (per-instance displacement), else 0.
layout(std430, set = 1, binding = 8) readonly buffer RtInstanceBlas { uvec2 rtInstanceBlas[]; };

layout(local_size_x = 64) in;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= tlasInstances.length()) {
        return;
    }
    TlasInstance t;
    t.indexMask = 0u;
    t.sbtFlags = 0u;
    t.blas = uvec2(0u);
    if (i >= rt.skinned.x) {
        uint k = i - rt.skinned.x;
        t.rows = vec4[3](vec4(1.0, 0.0, 0.0, 0.0), vec4(0.0, 1.0, 0.0, 0.0), vec4(0.0, 0.0, 1.0, 0.0));
        if (k < rt.skinned.y && rtSkinned[k].blas != uvec2(0u)) {
            uint slot = rtSkinned[k].slot;
            t.indexMask = slot | (Mask(rtSlots[slot].flags, draws[slot].visible) << 24);
            t.sbtFlags = InstanceFlags(rtSlots[slot].flags) << 24;
            t.blas = rtSkinned[k].blas;
        }
        tlasInstances[i] = t;
        return;
    }
    Instance inst = instances[min(i, instances.length() - 1u)];
    t.rows = inst.rows;
    if (i < instances.length() && inst.draw != kFreeSlot && draws[inst.draw].visible != 0u &&
        rtSlots[inst.draw].blas != uvec2(0u)) {
        RtSlot s = rtSlots[inst.draw];
        t.indexMask = inst.draw | (Mask(s.flags, draws[inst.draw].visible) << 24);
        t.sbtFlags = InstanceFlags(s.flags) << 24;
        t.blas = i < rtInstanceBlas.length() && rtInstanceBlas[i] != uvec2(0u) ? rtInstanceBlas[i] : s.blas;
    }
    tlasInstances[i] = t;
}
