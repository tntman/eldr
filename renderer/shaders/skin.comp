#version 450
#extension GL_GOOGLE_include_directive : require
#define JOINTS_WRITABLE
#include "scene.glsl"

// Joint matrices of every skinned instance: its mesh's skinning transforms
// (shared, or the instance's own set) followed by the instance transform.
// The CPU uploads only the skinning transforms per frame.

layout(local_size_x = 64) in;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= instances.length()) {
        return;
    }
    Instance inst = instances[i];
    if (inst.draw == kFreeSlot || inst.joints == kFreeSlot) {
        return;
    }
    DrawInfo d = draws[inst.draw];
    uint src = d.skinXforms + (d.skinPerInstance != 0u ? uint(inst.index) * d.jointCount : 0u);
    for (uint j = 0u; j < d.jointCount; ++j) {
        joints[inst.joints + j] = inst.transform * skinXforms[src + j];
    }
}
