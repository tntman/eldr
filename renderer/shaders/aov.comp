#version 450

// Extra AOVs (aov.h): one of them per dispatch, from the G-buffer, depth
// and primId, written packed (Aovs::Components floats per pixel) at its
// offset in the output. 0 where nothing was drawn.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D depth;      // window depth
layout(set = 0, binding = 1) uniform isampler2D primId;
layout(set = 0, binding = 2) uniform sampler2D normalSt;   // octahedral world normal, st
layout(set = 0, binding = 3) uniform sampler2D albedo;
layout(set = 0, binding = 4) uniform sampler2D emission;
layout(std430, set = 0, binding = 5) readonly buffer Params {
    mat4 view;          // world to camera
    mat4 invViewProj;   // GL NDC to world
    uint cryptomatte[]; // per primId: object, material
};
layout(std430, set = 0, binding = 6) buffer Output { float values[]; };
// Light splits stored by the shading pass: direct diffuse, indirect diffuse,
// direct glossy, indirect glossy.
layout(set = 0, binding = 7) uniform sampler2DArray splits;

layout(push_constant) uniform Push {
    uint kind;        // Aovs::Kind
    uint offset;      // first float in values
    uint components;
    uint cryptomatteIds;
    float weight;     // this frame's in the running average (1: the first)
} pc;

const uint kNormal = 0u, kNormalEye = 1u, kPositionEye = 2u, kCameraDepth = 3u, kSt = 4u, kAlbedo = 5u,
           kEmission = 6u, kCryptoObject = 7u, kCryptoMaterial = 8u, kPositionWorld = 9u, kDepth = 10u,
           kDiffuseAlbedo = 11u, kDirectDiffuse = 12u, kIndirectDiffuse = 13u, kCombinedDiffuse = 14u,
           kDirectGlossy = 15u, kIndirectGlossy = 16u, kCombinedGlossy = 17u;

vec3 OctDecode(vec2 e)
{
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    if (n.z < 0.0) {
        n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    }
    return normalize(n);
}

void main()
{
    ivec2 size = textureSize(depth, 0);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    vec4 v = vec4(0.0);
    int id = texelFetch(primId, p, 0).r;
    if (id >= 0) {
        vec4 g = texelFetch(normalSt, p, 0);
        // Window depth to GL NDC (the renderer maps clip z [-w, w] to [0, w]).
        vec2 ndc = (vec2(p) + 0.5) / vec2(size) * 2.0 - 1.0;
        vec4 world = invViewProj * vec4(ndc, texelFetch(depth, p, 0).r * 2.0 - 1.0, 1.0);
        vec3 eye = (view * vec4(world.xyz / world.w, 1.0)).xyz;
        uint crypto = uint(id) < pc.cryptomatteIds ? cryptomatte[uint(id) * 2u + (pc.kind == kCryptoMaterial ? 1u : 0u)]
                                                   : 0u;
        switch (pc.kind) {
        case kNormal: v.xyz = OctDecode(g.xy); break;
        case kNormalEye: v.xyz = normalize(mat3(view) * OctDecode(g.xy)); break;
        case kPositionEye: v.xyz = eye; break;
        case kCameraDepth: v.x = eye.z; break;
        case kSt: v.xy = g.zw; break;
        case kAlbedo: v.xyz = texelFetch(albedo, p, 0).rgb; break;
        case kEmission: v.xyz = texelFetch(emission, p, 0).rgb; break;
        case kPositionWorld: v.xyz = world.xyz / world.w; break;
        case kDepth: v.x = -eye.z; break;
        case kDirectDiffuse:
        case kIndirectDiffuse:
        case kDirectGlossy:
        case kIndirectGlossy: {
            int layer = int(pc.kind - kDirectDiffuse) - (pc.kind >= kDirectGlossy ? 1 : 0);
            v.xyz = texelFetch(splits, ivec3(p, layer), 0).rgb;
            break;
        }
        case kCombinedDiffuse:
        case kCombinedGlossy: {
            int layer = pc.kind == kCombinedDiffuse ? 0 : 2;
            v.xyz = texelFetch(splits, ivec3(p, layer), 0).rgb + texelFetch(splits, ivec3(p, layer + 1), 0).rgb;
            break;
        }
        case kDiffuseAlbedo: {
            vec4 a = texelFetch(albedo, p, 0);  // base colour, metallic
            v.xyz = a.rgb * (1.0 - a.a);
            break;
        }
        case kCryptoObject:
        case kCryptoMaterial:
            v = crypto != 0u ? vec4(uintBitsToFloat(crypto), 1.0, 0.0, 0.0) : vec4(0.0); break;
        }
    }
    uint base = pc.offset + uint(p.y * size.x + p.x) * pc.components;
    for (uint c = 0u; c < pc.components; ++c) {
        // Ids (Cryptomatte) aren't averaged: the latest frame's.
        bool nearest = pc.kind == kCryptoObject || pc.kind == kCryptoMaterial;
        values[base + c] = nearest || pc.weight >= 1.0 ? v[c] : mix(values[base + c], v[c], pc.weight);
    }
}
