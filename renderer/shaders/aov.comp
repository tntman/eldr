#version 450

// Extra AOVs (aov.h): one of them per dispatch, from the G-buffer, depth
// and primId, written packed (Aovs::Components floats per pixel) at its
// offset in the output. 0 where nothing was drawn.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D depth;      // window depth
layout(set = 0, binding = 1) uniform isampler2D primId;
layout(set = 0, binding = 2) uniform sampler2D normalSt;   // octahedral world normal, st
layout(set = 0, binding = 3) uniform sampler2D albedo;
layout(set = 0, binding = 4) uniform sampler2D emission;
layout(std430, set = 0, binding = 5) readonly buffer Params {
    mat4 view;          // world to camera
    mat4 invViewProj;   // GL NDC to world
    uint cryptomatte[]; // per primId: object, material
};
layout(std430, set = 0, binding = 6) buffer Output { float values[]; };
// Light splits stored by the shading pass, layers as Aovs::EnsureSplits.
layout(set = 0, binding = 7) uniform sampler2DArray splits;
// Film samples of the colour AOVs: per pixel `components` sums of
// weight * value, the weights' sum (film.comp's), then the film's count of
// the pixel's samples when it last took one.
layout(std430, set = 0, binding = 8) buffer Sums { float sums[]; };
// Cryptomatte under the film, per pixel: 6 ids (float bits), their 6 weights,
// the pixel's total weight, the film's sample count; in Sums at
// kCryptoStride floats each.
const uint kCryptoStride = 14u, kRanks = 6u;
// The film's: weight, samples (y)... A pixel the adaptive film stopped
// sampling takes none here either.
layout(set = 0, binding = 9, rgba32f) uniform readonly image2D filmWeights;

layout(push_constant) uniform Push {
    uint kind;        // Aovs::Kind
    uint offset;      // first float in values
    uint components;
    uint cryptomatteIds;
    float weight;     // this frame's in the running average (1: the first)
    uint sumsOffset;  // first float of this kind in sums
    vec2 filmOffset;  // film samples: where this frame's are from their pixel centres
    float filmRadius; // the film's filter radius (pixels)
    uint film;        // film samples (the colour AOVs are filtered as the film's beauty): 1 add, 2 start over
    uint filter;      // film samples: kNearest... (Aovs::Filter, aov.cpp's ShaderFilter)
    float radius;     // its radius (pixels)
} pc;

const uint kNearest = 0u, kGauss = 1u, kBox = 2u, kMin = 3u, kMax = 4u, kClosest = 5u, kFarthest = 6u;
const float kNothing = 1e30;  // the depth of a sample where nothing was drawn

const uint kNormal = 0u, kNormalEye = 1u, kPositionEye = 2u, kCameraDepth = 3u, kSt = 4u, kAlbedo = 5u,
           kEmission = 6u, kCryptoObject = 7u, kCryptoMaterial = 8u, kPositionWorld = 9u, kDepth = 10u,
           kDiffuseAlbedo = 11u, kDirectDiffuse = 12u, kIndirectDiffuse = 13u, kCombinedDiffuse = 14u,
           kDirectGlossy = 15u, kIndirectGlossy = 16u, kCombinedGlossy = 17u, kTransmission = 18u,
           kSubsurface = 19u, kCoat = 20u, kShadow = 21u, kHoldoutShadow = 22u, kVolume = 23u, kCaustics = 24u, kLightGroup0 = 25u;
const int kGroupLayer = 11;  // Aovs::kSplitLayers

vec3 OctDecode(vec2 e)
{
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    if (n.z < 0.0) {
        n.xy = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    }
    return normalize(n);
}

bool IsCrypto(uint kind)
{
    return kind == kCryptoObject || kind == kCryptoMaterial;
}

bool IsColour(uint kind)
{
    return kind == kAlbedo || kind == kEmission || kind >= kDiffuseAlbedo;
}

// A layer of the splits (0 past the ones made).
vec4 Split(ivec2 q, int layer)
{
    return layer < textureSize(splits, 0).z ? texelFetch(splits, ivec3(q, layer), 0) : vec4(0.0);
}

// The colour AOVs' value at q, from this sample's G-buffer and splits.
// Diffuse takes out the subsurface light (layers 5, 6), indirect glossy
// the refracted (4).
vec3 Colour(ivec2 q)
{
    switch (pc.kind) {
    case kAlbedo: return texelFetch(albedo, q, 0).rgb;
    case kEmission: return texelFetch(emission, q, 0).rgb;
    case kDirectDiffuse: return Split(q, 0).rgb - Split(q, 5).rgb;
    case kIndirectDiffuse: return Split(q, 1).rgb - Split(q, 6).rgb;
    case kCombinedDiffuse: return Split(q, 0).rgb + Split(q, 1).rgb - Split(q, 5).rgb - Split(q, 6).rgb;
    case kDirectGlossy: return Split(q, 2).rgb;
    case kIndirectGlossy: return Split(q, 3).rgb - Split(q, 4).rgb;
    case kCombinedGlossy: return Split(q, 2).rgb + Split(q, 3).rgb - Split(q, 4).rgb;
    case kTransmission: return Split(q, 4).rgb;
    case kSubsurface: return Split(q, 5).rgb + Split(q, 6).rgb;
    case kCoat: return Split(q, 7).rgb;
    case kShadow:
    case kHoldoutShadow: {
        vec4 s = Split(q, 8);
        return (s.a > 0.5) == (pc.kind == kHoldoutShadow) ? s.rgb : vec3(0.0);
    }
    case kVolume: return Split(q, 9).rgb;
    case kCaustics: return Split(q, 10).rgb;
    case kDiffuseAlbedo: {  // base colour * (1 - metallic)
        vec4 a = texelFetch(albedo, q, 0);
        return a.rgb * (1.0 - a.a);
    }
    default: return Split(q, kGroupLayer + int(pc.kind - kLightGroup0)).rgb;
    }
}

// As film.comp: NaN/Inf (and negative colour) never enter the sums.
vec3 Clean(vec3 c)
{
    return any(isnan(c)) || any(isinf(c)) ? vec3(0.0) : max(c, vec3(0.0));
}

// The AOV's value at q from this sample (0 where nothing was drawn, the
// colour AOVs' volumes over the background aside), and its depth along the
// view axis (kNothing there). NaN/Inf are 0, negative colour too.
vec4 Value(ivec2 q, out float z)
{
    vec4 v = vec4(0.0);
    z = kNothing;
    ivec2 size = textureSize(depth, 0);
    int id = texelFetch(primId, q, 0).r;
    if (id >= 0) {
        vec4 g = texelFetch(normalSt, q, 0);
        // Window depth to GL NDC (the renderer maps clip z [-w, w] to [0, w]).
        vec2 ndc = (vec2(q) + 0.5) / vec2(size) * 2.0 - 1.0;
        vec4 world = invViewProj * vec4(ndc, texelFetch(depth, q, 0).r * 2.0 - 1.0, 1.0);
        vec3 eye = (view * vec4(world.xyz / world.w, 1.0)).xyz;
        z = -eye.z;
        uint crypto = uint(id) < pc.cryptomatteIds ? cryptomatte[uint(id) * 2u + (pc.kind == kCryptoMaterial ? 1u : 0u)]
                                                   : 0u;
        switch (pc.kind) {
        case kNormal: v.xyz = OctDecode(g.xy); break;
        case kNormalEye: v.xyz = normalize(mat3(view) * OctDecode(g.xy)); break;
        case kPositionEye: v.xyz = eye; break;
        case kCameraDepth: v.x = eye.z; break;
        case kSt: v.xy = g.zw; break;
        case kPositionWorld: v.xyz = world.xyz / world.w; break;
        case kDepth: v.x = -eye.z; break;
        case kCryptoObject:
        case kCryptoMaterial:
            v = crypto != 0u ? vec4(uintBitsToFloat(crypto), 1.0, 0.0, 0.0) : vec4(0.0); break;
        }
    }
    if (IsColour(pc.kind)) {  // 0 where nothing was drawn, but volumes over the background
        v.xyz = Clean(Colour(q));
    }
    return any(isnan(v)) || any(isinf(v)) ? vec4(0.0) : v;
}

void main()
{
    ivec2 size = textureSize(depth, 0);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    if (pc.film != 0u && IsCrypto(pc.kind)) {
        // Soft Cryptomatte: this sample's ids at the colour AOVs' filter
        // weights (film.comp's), merged into the pixel's best 6 by weight.
        // Coverage = an id's weight / all weight, the background's too.
        uint s = pc.sumsOffset + uint(p.y * size.x + p.x) * kCryptoStride;
        float count = imageLoad(filmWeights, p).y;
        if (pc.film != 2u && count == sums[s + 13u]) {
            return;
        }
        sums[s + 13u] = count;
        uint ids[15];
        float weights[15];
        uint n = 0u;
        float total = 0.0;
        if (pc.film != 2u) {
            total = sums[s + 12u];
            for (uint i = 0u; i < kRanks; ++i) {
                if (sums[s + kRanks + i] > 0.0) {
                    ids[n] = floatBitsToUint(sums[s + i]);
                    weights[n++] = sums[s + kRanks + i];
                }
            }
        }
        float radius = pc.filmRadius;
        float k = -0.5 / max(0.284 * 0.284 * radius * radius, 1e-6);
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                ivec2 q = p + ivec2(x, y);
                if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) {
                    continue;
                }
                vec2 d = vec2(x, y) + pc.filmOffset;
                float r2 = dot(d, d);
                float w = r2 < radius * radius ? exp(k * r2) : 0.0;
                w = (x == 0 && y == 0) ? max(w, 1e-6) : w;
                total += w;
                int pid = texelFetch(primId, q, 0).r;
                uint id = pid >= 0 && uint(pid) < pc.cryptomatteIds
                              ? cryptomatte[uint(pid) * 2u + (pc.kind == kCryptoMaterial ? 1u : 0u)] : 0u;
                if (id == 0u || w <= 0.0) {
                    continue;
                }
                uint j = 0u;
                while (j < n && ids[j] != id) {
                    ++j;
                }
                if (j == n) {
                    ids[n] = id;
                    weights[n++] = 0.0;
                }
                weights[j] += w;
            }
        }
        // The best kRanks first (selection sort), then the state and the output.
        uint base = pc.offset + uint(p.y * size.x + p.x) * pc.components;
        for (uint i = 0u; i < kRanks; ++i) {
            uint best = i;
            for (uint j = i + 1u; j < n; ++j) {
                best = weights[j] > weights[best] ? j : best;
            }
            uint id = 0u;
            float w = 0.0;
            if (i < n) {
                id = ids[best];
                w = weights[best];
                ids[best] = ids[i];
                weights[best] = weights[i];
            }
            sums[s + i] = uintBitsToFloat(id);
            sums[s + kRanks + i] = w;
            if (2u * i < pc.components) {
                values[base + 2u * i] = uintBitsToFloat(id);
            }
            if (2u * i + 1u < pc.components) {
                values[base + 2u * i + 1u] = w / total;
            }
        }
        sums[s + 12u] = total;
        return;
    }
    if (pc.filter != kNearest) {
        // Film samples: the samples around the pixel (3x3, each at its
        // jittered position) within the filter's radius, the pixel's own
        // always, summed with their weights over frames (Gauss: film.comp's
        // filter; box: weight 1), or the extreme kept: per component (min,
        // max), or the sample with the least or most depth (closest,
        // farthest; its depth in the weight's place). No id test: this
        // sample's G-buffer and splits are 0 where nothing was drawn.
        uint s = pc.sumsOffset + uint(p.y * size.x + p.x) * (pc.components + 2u);
        float count = imageLoad(filmWeights, p).y;
        if (pc.film != 2u && count == sums[s + pc.components + 1u]) {
            return;
        }
        sums[s + pc.components + 1u] = count;
        bool fresh = pc.film == 2u;
        bool extreme = pc.filter >= kMin;
        float radius = pc.radius;
        float k = -0.5 / max(0.284 * 0.284 * radius * radius, 1e-6);
        vec4 sum = vec4(0.0);
        float weight = 0.0;
        if (extreme && !fresh) {
            for (uint c = 0u; c < min(pc.components, 4u); ++c) {
                sum[c] = sums[s + c];
            }
            weight = sums[s + pc.components];
        }
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                ivec2 q = p + ivec2(x, y);
                if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) {
                    continue;
                }
                vec2 d = vec2(x, y) + pc.filmOffset;
                float w = pc.filter == kGauss ? (dot(d, d) < radius * radius ? exp(k * dot(d, d)) : 0.0)
                                              : (all(lessThanEqual(abs(d), vec2(radius))) ? 1.0 : 0.0);
                w = (x == 0 && y == 0) ? max(w, 1e-6) : w;
                if (w <= 0.0) {
                    continue;
                }
                float z;
                vec4 v = Value(q, z);
                if (!extreme) {
                    sum += v * w;
                    weight += w;
                } else if (pc.filter == kMin || pc.filter == kMax) {
                    sum = fresh ? v : pc.filter == kMin ? min(sum, v) : max(sum, v);
                    fresh = false;
                } else if (fresh || (pc.filter == kClosest ? z < weight : z > weight)) {
                    sum = v;
                    weight = z;
                    fresh = false;
                }
            }
        }
        float old = pc.film == 2u || extreme ? 0.0 : 1.0;
        float total = extreme ? weight : weight + old * sums[s + pc.components];
        sums[s + pc.components] = total;
        uint base = pc.offset + uint(p.y * size.x + p.x) * pc.components;
        for (uint c = 0u; c < pc.components; ++c) {
            float t = (c < 4u ? sum[c] : 0.0) + old * sums[s + c];
            sums[s + c] = t;
            values[base + c] = extreme ? t : t / total;
        }
        return;
    }
    float z;
    vec4 v = Value(p, z);
    uint base = pc.offset + uint(p.y * size.x + p.x) * pc.components;
    // Ids (Cryptomatte) aren't averaged: the latest frame's, or (weight 0)
    // the nearest film sample's so far.
    bool nearest = IsCrypto(pc.kind);
    if (nearest && pc.weight < 0.5) {
        return;
    }
    for (uint c = 0u; c < pc.components; ++c) {
        float x = c < 4u ? v[c] : 0.0;
        values[base + c] = nearest || pc.weight >= 1.0 ? x : mix(values[base + c], x, pc.weight);
    }
}
