#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require
#define RAY_TRACING
#ifdef PHOTONS
#define CAUSTICS_WRITE  // caustics.glsl's storing side (rt_photons.glsl)
#endif
#include "frame.glsl"
#include "lights.glsl"
#include "scene.glsl"
#include "material.glsl"
#include "rt.glsl"
#include "gi.glsl"
#include "volume.glsl"
#include "rt_shade.glsl"

// Traced refraction (RayTracing::Work::refraction), per pixel for
// transparency.glsl's TransmissionEnd: a ray through the pixel (the
// rasterizer's jittered camera) finds the nearest refracting surface
// (passing translucent surfaces that don't refract, which draw over it),
// is refracted there and followed through the translucent meshes
// (kRtMaskTranslucent) up to rt.refraction.x interfaces: into and out of
// each medium, glass behind glass, total internal reflection past the
// critical angle, a GGX microfacet normal per ray by the roughness (rough
// glass; the film or TAA averages). Every surface's material is evaluated
// at the hit as the shading pass evaluates it (Evaluate: textures, the
// material program and its lobe inputs, the normal map), so the first
// refraction bends by the same normal and ior as its fragment, and later
// surfaces by their own ior, transmission colour, weight, opacity, depth
// and thin walls. After the first surface each one, by its fractions, lets
// the ray through straight, refracts or reflects it (Fresnel), or ends it
// on its own diffuse surface; a medium absorbs by Beer-Lambert over its
// transmission depth (the one at its entry point), a surface without one
// or a thin wall tints on entry. What the ray hits at last is shaded as
// traced reflections shade their hits (ShadeHit), a miss sees the dome and
// the suns' discs (SunDiscs).
// The first interface's Fresnel, weight and surface tint are the shading
// pass's.
// rgb: the light arriving along the refracted ray, a: the distance from
// the camera to the first refracting surface (the shading pass matches its
// fragment to it), negative where the ray left the scene with no dome
// (the app's background: coverage drops), 0 where none was found.
// Displaced glass (rt.refraction.y: its BLAS is displaced, Work::displacement)
// bends them by its displaced triangle and the height map's bump, as the
// shading pass bumps its fragments; a displacement graph's by the displaced
// triangle's facet, as the shading pass takes its facet.
// ponytail: skinned meshes' programs see posed world space as object space;
// uniform primvars read face 0.
layout(set = 0, binding = 86, rgba16f) uniform writeonly image2D rtRefractionImage;
layout(set = 0, binding = 13) uniform sampler2D sceneDepth;  // the prepass depth (opaque), window [0, 1]

// TraceMask up to tMax.
void TraceReach(vec3 origin, vec3 dir, float cone, uint mask, float tMax)
{
    hit.t = cone;
    traceRayEXT(tlas, gl_RayFlagsNoneEXT, mask, 0, 0, 0, origin, 0.0, dir, tMax, 0);
}

#include "rt_evaluate.glsl"

#ifdef PHOTONS
#include "rt_photons.glsl"
#else
void main()
{
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    vec2 ndc = (vec2(pixel) + 0.5) / vec2(gl_LaunchSizeEXT.xy) * 2.0 - 1.0;
    vec4 nearPoint = frame.invViewProj * vec4(ndc, -1.0, 1.0), farPoint = frame.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 origin = nearPoint.xyz / nearPoint.w;
    vec3 dir = normalize(farPoint.xyz / farPoint.w - origin);
    float cone = 1.0 / frame.viewport.y;
    const uint kMaskAll = kRtMaskSurfaces | kRtMaskTranslucent;
    // With rt.refraction.z the first rays see glass only (kRtMaskTranslucent
    // is the translucent meshes' alone, tlas.comp), up to the prepass's
    // opaque surface (2% on: depth precision): glass behind it draws no
    // fragment to read this. Pixels without glass then skip the opaque
    // meshes' BLASes.
    bool clip = rt.refraction.z != 0u;
    uint firstMask = clip ? kRtMaskTranslucent : kMaskAll;
    float reach = 1e30;
    float depth = texelFetch(sceneDepth, pixel, 0).r;
    if (clip && depth < 1.0) {
        vec4 q = frame.invViewProj * vec4(ndc, depth * 2.0 - 1.0, 1.0);
        reach = distance(origin, q.xyz / q.w) * 1.02 + 1e-4;
    }
    TraceReach(origin, dir, cone, firstMask, reach);
    uint interfaces = rt.refraction.x;
    Surface s;
    // The nearest refracting surface, through translucent ones that don't
    // refract (their own fragments blend over it).
    for (;;) {
        if (hit.t < 0.0 || (hit.flags & kHitTranslucent) == 0u || interfaces == 0u) {
            imageStore(rtRefractionImage, pixel, vec4(0.0));
            return;
        }
        s = Evaluate(dir, cone);
        if (s.refracted > 0.0) {
            break;
        }
        --interfaces;
        TraceReach(OffsetRay(hit.position, -s.ng), dir, cone, firstMask,
                   max(reach - distance(origin, hit.position), 0.0));
    }
    float first = max(distance(hit.position, frame.cameraPos.xyz), 1e-6);
    uvec3 seed = uvec3(pixel, rt.params.x);
    vec3 throughput = vec3(1.0);
    bool inMedium = false;
    vec3 mediumColor = vec3(1.0);
    float mediumDepth = 0.0;
    for (uint bounce = 0u; bounce < interfaces; ++bounce) {
        if (bounce > 0u) {
            s = Evaluate(dir, cone);
        }
        Material m = s.m;
        vec2 u = Random2(seed + uvec3(0u, 0u, 104729u + bounce), 0u);
        // After the first surface: straight through, refracted, or its own
        // diffuse surface, by its fractions.
        bool straight = bounce > 0u && u.x < s.straight;
        if (bounce > 0u && !straight && u.x >= s.straight + s.refracted) {
            vec3 shaded = ShadeHit(dir, seed, true, rt.shadowInfo.w != 0u);
            imageStore(rtRefractionImage, pixel, vec4(throughput * shaded, first));
            return;
        }
        vec3 n = s.n, ng = s.ng;
        if (!straight) {
            bool thin = m.refraction.y > 0.0;
            bool exiting = !thin && m.refraction.x != 1.0 && s.backface;
            float ior = max(m.refraction.x, 1e-3);
            // A microfacet normal (facing the ray) by the roughness.
            vec3 t, bt;
            Basis(n, t, bt);
            vec3 v = -dir;
            vec3 h = SampleGgxVndf(vec3(dot(v, t), dot(v, bt), max(dot(v, n), 1e-4)), s.roughness * s.roughness,
                                   Random2(seed + uvec3(0u, 0u, 7907u * (bounce + 1u)), 0u));
            n = normalize(t * h.x + bt * h.y + n * h.z);
            vec3 r = thin ? dir : refract(dir, n, exiting ? ior : 1.0 / ior);
            bool total = dot(r, r) == 0.0;
            float f0 = (ior - 1.0) / (ior + 1.0);
            f0 *= f0;
            float cosine = exiting ? (total ? 0.0 : clamp(-dot(r, n), 0.0, 1.0)) : clamp(dot(n, v), 0.0, 1.0);
            float F = total ? 1.0 : f0 + (1.0 - f0) * pow(1.0 - cosine, 5.0);
            bool mirrored = total || (bounce > 0u && u.y < F);
            if (!mirrored) {
                if (bounce > 0u && (thin || (!exiting && m.refraction.z <= 0.0))) {
                    throughput *= m.transmission.rgb;  // the first surface's tint is the shading pass's
                }
                if (!thin) {
                    inMedium = !exiting;
                    mediumColor = m.transmission.rgb;
                    mediumDepth = m.refraction.z;
                }
            }
            dir = mirrored ? reflect(dir, n) : r;
        }
        TraceMask(OffsetRay(hit.position, dot(dir, ng) > 0.0 ? ng : -ng), dir, cone, kMaskAll);
        if (inMedium && mediumDepth > 0.0) {
            float travelled = hit.t < 0.0 ? 1e30 : hit.t;
            throughput *= pow(max(mediumColor, vec3(1e-4)), vec3(travelled / mediumDepth));
        }
        if (hit.t < 0.0) {
            bool dome = frame.envRadiance.w > 0.0;
            imageStore(rtRefractionImage, pixel, vec4(throughput * (Dome(dir, 0.0) + SunDiscs(dir)), dome ? first : -first));
            return;
        }
        if ((hit.flags & kHitTranslucent) == 0u) {
            EvaluateHit(dir, cone);
            vec3 shaded = ShadeHit(dir, seed, true, rt.shadowInfo.w != 0u);
            imageStore(rtRefractionImage, pixel, vec4(throughput * shaded, first));
            return;
        }
    }
    // Out of interfaces inside glass: the dome along the last direction.
    imageStore(rtRefractionImage, pixel, vec4(throughput * (Dome(dir, 0.0) + SunDiscs(dir)), first));
}
#endif
