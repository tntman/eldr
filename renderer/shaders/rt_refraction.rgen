#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require
#define RAY_TRACING
#include "frame.glsl"
#include "lights.glsl"
#include "scene.glsl"
#include "material.glsl"
#include "rt.glsl"
#include "gi.glsl"
#include "rt_shade.glsl"

// Traced refraction (RayTracing::Work::refraction), per pixel for
// transparency.glsl's TransmissionEnd: a ray through the pixel (the
// rasterizer's jittered camera) finds the nearest refracting surface, is
// refracted there and followed through the glass up to rt.refraction.x
// interfaces (into and out of each medium, glass behind glass), each
// refracting or, by its Fresnel, reflecting (always past the critical
// angle), with a GGX microfacet normal per ray by the surface's roughness
// (rough glass; the film or TAA averages). Inside a medium with a
// transmission depth the light is absorbed by Beer-Lambert. What it hits
// at last is shaded as traced reflections shade their hits (ShadeHit),
// a miss sees the dome.
// The first interface's Fresnel and surface tint are the shading pass's
// (which has the material's program inputs and normal map); later ones
// use the materials' constants and textures (as all hits do) and take
// their surface tint (no transmission depth, or thin walls) on entry.
// rgb: the light arriving along the refracted ray, a: the distance from
// the camera to the first surface (the shading pass matches its
// fragment to it), negative where the ray left the scene with no dome
// (the app's background: coverage drops), 0 where it hit no refracting
// surface first.
// ponytail: the first refraction uses the hit's interpolated normal and
// constant ior, and every surface after it is fully transmissive.
layout(set = 0, binding = 86, rgba16f) uniform writeonly image2D rtRefractionImage;

void main()
{
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    vec2 ndc = (vec2(pixel) + 0.5) / vec2(gl_LaunchSizeEXT.xy) * 2.0 - 1.0;
    vec4 nearPoint = frame.invViewProj * vec4(ndc, -1.0, 1.0), farPoint = frame.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 origin = nearPoint.xyz / nearPoint.w;
    vec3 dir = normalize(farPoint.xyz / farPoint.w - origin);
    float cone = 1.0 / frame.viewport.y;
    TraceMask(origin, dir, cone, kMaskAll);
    if (hit.t < 0.0 || (hit.flags & kHitRefracts) == 0u) {
        imageStore(rtRefractionImage, pixel, vec4(0.0));
        return;
    }
    float first = max(distance(hit.position, frame.cameraPos.xyz), 1e-6);
    uvec3 seed = uvec3(pixel, rt.params.x);
    vec3 throughput = vec3(1.0);
    uint medium = kNoMaterial;  // the material whose inside the ray travels
    for (uint bounce = 0u; bounce < rt.refraction.x; ++bounce) {
        uint index = hit.material;
        Material m = materials[index];
        bool thin = m.refraction.y > 0.0;
        bool exiting = !thin && (hit.flags & kHitBackface) != 0u;
        float ior = max(m.refraction.x, 1e-3);
        vec3 ng = hit.geometric;
        // A microfacet normal (facing the ray) by the roughness.
        vec3 t, b, n = hit.normal;
        Basis(n, t, b);
        vec3 v = -dir;
        vec3 h = SampleGgxVndf(vec3(dot(v, t), dot(v, b), max(dot(v, n), 1e-4)), hit.roughness * hit.roughness,
                               Random2(seed + uvec3(0u, 0u, 7907u * (bounce + 1u)), 0u));
        n = normalize(t * h.x + b * h.y + n * h.z);
        vec3 r = thin ? dir : refract(dir, n, exiting ? ior : 1.0 / ior);
        bool total = dot(r, r) == 0.0;
        float f0 = (ior - 1.0) / (ior + 1.0);
        f0 *= f0;
        float cosine = exiting ? (total ? 0.0 : clamp(-dot(r, n), 0.0, 1.0)) : clamp(dot(n, v), 0.0, 1.0);
        float F = total ? 1.0 : f0 + (1.0 - f0) * pow(1.0 - cosine, 5.0);
        bool mirrored = total || (bounce > 0u && Random2(seed + uvec3(0u, 0u, 104729u + bounce), 0u).x < F);
        if (!mirrored) {
            if (bounce > 0u && (thin || (!exiting && m.refraction.z <= 0.0))) {
                throughput *= m.transmission.rgb;
            }
            medium = thin ? medium : exiting ? kNoMaterial : index;
        }
        dir = mirrored ? reflect(dir, n) : r;
        TraceMask(OffsetRay(hit.position, dot(dir, ng) > 0.0 ? ng : -ng), dir, cone, kMaskAll);
        if (medium != kNoMaterial && materials[medium].refraction.z > 0.0) {
            Material inside = materials[medium];
            float travelled = hit.t < 0.0 ? 1e30 : hit.t;
            throughput *= pow(max(inside.transmission.rgb, vec3(1e-4)), vec3(travelled / inside.refraction.z));
        }
        if (hit.t < 0.0) {
            bool dome = frame.envRadiance.w > 0.0;
            imageStore(rtRefractionImage, pixel, vec4(throughput * Dome(dir, 0.0), dome ? first : -first));
            return;
        }
        if ((hit.flags & kHitRefracts) == 0u) {
            vec3 shaded = BrightnessClamp(ShadeHit(dir, seed, true), frame.lightClamp.y);
            imageStore(rtRefractionImage, pixel, vec4(throughput * shaded, first));
            return;
        }
    }
    // Out of interfaces inside glass: the dome along the last direction.
    imageStore(rtRefractionImage, pixel, vec4(throughput * Dome(dir, 0.0), first));
}
