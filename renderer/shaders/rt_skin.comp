#version 450
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require
#include "frame.glsl"
#include "scene.glsl"
#include "displace.glsl"

// Ray tracing's skinned instances (RayTracing): their vertices posed as
// mesh.vert poses them (blend shapes, then linear or dual-quaternion
// skinning with four or eight influences), as world-space positions and
// normals for their BLASes (refit every frame) and the closest-hit shader.
// x: vertex, y: the instance's entry in rtSkinned.
// Displaced materials move the rest vertex first, as mesh.vert does
// (displace.glsl, specialized with kDisplacement; Frame::rtDisplacement).

layout(std430, set = 0, binding = 55) readonly buffer RtVertices { float rtVertices[]; };  // the rest Vertex pool
struct RtSkinned {  // rt.glsl
    uvec2 blas;
    uint slot;         // mesh slot
    uint firstVertex;  // in rtSkinnedVertices
    uint instance;     // instance slot
    uint vertexCount;
    uint flags;        // 1: eight influences, 2: dual quaternions
    uint displaced;    // 1: displaced first (Work::displacement)
};
layout(std430, set = 1, binding = 5) readonly buffer RtSkinnedTable { RtSkinned rtSkinned[]; };
layout(std430, set = 1, binding = 4) writeonly buffer RtSkinnedVertices { float rtSkinnedVertices[]; };

// skinning.glsl's switches, per instance here (pipeline constants in mesh.vert).
bool kWideSkin = false, kDualQuaternion = false;

mat4 Joint(uint i, bool previous)
{
    return joints[i];
}

#include "skinning.glsl"

layout(local_size_x = 64) in;

void main()
{
    RtSkinned job = rtSkinned[gl_WorkGroupID.y];
    uint v = gl_GlobalInvocationID.x;
    if (v >= job.vertexCount) {
        return;
    }
    kWideSkin = (job.flags & 1u) != 0u;
    kDualQuaternion = (job.flags & 2u) != 0u;
    Instance inst = instances[job.instance];
    DrawInfo d = draws[job.slot];
    uint rest = (d.vertexBase + v) * 10u;
    vec3 position = vec3(rtVertices[rest], rtVertices[rest + 1u], rtVertices[rest + 2u]);
    vec3 normal = vec3(rtVertices[rest + 3u], rtVertices[rest + 4u], rtVertices[rest + 5u]);
    if (job.displaced != 0u) {
        position = Displace(position, normal, d, vec2(rtVertices[rest + 6u], rtVertices[rest + 7u]));
    }
    uint sv = d.skin + v * (kWideSkin ? 2u : 1u);
    SkinVertex sk = skin[sv];
    uvec4 s = sk.influence, s2 = kWideSkin ? skin[sv + 1u].influence : uvec4(0u);
    vec4 w = vec4(unpackUnorm2x16(s.z), unpackUnorm2x16(s.w));
    if (d.blendShapes > 0u) {
        uint weights = d.blendWeights + (d.blendPerInstance != 0u ? uint(inst.index) * d.blendShapes : 0u);
        for (uint k = 0u; k < sk.blend.y; ++k) {
            vec4 o = blendOffsets[sk.blend.x + k];
            position += o.xyz * blendWeights[weights + min(uint(o.w), d.blendShapes - 1u)];
        }
    }
    mat4 m = SkinMatrix(s, w, s2, inst.joints, false);
    vec3 p = (m * vec4(position, 1.0)).xyz, n = mat3(m) * normal;  // as mesh.vert's normals
    uint out0 = (job.firstVertex + v) * 6u;
    rtSkinnedVertices[out0] = p.x;
    rtSkinnedVertices[out0 + 1u] = p.y;
    rtSkinnedVertices[out0 + 2u] = p.z;
    rtSkinnedVertices[out0 + 3u] = n.x;
    rtSkinnedVertices[out0 + 4u] = n.y;
    rtSkinnedVertices[out0 + 5u] = n.z;
}
