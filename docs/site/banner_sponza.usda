def Scope "mtl"
{
    def Material "glass"
    {
        token outputs:mtlx:surface.connect = </banner/mtl/glass/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:specular_IOR = 1.5
            float inputs:specular_roughness = 0.0
            float inputs:transmission = 1.0
            token outputs:out
        }
    }
    def Material "chrome"
    {
        token outputs:mtlx:surface.connect = </banner/mtl/chrome/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.95, 0.95, 0.95)
            float inputs:metalness = 1.0
            float inputs:specular_roughness = 0.03
            token outputs:out
        }
    }
    def Material "steel"
    {
        token outputs:mtlx:surface.connect = </banner/mtl/steel/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.9, 0.9, 0.92)
            float inputs:metalness = 1.0
            float inputs:specular_anisotropy = 0.8
            float inputs:specular_roughness = 0.35
            token outputs:out
        }
    }
    def Material "paint"
    {
        token outputs:mtlx:surface.connect = </banner/mtl/paint/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.55, 0.03, 0.02)
            float inputs:coat = 1.0
            float inputs:coat_roughness = 0.03
            float inputs:metalness = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }
    }
    def Material "film"
    {
        token outputs:mtlx:surface.connect = </banner/mtl/film/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.6, 0.6, 0.62)
            float inputs:metalness = 1.0
            float inputs:specular_roughness = 0.2
            float inputs:thin_film_IOR = 2.0
            float inputs:thin_film_thickness = 500.0
            token outputs:out
        }
    }
    def Material "jade"
    {
        token outputs:mtlx:surface.connect = </banner/mtl/jade/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.3, 0.6, 0.4)
            float inputs:specular_roughness = 0.15
            float inputs:subsurface_weight = 1.0
            color3f inputs:subsurface_color = (0.35, 0.75, 0.45)
            float inputs:subsurface_radius = 3.0
            color3f inputs:subsurface_radius_scale = (0.5, 1, 0.6)
            token outputs:out
        }
    }
    def Material "marble"
    {
        token outputs:mtlx:surface.connect = </banner/mtl/marble/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </banner/mtl/marble/colour.outputs:out>
            float inputs:coat = 0.6
            float inputs:coat_roughness = 0.05
            float inputs:specular_roughness = 0.3
            token outputs:out
        }
        def Shader "position"
        {
            uniform token info:id = "ND_position_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }
        def Shader "scaled"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </banner/mtl/marble/position.outputs:out>
            float inputs:in2 = 0.05
            float3 outputs:out
        }
        def Shader "turbulence"
        {
            uniform token info:id = "ND_fractal3d_float"
            float inputs:amplitude = 1
            int inputs:octaves = 5
            float3 inputs:position.connect = </banner/mtl/marble/scaled.outputs:out>
            float outputs:out
        }
        def Shader "along"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </banner/mtl/marble/scaled.outputs:out>
            float3 inputs:in2 = (2.5, 1.5, 0.8)
            float outputs:out
        }
        def Shader "warped"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </banner/mtl/marble/along.outputs:out>
            float inputs:in2.connect = </banner/mtl/marble/turbulenceScaled.outputs:out>
            float outputs:out
        }
        def Shader "turbulenceScaled"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </banner/mtl/marble/turbulence.outputs:out>
            float inputs:in2 = 4
            float outputs:out
        }
        def Shader "wave"
        {
            uniform token info:id = "ND_sin_float"
            float inputs:in.connect = </banner/mtl/marble/warped.outputs:out>
            float outputs:out
        }
        def Shader "distance"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </banner/mtl/marble/wave.outputs:out>
            float outputs:out
        }
        def Shader "nearVein"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1 = 1
            float inputs:in2.connect = </banner/mtl/marble/distance.outputs:out>
            float outputs:out
        }
        def Shader "vein"
        {
            uniform token info:id = "ND_power_float"
            float inputs:in1.connect = </banner/mtl/marble/nearVein.outputs:out>
            float inputs:in2 = 3
            float outputs:out
        }
        def Shader "colour"
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg = (0.9, 0.88, 0.84)
            color3f inputs:fg = (0.06, 0.07, 0.1)
            float inputs:mix.connect = </banner/mtl/marble/vein.outputs:out>
            color3f outputs:out
        }
    }

    def Material "glow"
    {
        token outputs:surface.connect = </banner/mtl/glow/surface.outputs:surface>
        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor = (40, 20, 8)
            token outputs:surface
        }
    }
}
}

def Scope "Render"
{
    def RenderSettings "banner" (
        references = @../../tests/scenes/final_settings.usda@</Render/final>
    )
    {
        rel camera = </banner/cam>
        uniform int2 resolution = (1280, 480)
        custom bool eldr:denoise = 1
        custom int eldr:filmSamples = 128
        custom bool eldr:fog = 1
        custom float eldr:fogDensity = 0.00012
        custom float eldr:fogHeightFalloff = 0.001
        custom bool eldr:gi = 1
        custom bool eldr:motionBlur = 1
        custom bool eldr:rtShadows = 1
        custom bool eldr:rtSubsurface = 1
        custom int eldr:textureCompression = 1
    }

    def RenderSettings "bannerTest" (
        references = @../../tests/scenes/final_settings.usda@</Render/final>
    )
    {
        rel camera = </banner/cam>
        uniform int2 resolution = (1280, 480)
        custom bool eldr:denoise = 1
        custom int eldr:filmSamples = 16
        custom bool eldr:fog = 1
        custom float eldr:fogDensity = 0.00012
        custom float eldr:fogHeightFalloff = 0.001
        custom bool eldr:gi = 1
        custom bool eldr:motionBlur = 1
        custom bool eldr:rtShadows = 1
        custom bool eldr:rtSubsurface = 1
        custom int eldr:textureCompression = 1
    }
}
