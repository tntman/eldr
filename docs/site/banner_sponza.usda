#usda 1.0
(
    doc = """README banner: written by docs/site/banner.py layer. Intel Sponza (CC BY 4.0) with
its curtains, ivy and cypress add-ons, read from E:/usd-testscenes/sponza (not in the repo)."""
    endTimeCode = 72
    framesPerSecond = 24
    metersPerUnit = 0.01
    renderSettingsPrimPath = "/Render/banner"
    startTimeCode = 1
    subLayers = [
        @E:/usd-testscenes/sponza/pkg_a_curtains/NewSponza_Curtains_USD_YUp.usda@,
        @E:/usd-testscenes/sponza/pkg_b_ivy/NewSponza_IvyGrowth_USD_YUp.usda@,
        @E:/usd-testscenes/sponza/pkg_c_trees/NewSponza_CypressTree_USDA_YUp.usda@,
        @E:/usd-testscenes/sponza/main_sponza/NewSponza_Main_USD_Yup_003.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

# The cypress add-on is in metres: scaled to Sponza's centimetres, moved behind the light panel.
over "Italian_Cypress_Dense_Custom_05b"
{
    matrix4d xformOp:transform = ( (100, 0, 0, 0), (0, 0, -100, 0), (0, 100, 0, 0), (-620, 0, -170, 1) )
}

