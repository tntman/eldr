#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
)

# Cylinder lights (UsdLux CylinderLight: axis along local X, emitting from
# its side): a fluorescent tube over the ball, its line highlight in the
# glossy floor, and a vertical tube treated as a line. Render with
# usdrecord --disableCameraLight to see only these.

def Camera "cam"
{
    float focalLength = 24
    double3 xformOp:translate = (0, 4, 12)
    float xformOp:rotateX = -16
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def DomeLight "night"
{
    color3f inputs:color = (0.2, 0.3, 0.6)
    float inputs:intensity = 0.02
}

# 3 m tube, 5 cm radius, hanging over the ball; normalized, so its length
# doesn't change its power.
def CylinderLight "tube"
{
    color3f inputs:color = (1, 0.9, 0.8)
    float inputs:intensity = 30
    bool inputs:normalize = 1
    float inputs:length = 3
    float inputs:radius = 0.05
    double3 xformOp:translate = (0, 2.6, 0.5)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

# Upright cyan tube on the right (rotated so its X axis points up).
def CylinderLight "upright"
{
    color3f inputs:color = (0.3, 0.9, 1)
    float inputs:intensity = 20
    float inputs:length = 2
    float inputs:radius = 0.03
    bool treatAsLine = 1
    double3 xformOp:translate = (4.5, 1.2, 0.5)
    float xformOp:rotateZ = 90
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
}

def Scope "mtl"
{
    def Material "matte"
    {
        token outputs:surface.connect = </mtl/matte/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
            float inputs:roughness = 0.7
            token outputs:surface
        }
    }
    def Material "glossy"
    {
        token outputs:surface.connect = </mtl/glossy/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
            float inputs:roughness = 0.15
            token outputs:surface
        }
    }
}

def Mesh "floor" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-6, 0, -4), (-6, 0, 4), (6, 0, 4), (6, 0, -4)]
    rel material:binding = </mtl/glossy>
}

def Mesh "wall" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-6, 0, -4), (6, 0, -4), (6, 5, -4), (-6, 5, -4)]
    rel material:binding = </mtl/matte>
}

def Sphere "ball" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    double radius = 0.8
    double3 xformOp:translate = (0, 0.8, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    rel material:binding = </mtl/matte>
}

def Cube "box" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    double size = 1.2
    double3 xformOp:translate = (2.5, 0.6, -1)
    float xformOp:rotateY = 30
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY"]
    rel material:binding = </mtl/matte>
}

def Cylinder "post" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    double radius = 0.25
    double height = 2.5
    token axis = "Y"
    double3 xformOp:translate = (-2.5, 1.25, -1.5)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    rel material:binding = </mtl/matte>
}
