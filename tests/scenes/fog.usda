#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
)

# Volumetric fog: a low sun behind a colonnade throws shafts of light
# towards the camera, a spot light draws its cone. Fog is a render
# setting: turn on eldr:fog (Volumetric Fog in usdview's Hydra Settings),
# e.g. density 0.03, height falloff 0.15.

def Camera "cam"
{
    float focalLength = 20
    double3 xformOp:translate = (0, 2.2, 14)
    float xformOp:rotateX = -4
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

# Low, behind the colonnade, shining towards the camera.
def DistantLight "sun"
{
    color3f inputs:color = (1, 0.85, 0.65)
    float inputs:intensity = 4
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-18, 165, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def DomeLight "sky"
{
    color3f inputs:color = (0.35, 0.45, 0.7)
    float inputs:intensity = 0.25
}

# Blue spot over the right side of the court.
def SphereLight "spot" (
    prepend apiSchemas = ["ShapingAPI"]
)
{
    color3f inputs:color = (0.4, 0.6, 1)
    float inputs:intensity = 30000
    float inputs:radius = 0.05
    float inputs:shaping:cone:angle = 20
    float inputs:shaping:cone:softness = 0.2
    double3 xformOp:translate = (5, 6, 4)
    float xformOp:rotateX = -90
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def Mesh "ground"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-20, 0, -30), (-20, 0, 20), (20, 0, 20), (20, 0, -30)]
    color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
}

# Back wall with a colonnade: pillars under a lintel.
def Cube "lintel"
{
    double size = 1
    double3 xformOp:translate = (0, 6.5, -6)
    float3 xformOp:scale = (24, 1, 1)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}

def PointInstancer "pillars"
{
    point3f[] positions = [(-10, 3, -6), (-7, 3, -6), (-4, 3, -6), (-1, 3, -6), (2, 3, -6), (5, 3, -6), (8, 3, -6), (11, 3, -6)]
    int[] protoIndices = [0, 0, 0, 0, 0, 0, 0, 0]
    rel prototypes = [</pillars/proto>]

    def Cube "proto"
    {
        double size = 1
        float3 xformOp:scale = (1.2, 6, 1.2)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }
}

def Sphere "ball"
{
    double radius = 1
    double3 xformOp:translate = (-3, 1, 3)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
