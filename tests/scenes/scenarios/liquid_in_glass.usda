def Scope "mtl"
{
    def Material "checker"
    {
        token outputs:mtlx:surface.connect = </mtl/checker/surface.outputs:out>
        token outputs:surface.connect = </mtl/checker/preview.outputs:surface>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 1
            color3f inputs:base_color = (0.8, 0.8, 0.8)
            float inputs:specular_roughness = 0.7
            color3f inputs:base_color.connect = </mtl/checker/rgb.outputs:out>
            token outputs:out
        }
        def Shader "image"
        {
            uniform token info:id = "ND_image_color4"
            asset inputs:file = @../textures/quadrants.png@ (colorSpace = "srgb_texture")
            color4f outputs:out
        }
        def Shader "rgb"
        {
            uniform token info:id = "ND_convert_color4_color3"
            color4f inputs:in.connect = </mtl/checker/image.outputs:out>
            color3f outputs:out
        }
        def Shader "preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:roughness = 0.7
            float inputs:metallic = 0
            float inputs:ior = 1.5
            color3f inputs:diffuseColor.connect = </mtl/checker/tex.outputs:rgb>
            token outputs:surface
        }
        def Shader "tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @../textures/quadrants.png@
            float2 inputs:st.connect = </mtl/checker/st.outputs:result>
            token inputs:sourceColorSpace = "sRGB"
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
            float outputs:a
        }
        def Shader "st"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
    def Material "matte"
    {
        token outputs:mtlx:surface.connect = </mtl/matte/surface.outputs:out>
        token outputs:surface.connect = </mtl/matte/preview.outputs:surface>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 1
            color3f inputs:base_color = (0.5, 0.5, 0.5)
            float inputs:specular_roughness = 0.8
            token outputs:out
        }
        def Shader "preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:roughness = 0.8
            float inputs:metallic = 0
            float inputs:ior = 1.5
            color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
            token outputs:surface
        }
    }
    def Material "glass"
    {
        token outputs:mtlx:surface.connect = </mtl/glass/surface.outputs:out>
        token outputs:surface.connect = </mtl/glass/preview.outputs:surface>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 1
            color3f inputs:base_color = (0.8, 0.8, 0.8)
            float inputs:specular_roughness = 0
            float inputs:transmission = 1
            token outputs:out
        }
        def Shader "preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:roughness = 0
            float inputs:metallic = 0
            float inputs:ior = 1.5
            color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
            float inputs:opacity = 0
            token outputs:surface
        }
    }
    def Material "liquid"
    {
        token outputs:mtlx:surface.connect = </mtl/liquid/surface.outputs:out>
        token outputs:surface.connect = </mtl/liquid/preview.outputs:surface>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 1
            color3f inputs:base_color = (0.8, 0.8, 0.8)
            float inputs:specular_roughness = 0
            float inputs:transmission = 1
            float inputs:specular_IOR = 1.34
            color3f inputs:transmission_color = (0.85, 0.45, 0.08)
            float inputs:transmission_depth = 0.04
            token outputs:out
        }
        def Shader "preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:roughness = 0
            float inputs:metallic = 0
            float inputs:ior = 1.34
            color3f inputs:diffuseColor = (0.85, 0.45, 0.08)
            float inputs:opacity = 0
            token outputs:surface
        }
    }
}

def Scope "Render"
{
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        uniform int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_rt"
    {
        rel camera = </cam>
        uniform int2 resolution = (960, 540)
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 64
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtShadows = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        uniform int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[[\"denoise\", {\"engine\": \"oidn\", \"use_albedo_input\": true, \"use_n_input\": true, \"forcecpu\": false, \"aovs\": [\"C\"]}]]"
        custom token karma:global:convergence_mode = "Path Traced"
        custom int karma:global:pathtracedsamples = 512
    }
}
