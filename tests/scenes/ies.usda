#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
)

# IES profiles (UsdLux shaping:ies:*), compared with Karma (tests/karma_refs.py).
# textures/spot_asym.ies (make_ies.py): a 40 degree spot from nadir, brighter
# towards phi 0 than phi 180, 1 : 0.3; Karma's phi 0 is the light's -X.
# - raw: candela as authored, straight down: its pool leans to -X.
# - normalized: shaping:ies:normalize, angleScale 0.5 (half the beam),
#   turned 90 degrees about Y first: its pool leans to +Z (towards the camera).

def Camera "cam"
{
    float focalLength = 24
    double3 xformOp:translate = (0, 5, 6)
    float xformOp:rotateX = -40
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def SphereLight "raw" (
    prepend apiSchemas = ["ShapingAPI"]
)
{
    float inputs:intensity = 5
    float inputs:radius = 0.05
    asset inputs:shaping:ies:file = @./textures/spot_asym.ies@
    double3 xformOp:translate = (-1.8, 2, 0)
    float xformOp:rotateX = -90
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def SphereLight "normalized" (
    prepend apiSchemas = ["ShapingAPI"]
)
{
    float inputs:intensity = 40
    float inputs:radius = 0.05
    asset inputs:shaping:ies:file = @./textures/spot_asym.ies@
    bool inputs:shaping:ies:normalize = 1
    float inputs:shaping:ies:angleScale = 0.5
    double3 xformOp:translate = (1.8, 2, 0)
    float xformOp:rotateY = 90
    float xformOp:rotateX = -90
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:rotateX"]
}

def Scope "mtl"
{
    def Material "matte"
    {
        token outputs:surface.connect = </mtl/matte/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
            float inputs:roughness = 0.8
            token outputs:surface
        }
    }
}

def Mesh "floor" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-6, 0, -4), (-6, 0, 4), (6, 0, 4), (6, 0, -4)]
    rel material:binding = </mtl/matte>
}

def Mesh "wall" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-6, 0, -4), (6, 0, -4), (6, 5, -4), (-6, 5, -4)]
    rel material:binding = </mtl/matte>
}
