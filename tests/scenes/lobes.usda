}

def Mesh "texturedSpecular" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-0.9, -0.9, 0), (0.9, -0.9, 0), (0.9, 0.9, 0), (-0.9, 0.9, 0)]
    texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (interpolation = "faceVarying")
    uniform token subdivisionScheme = "none"
    rel material:binding = </mtl/texturedSpecular>
    double3 xformOp:translate = (-3.6, -3.6, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Mesh "texturedFilm" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-0.9, -0.9, 0), (0.9, -0.9, 0), (0.9, 0.9, 0), (-0.9, 0.9, 0)]
    texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (interpolation = "faceVarying")
    uniform token subdivisionScheme = "none"
    rel material:binding = </mtl/texturedFilm>
    double3 xformOp:translate = (-1.2, -3.6, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
