#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
)

# The lobes beyond the metallic base (renderer/shaders/brdf.glsl), one
# sphere each, under a sun and the dome. Top row, left to right:
# UsdPreviewSurface specular workflow (orange specularColor over dark blue),
# UsdPreviewSurface clearcoat (sharp coat over rough red), standard_surface
# car paint (blue metallic flake base, coat), OpenPBR amber coat over white,
# standard_surface velvet (pink sheen over dark red), OpenPBR fuzz.
# Bottom row: standard_surface thin film over black (oil slick), OpenPBR
# anodized metal (thin film over grey metal).

def Camera "cam"
{
    float focalLength = 28
    double3 xformOp:translate = (0, 0, 20)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def DistantLight "sun"
{
    float inputs:intensity = 3
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-35, 25, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def DomeLight "dome"
{
    asset inputs:texture:file = @StinsonBeach.hdr@
    float inputs:intensity = 0.5
}

def Scope "mtl"
{
    def Material "specularWorkflow"
    {
        token outputs:surface.connect = </mtl/specularWorkflow/surface.outputs:surface>
        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.02, 0.02, 0.08)
            int inputs:useSpecularWorkflow = 1
            color3f inputs:specularColor = (1, 0.55, 0.1)
            float inputs:roughness = 0.25
            token outputs:surface
        }
    }

    def Material "clearcoat"
    {
        token outputs:surface.connect = </mtl/clearcoat/surface.outputs:surface>
        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.5, 0.03, 0.02)
            float inputs:roughness = 0.6
            float inputs:clearcoat = 1
            float inputs:clearcoatRoughness = 0.02
            token outputs:surface
        }
    }

    def Material "carPaint"
    {
        token outputs:mtlx:surface.connect = </mtl/carPaint/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.05, 0.12, 0.45)
            float inputs:metalness = 0.5
            float inputs:specular_roughness = 0.45
            float inputs:coat = 1
            float inputs:coat_roughness = 0.03
            token outputs:out
        }
    }

    def Material "amberCoat"
    {
        token outputs:mtlx:surface.connect = </mtl/amberCoat/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.9, 0.9, 0.9)
            float inputs:specular_roughness = 0.5
            float inputs:coat_weight = 1
            color3f inputs:coat_color = (1, 0.6, 0.2)
            float inputs:coat_roughness = 0.05
            token outputs:out
        }
    }

    def Material "velvet"
    {
        token outputs:mtlx:surface.connect = </mtl/velvet/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.25, 0.02, 0.05)
            float inputs:specular = 0.2
            float inputs:specular_roughness = 0.6
            float inputs:sheen = 1
            color3f inputs:sheen_color = (1, 0.6, 0.7)
            float inputs:sheen_roughness = 0.3
            token outputs:out
        }
    }

    def Material "fuzz"
    {
        token outputs:mtlx:surface.connect = </mtl/fuzz/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.05, 0.08, 0.3)
            float inputs:specular_roughness = 0.7
            float inputs:fuzz_weight = 1
            color3f inputs:fuzz_color = (0.8, 0.85, 1)
            float inputs:fuzz_roughness = 0.5
            token outputs:out
        }
    }

    def Material "oilSlick"
    {
        token outputs:mtlx:surface.connect = </mtl/oilSlick/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.01, 0.01, 0.01)
            float inputs:specular_roughness = 0.15
            float inputs:thin_film_thickness = 400
            float inputs:thin_film_IOR = 1.4
            token outputs:out
        }
    }

    def Material "anodized"
    {
        token outputs:mtlx:surface.connect = </mtl/anodized/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.6, 0.6, 0.62)
            float inputs:base_metalness = 1
            float inputs:specular_roughness = 0.25
            float inputs:thin_film_weight = 1
            float inputs:thin_film_thickness = 0.35
            float inputs:thin_film_ior = 2
            token outputs:out
        }
    }
}

def Sphere "specularWorkflow" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    rel material:binding = </mtl/specularWorkflow>
    double3 xformOp:translate = (-6, 1.2, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "clearcoat" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    rel material:binding = </mtl/clearcoat>
    double3 xformOp:translate = (-3.6, 1.2, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "carPaint" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    rel material:binding = </mtl/carPaint>
    double3 xformOp:translate = (-1.2, 1.2, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "amberCoat" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    rel material:binding = </mtl/amberCoat>
    double3 xformOp:translate = (1.2, 1.2, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "velvet" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    rel material:binding = </mtl/velvet>
    double3 xformOp:translate = (3.6, 1.2, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "fuzz" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    rel material:binding = </mtl/fuzz>
    double3 xformOp:translate = (6, 1.2, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "oilSlick" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    rel material:binding = </mtl/oilSlick>
    double3 xformOp:translate = (-6, -1.2, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "anodized" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    rel material:binding = </mtl/anodized>
    double3 xformOp:translate = (-3.6, -1.2, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
