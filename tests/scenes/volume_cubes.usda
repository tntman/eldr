#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
    subLayers = [@./volume.usda@]
)

# volume.usda plus two shadowed sphere lights (six cube tiles each) near the cloud.

def SphereLight "bulb1"
{
    float inputs:intensity = 3000
    float inputs:radius = 0.15
    bool inputs:shadow:enable = 1
    double3 xformOp:translate = (-2, 3, 3)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def SphereLight "bulb2"
{
    float inputs:intensity = 3000
    float inputs:radius = 0.15
    bool inputs:shadow:enable = 1
    double3 xformOp:translate = (1, 3, 2)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
