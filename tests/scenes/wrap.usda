#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
)

# Texture wrap modes, st (-0.5, -0.5)..(1.5, 1.5) over step3's quadrants
# texture (red, green / blue, white), shown as emission. Top row:
# UsdUVTexture wrapS/wrapT repeat, mirror, clamp, black. Middle row:
# MaterialX image u/vaddressmode periodic, mirror, clamp, constant. Bottom
# row: UsdUVTexture without wrap modes (useMetadata: black for a png);
# wrapS repeat, wrapT clamp; MaterialX u mirror, v periodic; a MaterialX
# graph (image times one, a material program) with clamp.

def Camera "cam"
{
    float focalLength = 28
    double3 xformOp:translate = (0, 0, 12)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Scope "mtl"
{
    def Material "repeat"
    {
        token outputs:surface.connect = </mtl/repeat/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor.connect = </mtl/repeat/tex.outputs:rgb>
            float inputs:roughness = 1
            token outputs:surface
        }
        def Shader "tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/quadrants.png@
            float2 inputs:st.connect = </mtl/repeat/reader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }
        def Shader "reader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
    def Material "mirror"
    {
        token outputs:surface.connect = </mtl/mirror/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor.connect = </mtl/mirror/tex.outputs:rgb>
            float inputs:roughness = 1
            token outputs:surface
        }
        def Shader "tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/quadrants.png@
            float2 inputs:st.connect = </mtl/mirror/reader.outputs:result>
            token inputs:wrapS = "mirror"
            token inputs:wrapT = "mirror"
            float3 outputs:rgb
        }
        def Shader "reader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
    def Material "clamp"
    {
        token outputs:surface.connect = </mtl/clamp/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor.connect = </mtl/clamp/tex.outputs:rgb>
            float inputs:roughness = 1
            token outputs:surface
        }
        def Shader "tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/quadrants.png@
            float2 inputs:st.connect = </mtl/clamp/reader.outputs:result>
            token inputs:wrapS = "clamp"
            token inputs:wrapT = "clamp"
            float3 outputs:rgb
        }
        def Shader "reader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
    def Material "black"
    {
        token outputs:surface.connect = </mtl/black/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor.connect = </mtl/black/tex.outputs:rgb>
            float inputs:roughness = 1
            token outputs:surface
        }
        def Shader "tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/quadrants.png@
            float2 inputs:st.connect = </mtl/black/reader.outputs:result>
            token inputs:wrapS = "black"
            token inputs:wrapT = "black"
            float3 outputs:rgb
        }
        def Shader "reader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
    def Material "periodic"
    {
        token outputs:mtlx:surface.connect = </mtl/periodic/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/periodic/image.outputs:out>
            token outputs:out
        }
        def Shader "image"
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @./textures/quadrants.png@ (colorSpace = "srgb_texture")
            string inputs:uaddressmode = "periodic"
            string inputs:vaddressmode = "periodic"
            color3f outputs:out
        }
    }
    def Material "mtlxMirror"
    {
        token outputs:mtlx:surface.connect = </mtl/mtlxMirror/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/mtlxMirror/image.outputs:out>
            token outputs:out
        }
        def Shader "image"
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @./textures/quadrants.png@ (colorSpace = "srgb_texture")
            string inputs:uaddressmode = "mirror"
            string inputs:vaddressmode = "mirror"
            color3f outputs:out
        }
    }
    def Material "mtlxClamp"
    {
        token outputs:mtlx:surface.connect = </mtl/mtlxClamp/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/mtlxClamp/image.outputs:out>
            token outputs:out
        }
        def Shader "image"
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @./textures/quadrants.png@ (colorSpace = "srgb_texture")
            string inputs:uaddressmode = "clamp"
            string inputs:vaddressmode = "clamp"
            color3f outputs:out
        }
    }
    def Material "constant"
    {
        token outputs:mtlx:surface.connect = </mtl/constant/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/constant/image.outputs:out>
            token outputs:out
        }
        def Shader "image"
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @./textures/quadrants.png@ (colorSpace = "srgb_texture")
            string inputs:uaddressmode = "constant"
            string inputs:vaddressmode = "constant"
            color3f outputs:out
        }
    }
    def Material "useMetadata"
    {
        token outputs:surface.connect = </mtl/useMetadata/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor.connect = </mtl/useMetadata/tex.outputs:rgb>
            float inputs:roughness = 1
            token outputs:surface
        }
        def Shader "tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/quadrants.png@
            float2 inputs:st.connect = </mtl/useMetadata/reader.outputs:result>
            float3 outputs:rgb
        }
        def Shader "reader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
    def Material "repeatClamp"
    {
        token outputs:surface.connect = </mtl/repeatClamp/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor.connect = </mtl/repeatClamp/tex.outputs:rgb>
            float inputs:roughness = 1
            token outputs:surface
        }
        def Shader "tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/quadrants.png@
            float2 inputs:st.connect = </mtl/repeatClamp/reader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "clamp"
            float3 outputs:rgb
        }
        def Shader "reader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
    def Material "mirrorPeriodic"
    {
        token outputs:mtlx:surface.connect = </mtl/mirrorPeriodic/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/mirrorPeriodic/image.outputs:out>
            token outputs:out
        }
        def Shader "image"
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @./textures/quadrants.png@ (colorSpace = "srgb_texture")
            string inputs:uaddressmode = "mirror"
            string inputs:vaddressmode = "periodic"
            color3f outputs:out
        }
    }
    def Material "graphClamp"
    {
        token outputs:mtlx:surface.connect = </mtl/graphClamp/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/graphClamp/times.outputs:out>
            token outputs:out
        }
        def Shader "image"
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @./textures/quadrants.png@ (colorSpace = "srgb_texture")
            string inputs:uaddressmode = "clamp"
            string inputs:vaddressmode = "clamp"
            color3f outputs:out
        }
        def Shader "times"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </mtl/graphClamp/image.outputs:out>
            float inputs:in2 = 1
            color3f outputs:out
        }
    }
}

class Mesh "_quad" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-0.8, -0.8, 0), (0.8, -0.8, 0), (0.8, 0.8, 0), (-0.8, 0.8, 0)]
    texCoord2f[] primvars:st = [(-0.5, -0.5), (1.5, -0.5), (1.5, 1.5), (-0.5, 1.5)] (interpolation = "vertex")
    uniform token subdivisionScheme = "none"
}

def Mesh "repeat" (inherits = </_quad>)
{
    rel material:binding = </mtl/repeat>
    double3 xformOp:translate = (-2.7, 2.0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Mesh "mirror" (inherits = </_quad>)
{
    rel material:binding = </mtl/mirror>
    double3 xformOp:translate = (-0.9, 2.0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Mesh "clamp" (inherits = </_quad>)
{
    rel material:binding = </mtl/clamp>
    double3 xformOp:translate = (0.9, 2.0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Mesh "black" (inherits = </_quad>)
{
    rel material:binding = </mtl/black>
    double3 xformOp:translate = (2.7, 2.0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
