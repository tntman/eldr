{
    rel material:binding = </mtl/useMetadata>
    double3 xformOp:translate = (-2.7, -2.0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Mesh "repeatClamp" (inherits = </_quad>)
{
    rel material:binding = </mtl/repeatClamp>
    double3 xformOp:translate = (-0.9, -2.0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
