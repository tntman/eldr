#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 0.01
    startTimeCode = 1
    endTimeCode = 24
    timeCodesPerSecond = 24
)

# Camera lens effects, in centimetres: an 85 mm lens at f/1.4 focused at
# 5 m on a row of spheres from 2 to 20 m (only the one at 5 m sharp), and a
# cube crossing the view at 4 m, 17 cm a frame, with the shutter open half
# a frame around each one (motion blur from frame 2 on).

def Camera "cam"
{
    float focalLength = 85
    float horizontalAperture = 36
    float verticalAperture = 24
    float fStop = 1.4
    float focusDistance = 500
    double shutter:open = -0.25
    double shutter:close = 0.25
    float2 clippingRange = (10, 100000)
    double3 xformOp:translate = (0, 60, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def DistantLight "sun"
{
    float inputs:intensity = 3
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-50, 30, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def Mesh "ground"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-2000, 0, 500), (2000, 0, 500), (2000, 0, -5000), (-2000, 0, -5000)]
    color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
}

def Sphere "s200"
{
    double radius = 25
    double3 xformOp:translate = (-60, 25, -200)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    color3f[] primvars:displayColor = [(0.9, 0.2, 0.2)]
}
def Sphere "s500"
{
    double radius = 25
    double3 xformOp:translate = (-10, 25, -500)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    color3f[] primvars:displayColor = [(0.2, 0.9, 0.2)]
}
def Sphere "s1000"
{
    double radius = 25
    double3 xformOp:translate = (60, 25, -1000)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    color3f[] primvars:displayColor = [(0.2, 0.2, 0.9)]
}
def Sphere "s2000"
{
    double radius = 25
    double3 xformOp:translate = (160, 25, -2000)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    color3f[] primvars:displayColor = [(0.9, 0.9, 0.2)]
}

def Cube "mover"
{
    double size = 30
    color3f[] primvars:displayColor = [(0.9, 0.5, 0.1)]
    double3 xformOp:translate.timeSamples = {
        1: (-200, 90, -400),
        24: (200, 90, -400),
    }
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
