#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
)

# Reflections beyond the screen. Turn on eldr:planarReflections: the
# polished floor (flat, glossy, large) mirrors the columns, the arch and
# the ball, also where they leave the view (SSR can't). Turn on
# eldr:reflectionProbe: the chrome ball shows the room behind the camera
# (the red wall), which the dome can't. The small blue tile is flagged
# with primvars:eldr:planarReflection, which would make it the mirror
# instead of the floor.

def Camera "cam"
{
    float focalLength = 22
    double3 xformOp:translate = (0, 2.2, 9)
    float xformOp:rotateX = -10
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def DomeLight "sky"
{
    color3f inputs:color = (0.55, 0.65, 0.9)
    float inputs:intensity = 0.4
}

def DistantLight "sun"
{
    float inputs:intensity = 2.5
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-45, 30, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def Scope "mtl"
{
    def Material "polished"
    {
        token outputs:surface.connect = </mtl/polished/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.08, 0.08, 0.09)
            float inputs:roughness = 0.08
            token outputs:surface
        }
    }
    def Material "chrome"
    {
        token outputs:surface.connect = </mtl/chrome/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
            float inputs:metallic = 1
            float inputs:roughness = 0.05
            token outputs:surface
        }
    }
    def Material "stone"
    {
        token outputs:surface.connect = </mtl/stone/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.7, 0.66, 0.6)
            float inputs:roughness = 0.8
            token outputs:surface
        }
    }
    def Material "red"
    {
        token outputs:surface.connect = </mtl/red/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.7, 0.08, 0.05)
            float inputs:roughness = 0.7
            token outputs:surface
        }
    }
}

def Mesh "floor" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-8, 0, -8), (-8, 0, 14), (8, 0, 14), (8, 0, -8)]
    rel material:binding = </mtl/polished>
}

# Behind the camera: only reflections show it.
def Mesh "backWall" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-8, 0, 14), (-8, 6, 14), (8, 6, 14), (8, 0, 14)]
    rel material:binding = </mtl/red>
}

def PointInstancer "columns"
{
    point3f[] positions = [(-4, 2.5, -4), (4, 2.5, -4), (-4, 2.5, 2), (4, 2.5, 2)]
    int[] protoIndices = [0, 0, 0, 0]
    rel prototypes = [</columns/proto>]

    def Cylinder "proto" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.4
        double height = 5
        token axis = "Y"
        rel material:binding = </mtl/stone>
    }
}

def Cube "arch" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    double size = 1
    double3 xformOp:translate = (0, 5.3, -4)
    float3 xformOp:scale = (9, 0.6, 1)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    rel material:binding = </mtl/stone>
}

def Sphere "ball" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    double radius = 1
    double3 xformOp:translate = (0, 1, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    rel material:binding = </mtl/chrome>
}

def Mesh "tile"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(2, 0.01, 4), (2, 0.01, 5), (3, 0.01, 5), (3, 0.01, 4)]
    color3f[] primvars:displayColor = [(0.1, 0.2, 0.6)]
    bool primvars:eldr:planarReflection = 0 (
        interpolation = "constant"
    )
}
