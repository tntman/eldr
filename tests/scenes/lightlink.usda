#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
)

# Light linking (UsdLux collection:lightLink / collection:shadowLink, as
# Houdini's Light Linker LOP writes them), compared with Karma
# (tests/karma_refs.py). Three balls on a floor:
# - key (front left, above) lights everything but the right ball;
# - fill (right side) is shadowed by everything but the left ball.

def Camera "cam"
{
    float focalLength = 24
    double3 xformOp:translate = (0, 3, 8)
    float xformOp:rotateX = -18
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def SphereLight "key"
{
    float inputs:intensity = 60
    float inputs:radius = 0.2
    uniform bool collection:lightLink:includeRoot = 1
    rel collection:lightLink:excludes = </balls/right>
    double3 xformOp:translate = (-3, 5, 3)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def SphereLight "fill"
{
    color3f inputs:color = (0.6, 0.8, 1)
    float inputs:intensity = 40
    float inputs:radius = 0.2
    uniform bool collection:shadowLink:includeRoot = 1
    rel collection:shadowLink:excludes = </balls/left>
    double3 xformOp:translate = (5, 2, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Scope "mtl"
{
    def Material "matte"
    {
        token outputs:surface.connect = </mtl/matte/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
            float inputs:roughness = 0.8
            token outputs:surface
        }
    }
}

def Mesh "floor" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-6, 0, -4), (-6, 0, 4), (6, 0, 4), (6, 0, -4)]
    rel material:binding = </mtl/matte>
}

def Xform "balls"
{
    def Sphere "left" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.8
        double3 xformOp:translate = (-2.2, 0.8, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </mtl/matte>
    }

    def Sphere "middle" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.8
        double3 xformOp:translate = (0, 0.8, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </mtl/matte>
    }

    def Sphere "right" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.8
        double3 xformOp:translate = (2.2, 0.8, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </mtl/matte>
    }
}
