#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
)

# Holdouts (matte objects): black with zero alpha, cut out of the image
# (an app shows its background there, a comp the plate), still hiding what
# is behind them and casting shadows. Ways to author one:
#   /ball:  primvars:karma:object:holdoutmode = 2 (Karma's, background;
#           taken as matte)
#   /box:   primvars:karma:object:holdoutmode = 1 (Karma's, matte)
#   /cone:  in the matte collection of /passes/holdouts, a UsdRenderPass,
#           while that pass is active (usdview: right-click the pass, "Set
#           As Active Render Pass"; usdrecord --renderPassPrimPath)
# hdvk:holdouts off draws them as usual.

def Camera "cam"
{
    float focalLength = 30
    double3 xformOp:translate = (0, 1.2, 6)
    float xformOp:rotateX = -8
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def DistantLight "sun"
{
    float inputs:intensity = 3
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-50, 30, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def DomeLight "sky"
{
    asset inputs:texture:file = @StinsonBeach.hdr@
    float inputs:intensity = 0.5
}

def Scope "passes"
{
    def RenderPass "holdouts" (
        prepend apiSchemas = ["CollectionAPI:matte"]
    )
    {
        rel collection:matte:includes = </cone>
        rel renderSource = </passes/settings>
    }

    # usdrecord takes the pass's camera from its render source.
    def RenderSettings "settings"
    {
        rel camera = </cam>
    }
}

def Scope "mtl"
{
    def Material "floor"
    {
        token outputs:surface.connect = </mtl/floor/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </mtl/floor/tex.outputs:rgb>
            float inputs:roughness = 0.8
            token outputs:surface
        }
        def Shader "tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @./textures/udim.1001.png@
            float2 inputs:st.connect = </mtl/floor/st.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }
        def Shader "st"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
}

def Mesh "floor" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-4, 0, -4), (4, 0, -4), (4, 0, 4), (-4, 0, 4)]
    texCoord2f[] primvars:st = [(0, 0), (4, 0), (4, 4), (0, 4)] (interpolation = "vertex")
    uniform token subdivisionScheme = "none"
    rel material:binding = </mtl/floor>
}

def Sphere "ball"
{
    double radius = 0.6
    color3f[] primvars:displayColor = [(0.8, 0.3, 0.2)]
    int primvars:karma:object:holdoutmode = 2
    double3 xformOp:translate = (-1.6, 0.6, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Cube "box"
{
    double size = 1
    color3f[] primvars:displayColor = [(0.2, 0.5, 0.8)]
    int primvars:karma:object:holdoutmode = 1
    double3 xformOp:translate = (0, 0.5, -0.5)
    float xformOp:rotateY = 30
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY"]
}

def Cone "cone"
{
    double height = 1.4
    double radius = 0.5
    uniform token axis = "Y"
    color3f[] primvars:displayColor = [(0.3, 0.8, 0.3)]
    double3 xformOp:translate = (1.6, 0.7, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "front"
{
    double radius = 0.35
    color3f[] primvars:displayColor = [(0.9, 0.9, 0.9)]
    double3 xformOp:translate = (-0.9, 0.35, 1.2)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
