#usda 1.0
(
    doc = """The flood add-on: a FLIP water mesh (Alembic, 1.2 million faces, new topology every frame)
pouring along the Sponza courtyard, at the frame of the package's own renders (render frame 1),
in clear water (MaterialX standard_surface, IOR 1.33) refracting the floor below. The Alembic
is Y up in centimetres: turned to Z up here. Camera: the package's Blender camera. Needs
E:/usd-testscenes/sponza/main_sponza and pkg_f_flood."""
    metersPerUnit = 0.01
    upAxis = "Z"
    subLayers = [
        @settings.usda@,
        @sponza_lights.usda@,
        @E:/usd-testscenes/sponza/main_sponza/NewSponza_Main_USD_Zup_003.usda@
    ]
)

def Xform "flood"
{
    float xformOp:rotateX = 90
    uniform token[] xformOpOrder = ["xformOp:rotateX"]

    def "water" (
        references = @E:/usd-testscenes/sponza/pkg_f_flood/abc/sponza_flood_left_final_slow_v0011.abc@</sponza_flood_flip> (offset = -49.8)
    )
    {
        over "transform_scale_50x" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </flood/mtl/water>
        }
    }

    def Scope "mtl"
    {
        def Material "water"
        {
            token outputs:mtlx:surface.connect = </flood/mtl/water/surface.outputs:out>
            token outputs:surface.connect = </flood/mtl/water/preview.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1
                color3f inputs:base_color = (0.8, 0.8, 0.8)
                float inputs:specular_roughness = 0.05
                float inputs:specular_IOR = 1.33
                float inputs:transmission = 1
                color3f inputs:transmission_color = (0.85, 0.95, 1)
                float inputs:transmission_depth = 200
                token outputs:out
            }

            def Shader "preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.95, 1)
                float inputs:roughness = 0.05
                float inputs:ior = 1.33
                float inputs:opacity = 0
                token outputs:surface
            }
        }
    }
}

def Camera "cam"
{
    float2 clippingRange = (1, 100000)
    float focalLength = 50
    float horizontalAperture = 100
    float verticalAperture = 56.25
    matrix4d xformOp:transform = ( (0.36162, -0.93233, 0, 0), (0.55326, 0.21459, 0.8049, 0), (-0.75043, -0.29107, 0.59342, 0), (-816.8325, -199.406, 787.1791, 1) )
    uniform token[] xformOpOrder = ["xformOp:transform"]
}
