#usda 1.0
(
    doc = """Sponza arcade: the ground-floor arcade beside the courtyard, lit by sun bounced off the
floor and through the curtains. Camera: Sponza's PhysCamera003 (without its exposure); the
cypress, which stands in front of it, is off."""
    metersPerUnit = 0.01
    upAxis = "Z"
    subLayers = [@settings.usda@, @sponza_day.usda@]
)

over "Italian_Cypress_Dense_Custom_05b" (
    active = false
)
{
}

def Camera "cam"
{
    float2 clippingRange = (1, 100000)
    float focalLength = 30.068502
    float horizontalAperture = 35
    float verticalAperture = 19.6875
    matrix4d xformOp:transform = ( (0.332853, 0.942979, 0, 0), (0.0814807, -0.028761, 0.99626, 0), (0.939452, -0.331608, -0.0864077, 0), (270.302, -211.138, 135.49, 1) )
    uniform token[] xformOpOrder = ["xformOp:transform"]
}
