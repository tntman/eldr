#usda 1.0
(
    doc = "A patch of 900 hair curves on the short box, with a brown hair-like material."
    defaultPrim = "cornell_box"
    metersPerUnit = 1
    upAxis = "Z"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../cornell.usda@]
)

