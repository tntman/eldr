#usda 1.0
(
    doc = "The ceiling light shows a four-colour texture, which tints the walls, the floor and a chrome ball."
    defaultPrim = "cornell_box"
    metersPerUnit = 1
    upAxis = "Z"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../cornell.usda@]
)

over "cornell_box"
{
    over "ceiling_light"
    {
        asset inputs:texture:file = @../../textures/quadrants.png@
    }
    def Material "chrome"
    {
        token outputs:mtlx:surface.connect = </cornell_box/chrome/S.outputs:out>
        def Shader "S"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 1
            color3f inputs:base_color = (0.95, 0.95, 0.95)
            float inputs:metalness = 1
            float inputs:specular_roughness = 0.05
            token outputs:out
        }
    }
    def Sphere "ball" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double radius = 0.75
        rel material:binding = </cornell_box/chrome>
        double3 xformOp:translate = (4.1, 0.75, 1.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
