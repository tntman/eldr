#usda 1.0
(
    doc = "A clear glass ball under the ceiling light: refraction, and the caustic it focuses on the floor."
    defaultPrim = "cornell_box"
    metersPerUnit = 1
    upAxis = "Z"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../cornell.usda@]
)

over "cornell_box"
{
    def Material "glass"
    {
        token outputs:mtlx:surface.connect = </cornell_box/glass/S.outputs:out>
        def Shader "S"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular_roughness = 0
            float inputs:specular_IOR = 1.5
            float inputs:transmission = 1
            color3f inputs:transmission_color = (1, 1, 1)
            token outputs:out
        }
    }
    def Sphere "ball" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double radius = 0.75
        rel material:binding = </cornell_box/glass>
        double3 xformOp:translate = (4.1, 0.75, 1.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
