#usda 1.0
(
    doc = "Three material lobes on balls along the front: velvet sheen, thin-film iridescence and brushed anisotropic metal."
    defaultPrim = "cornell_box"
    metersPerUnit = 1
    upAxis = "Z"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../cornell.usda@]
)

over "cornell_box"
{
    def Material "velvet"
    {
        token outputs:mtlx:surface.connect = </cornell_box/velvet/S.outputs:out>
        def Shader "S"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.25, 0.02, 0.06)
            float inputs:specular = 0
            float inputs:sheen = 1
            color3f inputs:sheen_color = (1, 0.6, 0.7)
            float inputs:sheen_roughness = 0.3
            token outputs:out
        }
    }
    def Material "film"
    {
        token outputs:mtlx:surface.connect = </cornell_box/film/S.outputs:out>
        def Shader "S"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.02, 0.02, 0.02)
            float inputs:specular_roughness = 0.12
            float inputs:thin_film_thickness = 400
            float inputs:thin_film_IOR = 1.4
            token outputs:out
        }
    }
    def Material "brushed"
    {
        token outputs:mtlx:surface.connect = </cornell_box/brushed/S.outputs:out>
        def Shader "S"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.9, 0.9, 0.9)
            float inputs:metalness = 1
            float inputs:specular_roughness = 0.35
            float inputs:specular_anisotropy = 0.8
            token outputs:out
        }
    }
    def Sphere "velvet_ball" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double radius = 0.45
        rel material:binding = </cornell_box/velvet>
        double3 xformOp:translate = (0.75, 0.45, 0.55)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "film_ball" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double radius = 0.45
        rel material:binding = </cornell_box/film>
        double3 xformOp:translate = (2.78, 0.45, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "brushed_ball" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double radius = 0.45
        rel material:binding = </cornell_box/brushed>
        double3 xformOp:translate = (4.8, 0.45, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
