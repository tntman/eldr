#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
)

# White furnace for eldr:multiScatter (tests/test_furnace.py): a rough white
# OpenPBR metal sphere (F0 = 1, roughness 0.8) under a uniform white dome of
# intensity 1. Energy conserving, it reads 1; single scattering loses what
# the rough lobe's extra bounces would return. UsdPreviewSurface is single
# scattering by its spec (as Storm and Karma), the setting on or off.

def Camera "cam"
{
    float focalLength = 50
    double3 xformOp:translate = (0, 0, 10)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def DomeLight "dome"
{
    color3f inputs:color = (1, 1, 1)
    float inputs:intensity = 1
}

def Sphere "ball" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </mtl/metal>
}

def Scope "mtl"
{
    def Material "metal"
    {
        token outputs:mtlx:surface.connect = </mtl/metal/shader.outputs:out>
        def Shader "shader"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (1, 1, 1)
            float inputs:base_metalness = 1
            float inputs:specular_roughness = 0.8
            token outputs:out
        }
    }
}
