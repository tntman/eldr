#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
    subLayers = [@./volume.usda@]
)

# volume.usda plus a spot light above the cloud, shining down through it.

def SphereLight "spot" (
    prepend apiSchemas = ["ShapingAPI"]
)
{
    float inputs:intensity = 4000
    float inputs:radius = 0.15
    float inputs:shaping:cone:angle = 35
    float inputs:shaping:cone:softness = 0.2
    bool inputs:shadow:enable = 1
    double3 xformOp:translate = (-2, 4, 4)
    float3 xformOp:rotateXYZ = (-45, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}
