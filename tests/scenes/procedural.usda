        def Shader "n"
        {
            uniform token info:id = "ND_worleynoise3d_vector3"
            float3 inputs:position.connect = </mtl/worley3dSolid/p.outputs:out>
            int inputs:style = 1
            float3 outputs:out
        }
        def Shader "c"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </mtl/worley3dSolid/n.outputs:out>
            float3 outputs:out
        }
    }
    def Material "worley2dF1F2"
    {
        token outputs:mtlx:surface.connect = </mtl/worley2dF1F2/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/worley2dF1F2/n.outputs:out>
            token outputs:out
        }
        def Shader "uv0"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "uv"
        {
            uniform token info:id = "ND_multiply_vector2FA"
            float2 inputs:in1.connect = </mtl/worley2dF1F2/uv0.outputs:out>
            float inputs:in2 = 4
            float2 outputs:out
        }
        def Shader "w"
        {
            uniform token info:id = "ND_worleynoise2d_vector2"
            float2 inputs:texcoord.connect = </mtl/worley2dF1F2/uv.outputs:out>
            float2 outputs:out
        }
        def Shader "x"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </mtl/worley2dF1F2/w.outputs:out>
            float outputs:outx
            float outputs:outy
        }
        def Shader "n"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </mtl/worley2dF1F2/x.outputs:outx>
            float inputs:in2.connect = </mtl/worley2dF1F2/x.outputs:outy>
            float inputs:in3 = 0
            color3f outputs:out
        }
    }
    def Material "noise2dDefault"
