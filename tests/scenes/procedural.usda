#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
)

# MaterialX procedurals as emission, 4 x 3 quads: noise2d (color3,
# texcoord x 6), noise3d (float, object position x 3; the quad is rotated
# and scaled, which object space doesn't see), fractal3d (color3, 4
# octaves), cellnoise2d, cellnoise3d, worleynoise2d (jitter 0.8),
# worleynoise3d (vector3, solid style), worleynoise2d vector2 (F1 red, F2
# green), noise2d on the default texture coordinates (st; Storm reads 0
# there), world position x 0.1 + 0.5, object normal, noise3d vector4 (x,
# y, w) in world space.

def Camera "cam"
{
    float focalLength = 24
    double3 xformOp:translate = (0, 0, 13)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Scope "mtl"
{
    def Material "noise2d"
    {
        token outputs:mtlx:surface.connect = </mtl/noise2d/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/noise2d/n.outputs:out>
            token outputs:out
        }
        def Shader "uv0"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "uv"
        {
            uniform token info:id = "ND_multiply_vector2FA"
            float2 inputs:in1.connect = </mtl/noise2d/uv0.outputs:out>
            float inputs:in2 = 6
            float2 outputs:out
        }
        def Shader "n"
        {
            uniform token info:id = "ND_noise2d_color3FA"
            float2 inputs:texcoord.connect = </mtl/noise2d/uv.outputs:out>
            float inputs:amplitude = 0.5
            float inputs:pivot = 0.5
            color3f outputs:out
        }
    }
    def Material "noise3d"
    {
        token outputs:mtlx:surface.connect = </mtl/noise3d/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/noise3d/c.outputs:out>
            token outputs:out
        }
        def Shader "p0"
        {
            uniform token info:id = "ND_position_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }
        def Shader "p"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </mtl/noise3d/p0.outputs:out>
            float inputs:in2 = 3
            float3 outputs:out
        }
        def Shader "n"
        {
            uniform token info:id = "ND_noise3d_float"
            float3 inputs:position.connect = </mtl/noise3d/p.outputs:out>
            float inputs:amplitude = 0.5
            float inputs:pivot = 0.5
            float outputs:out
        }
        def Shader "c"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </mtl/noise3d/n.outputs:out>
            float outputs:out
        }
    }
    def Material "fractal3d"
    {
        token outputs:mtlx:surface.connect = </mtl/fractal3d/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/fractal3d/n.outputs:out>
            token outputs:out
        }
        def Shader "p0"
        {
            uniform token info:id = "ND_position_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }
        def Shader "p"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </mtl/fractal3d/p0.outputs:out>
            float inputs:in2 = 2
            float3 outputs:out
        }
        def Shader "f"
        {
            uniform token info:id = "ND_fractal3d_color3FA"
            float3 inputs:position.connect = </mtl/fractal3d/p.outputs:out>
            float inputs:amplitude = 0.35
            int inputs:octaves = 4
            color3f outputs:out
        }
        def Shader "n"
        {
            uniform token info:id = "ND_add_color3FA"
            color3f inputs:in1.connect = </mtl/fractal3d/f.outputs:out>
            float inputs:in2 = 0.5
            color3f outputs:out
        }
    }
    def Material "cellnoise2d"
    {
        token outputs:mtlx:surface.connect = </mtl/cellnoise2d/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/cellnoise2d/c.outputs:out>
