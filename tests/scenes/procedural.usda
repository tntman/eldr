            string inputs:space = "object"
            float3 outputs:out
        }
        def Shader "p"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </mtl/cellnoise3d/p0.outputs:out>
            float inputs:in2 = 3
            float3 outputs:out
        }
        def Shader "n"
        {
            uniform token info:id = "ND_cellnoise3d_float"
            float3 inputs:position.connect = </mtl/cellnoise3d/p.outputs:out>
            float outputs:out
        }
        def Shader "c"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </mtl/cellnoise3d/n.outputs:out>
