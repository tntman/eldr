        }
        def Shader "uv0"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "uv"
        {
            uniform token info:id = "ND_multiply_vector2FA"
            float2 inputs:in1.connect = </mtl/cellnoise2d/uv0.outputs:out>
            float inputs:in2 = 6
            float2 outputs:out
        }
        def Shader "n"
        {
            uniform token info:id = "ND_cellnoise2d_float"
            float2 inputs:texcoord.connect = </mtl/cellnoise2d/uv.outputs:out>
