#usda 1.0
(
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [
        @./geo.usda@
    ]
    upAxis = "Y"
)

# Subsurface scattering: tests/scenes/subsurface.usda, a head-like ball with
# thin ears (standard_surface skin), an OpenPBR jade ball and a thin-walled
# leaf, with the sun low behind them.
# /Render/subsurface (the default): the light under the skin and the jade
# softens (a per-channel blur of the diffuse light, red reaching furthest),
# the ears and the leaf glow where the sun shines through.
# /Render/subsurfaceOff: eldr:subsurface off: hard diffuse, dark ears.
# /Render/subsurfaceQuality: eldr:sssQuality 4 (Karma's sssquality): more
# taps, less noise in the blur.

def Camera "cam"
{
    float focalLength = 35
    float xformOp:rotateX = -5
    double3 xformOp:translate = (0.7, 1, 7.5)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def DistantLight "sun"
{
    float inputs:intensity = 4
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-15, 245, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def DistantLight "fill"
{
    float inputs:intensity = 1
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-30, 30, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def DomeLight "sky"
{
    float inputs:intensity = 0.3
    asset inputs:texture:file = @StinsonBeach.hdr@
}

def Scope "mtl"
{
    def Material "floor"
    {
        token outputs:surface.connect = </mtl/floor/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.35, 0.35, 0.38)
            float inputs:roughness = 0.7
            token outputs:surface
        }
    }

    def Material "skin"
    {
        token outputs:mtlx:surface.connect = </mtl/skin/surface.outputs:out>

        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.8, 0.55, 0.45)
            float inputs:specular_roughness = 0.45
            float inputs:subsurface = 1
            color3f inputs:subsurface_color = (0.9, 0.6, 0.5)
            color3f inputs:subsurface_radius = (1, 0.35, 0.2)
            float inputs:subsurface_scale = 0.12
            token outputs:out
        }
    }

    def Material "jade"
    {
        token outputs:mtlx:surface.connect = </mtl/jade/surface.outputs:out>

        def Shader "surface"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            float inputs:specular_roughness = 0.2
            color3f inputs:subsurface_color = (0.35, 0.75, 0.45)
            float inputs:subsurface_radius = 0.25
            color3f inputs:subsurface_radius_scale = (0.5, 1, 0.6)
            float inputs:subsurface_weight = 1
            token outputs:out
        }
    }

    def Material "leaf"
    {
        token outputs:mtlx:surface.connect = </mtl/leaf/surface.outputs:out>

        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.25, 0.5, 0.1)
            float inputs:specular_roughness = 0.5
            float inputs:subsurface = 0.6
            color3f inputs:subsurface_color = (0.5, 0.85, 0.2)
            color3f inputs:subsurface_radius = (0.05, 0.05, 0.05)
            bool inputs:thin_walled = 1
            token outputs:out
        }
    }
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/subsurface
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "subsurface"
    {
        rel camera = </cam>
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "subsurfaceOff"
    {
        rel camera = </cam>
        custom bool eldr:subsurface = 0
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "subsurfaceQuality"
    {
        rel camera = </cam>
        custom float eldr:sssQuality = 4
        uniform int2 resolution = (960, 540)
    }
}

