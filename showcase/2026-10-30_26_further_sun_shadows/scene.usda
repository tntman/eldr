#usda 1.0
(
    renderSettingsPrimPath = "/Render/eldr_default"
    upAxis = "Y"
    metersPerUnit = 1
    subLayers = [@../../tests/scenes/volume.usda@]
)

# Shadows of further suns: tests/scenes/volume.usda (two smoke clouds, a
# ball poking out of one, a floor) lit by its own sun and StinsonBeach.hdr,
# whose sun Eldr extracts as a second distant light. Shadow maps cover one
# sun; the HDRI's sun casts traced shadows, through the smoke too.
# /Render/furtherSuns (the default): the clouds and the little smoke
# ball cast dark, sharp shadows on the floor from the HDRI's sun.
# /Render/furtherSunsOff (eldr:rtExtraSunShadows off): the HDRI's sun
# lights the floor under the clouds as if nothing were in the way.
# The orb and floor get plain materials, as in Karma's golden comparison.

def Scope "showcaseMtl"
{
    def Material "grey"
    {
        token outputs:surface.connect = </showcaseMtl/grey/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
            token outputs:surface
        }
    }

    def Material "orange"
    {
        token outputs:surface.connect = </showcaseMtl/orange/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.8, 0.2, 0.1)
            token outputs:surface
        }
    }
}

over "floor" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    rel material:binding = </showcaseMtl/grey>
}

over "orb" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    rel material:binding = </showcaseMtl/orange>
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/furtherSuns
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "furtherSuns"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }

    def RenderSettings "furtherSunsOff"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:rtExtraSunShadows = 0
    }
}
