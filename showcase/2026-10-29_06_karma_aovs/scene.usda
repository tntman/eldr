#usda 1.0
(
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [
        @./geo.usda@
    ]
)

# Karma's AOVs on the Cornell box: two light groups (the ceiling light and a
# warm lamp, tagged with Karma's LPE tag), a coated ball, a glass ball, a
# subsurface ball, a small cloud and a holdout block. See README.md.

def Camera "cam"
{
    float focalLength = 22
    double3 xformOp:translate = (0, 1, 4.4)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def RectLight "light"
{
    float inputs:height = 0.5
    float inputs:intensity = 40
    string inputs:karma:light:lpetag = "ceiling"
    float inputs:width = 0.5
    float xformOp:rotateX = -90
    double3 xformOp:translate = (0, 1.98, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def Scope "mtl"
{
    def Material "white"
    {
        token outputs:surface.connect = </mtl/white/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.73, 0.73, 0.73)
            float inputs:roughness = 1
            token outputs:surface
        }
    }

    def Material "red"
    {
        token outputs:surface.connect = </mtl/red/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.65, 0.05, 0.05)
            float inputs:roughness = 1
            token outputs:surface
        }
    }

    def Material "green"
    {
        token outputs:surface.connect = </mtl/green/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.12, 0.45, 0.15)
            float inputs:roughness = 1
            token outputs:surface
        }
    }

    def Material "chrome"
    {
        token outputs:surface.connect = </mtl/chrome/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
            float inputs:metallic = 1
            float inputs:roughness = 0.05
            token outputs:surface
        }
    }

    def Material "coat"
    {
        token outputs:mtlx:surface.connect = </mtl/coat/surface.outputs:out>

        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.05, 0.12, 0.5)
            float inputs:coat = 1
            float inputs:coat_roughness = 0.05
            float inputs:specular_roughness = 0.5
            token outputs:out
        }
    }

    def Material "glass"
    {
        token outputs:mtlx:surface.connect = </mtl/glass/surface.outputs:out>

        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:specular_roughness = 0.05
            float inputs:transmission = 1
            color3f inputs:transmission_color = (0.6, 0.95, 0.7)
            token outputs:out
        }
    }

    def Material "skin"
    {
        token outputs:mtlx:surface.connect = </mtl/skin/surface.outputs:out>

        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.8, 0.55, 0.45)
            float inputs:specular_roughness = 0.4
            float inputs:subsurface = 1
            color3f inputs:subsurface_color = (0.9, 0.6, 0.5)
            color3f inputs:subsurface_radius = (1, 0.35, 0.2)
            float inputs:subsurface_scale = 0.05
            token outputs:out
        }
    }
}

def SphereLight "lamp"
{
    color3f inputs:color = (1, 0.7, 0.45)
    float inputs:intensity = 6
    string inputs:karma:light:lpetag = "lamp"
    float inputs:radius = 0.08
    double3 xformOp:translate = (0.75, 1.5, 0.6)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/default
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (480, 480)
        rel products = [</Render/aovs>]
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (480, 480)
        rel products = [</Render/aovs>]
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (480, 480)
        rel products = [</Render/aovs>]
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "default"
    {
        rel camera = </cam>
        custom bool eldr:autoExposure = 0
        custom bool eldr:caustics = 1
        custom bool eldr:filmRestart = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        rel products = </Render/aovs>
        uniform int2 resolution = (480, 480)
    }

    def RenderSettings "noHoldouts"
    {
        rel camera = </cam>
        custom bool eldr:autoExposure = 0
        custom bool eldr:caustics = 1
        custom bool eldr:filmRestart = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:holdouts = 0
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        rel products = </Render/aovs>
        uniform int2 resolution = (480, 480)
    }

    def RenderProduct "aovs"
    {
        rel camera = </cam>
        rel orderedVars = [
            </Render/Vars/C>,
            </Render/Vars/directdiffuse>,
            </Render/Vars/indirectdiffuse>,
            </Render/Vars/directglossyreflection>,
            </Render/Vars/indirectglossyreflection>,
            </Render/Vars/glossytransmission>,
            </Render/Vars/sss>,
            </Render/Vars/coat>,
            </Render/Vars/combinedvolume>,
            </Render/Vars/combinedemission>,
            </Render/Vars/shadow>,
            </Render/Vars/holdout_shadow>,
            </Render/Vars/beauty_ceiling>,
            </Render/Vars/beauty_lamp>,
        ]
        token productName = "lightGroups.exr"
    }

    def Scope "Vars"
    {
        def RenderVar "C" (
            apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            uniform token dataType = "color4f"
            token driver:parameters:aov:husk:format = "half4"
            string driver:parameters:aov:husk:name = "C"
            uniform string sourceName = "C.*[LO]"
            uniform token sourceType = "lpe"
        }

        def RenderVar "directdiffuse" (
            apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            uniform token dataType = "color3f"
            token driver:parameters:aov:husk:format = "half3"
            string driver:parameters:aov:husk:name = "directdiffuse"
            uniform string sourceName = "C<RD>L"
            uniform token sourceType = "lpe"
        }

        def RenderVar "indirectdiffuse" (
            apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            uniform token dataType = "color3f"
            token driver:parameters:aov:husk:format = "half3"
            string driver:parameters:aov:husk:name = "indirectdiffuse"
            uniform string sourceName = "C<RD>.+L"
            uniform token sourceType = "lpe"
        }

        def RenderVar "directglossyreflection" (
            apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            uniform token dataType = "color3f"
            token driver:parameters:aov:husk:format = "half3"
            string driver:parameters:aov:husk:name = "directglossyreflection"
            uniform string sourceName = "C<RG>L"
            uniform token sourceType = "lpe"
        }

        def RenderVar "indirectglossyreflection" (
            apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            uniform token dataType = "color3f"
            token driver:parameters:aov:husk:format = "half3"
            string driver:parameters:aov:husk:name = "indirectglossyreflection"
            uniform string sourceName = "C<RG>.+L"
            uniform token sourceType = "lpe"
        }

        def RenderVar "glossytransmission" (
            apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            uniform token dataType = "color3f"
            token driver:parameters:aov:husk:format = "half3"
            string driver:parameters:aov:husk:name = "glossytransmission"
            uniform string sourceName = "C<TG>.*L"
            uniform token sourceType = "lpe"
        }

        def RenderVar "sss" (
            apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            uniform token dataType = "color3f"
            token driver:parameters:aov:husk:format = "half3"
            string driver:parameters:aov:husk:name = "sss"
            uniform string sourceName = "C<TD>.*L"
            uniform token sourceType = "lpe"
        }

        def RenderVar "coat" (
            apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            uniform token dataType = "color3f"
            token driver:parameters:aov:husk:format = "half3"
            string driver:parameters:aov:husk:name = "coat"
            uniform string sourceName = "C<...'coat'>.*L"
            uniform token sourceType = "lpe"
        }

        def RenderVar "combinedvolume" (
            apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            uniform token dataType = "color3f"
            token driver:parameters:aov:husk:format = "half3"
            string driver:parameters:aov:husk:name = "combinedvolume"
            uniform string sourceName = "CV.*L"
            uniform token sourceType = "lpe"
        }

        def RenderVar "combinedemission" (
            apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            uniform token dataType = "color3f"
            token driver:parameters:aov:husk:format = "half3"
            string driver:parameters:aov:husk:name = "combinedemission"
            uniform string sourceName = "C.*O"
            uniform token sourceType = "lpe"
        }

        def RenderVar "shadow" (
            apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            uniform token dataType = "color3f"
            token driver:parameters:aov:husk:format = "half3"
            string driver:parameters:aov:husk:name = "shadow"
            uniform string sourceName = "shadow;C.*[LO]"
            uniform token sourceType = "lpe"
        }

        def RenderVar "holdout_shadow" (
            apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            uniform token dataType = "color3f"
            token driver:parameters:aov:husk:format = "half3"
            string driver:parameters:aov:husk:name = "holdout_shadow"
            uniform string sourceName = "holdouts;shadow;CDL"
            uniform token sourceType = "lpe"
        }

        def RenderVar "beauty_ceiling" (
            apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            uniform token dataType = "color3f"
            token driver:parameters:aov:husk:format = "half3"
            string driver:parameters:aov:husk:name = "beauty_ceiling"
            uniform string sourceName = "C.*<L.'ceiling'>"
            uniform token sourceType = "lpe"
        }

        def RenderVar "beauty_lamp" (
            apiSchemas = ["HuskRenderVarAPI"]
        )
        {
            uniform token dataType = "color3f"
            token driver:parameters:aov:husk:format = "half3"
            string driver:parameters:aov:husk:name = "beauty_lamp"
            uniform string sourceName = "C.*<L.'lamp'>"
            uniform token sourceType = "lpe"
        }
    }
}

