#usda 1.0
(
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [
        @./geo.usda@
    ]
    upAxis = "Y"
)

# Shadow modes: tests/scenes/sunangle.usda (a 4 degree sun over two posts,
# a beam and a ball) plus a sphere light of radius 0.3 low on the right, so
# both the sun's cascades and the local light atlas show. Look at the
# contact hardening: sharp where the posts meet the ground, soft under the
# beam, and the sphere light's soft shadow of the ball.
# /Render/maps (the default): shadow maps, cascades for the sun and an atlas
# tile set for the sphere light, soft from the light's size (PCSS), exact
# penumbrae from jittered maps under the film (eldr:shadowJitter).
# /Render/pcss: the same maps without the film's jitter (PCSS only).
# /Render/hard: eldr:softShadows and eldr:softSunShadows off: 3x3 PCF,
# hard edges everywhere.
# /Render/traced: ray-traced shadows (eldr:rtShadows), soft from light size.

def Camera "cam"
{
    float focalLength = 24
    float xformOp:rotateX = -22
    double3 xformOp:translate = (0, 5, 12)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def DistantLight "sun"
{
    float inputs:angle = 4
    float inputs:intensity = 3
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-55, 30, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def DomeLight "sky"
{
    color3f inputs:color = (0.5, 0.65, 1)
    float inputs:intensity = 0.3
}

def SphereLight "lamp"
{
    color3f inputs:color = (1, 0.8, 0.6)
    float inputs:intensity = 40
    float inputs:radius = 0.3
    double3 xformOp:translate = (4, 1.5, 3)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/maps
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[[\"denoise\", {\"engine\": \"oidn\", \"use_albedo_input\": true, \"use_n_input\": true, \"forcecpu\": false, \"aovs\": [\"C\"]}]]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "maps"
    {
        rel camera = </cam>
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "pcss"
    {
        rel camera = </cam>
        custom bool eldr:shadowJitter = 0
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "hard"
    {
        rel camera = </cam>
        custom bool eldr:shadowJitter = 0
        custom bool eldr:softShadows = 0
        custom bool eldr:softSunShadows = 0
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "traced"
    {
        rel camera = </cam>
        custom bool eldr:rtShadows = 1
        uniform int2 resolution = (960, 540)
    }
}

