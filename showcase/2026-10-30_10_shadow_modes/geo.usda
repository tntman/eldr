#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Y"
)

def Mesh "ground"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-10, 0, -10), (-10, 0, 10), (10, 0, 10), (10, 0, -10)]
    color3f[] primvars:displayColor = [(0.7, 0.7, 0.7)]
}

def Cube "postLeft"
{
    double size = 1
    float3 xformOp:scale = (0.25, 4, 0.25)
    double3 xformOp:translate = (-2.5, 2, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}

def Cube "postRight"
{
    double size = 1
    float3 xformOp:scale = (0.25, 4, 0.25)
    double3 xformOp:translate = (2.5, 2, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}

def Cube "beam"
{
    double size = 1
    float3 xformOp:scale = (5.5, 0.2, 0.4)
    double3 xformOp:translate = (0, 4.1, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}

def Sphere "ball"
{
    double radius = 0.6
    double3 xformOp:translate = (0, 0.6, 2)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

