#usda 1.0
(
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [
        @./geo.usda@
    ]
    upAxis = "Y"
)

# Instancing: a PointInstancer of 12 x 12 "trees" whose prototype holds a
# trunk and a second, nested PointInstancer of three leaf balls, with
# per-instance scales and orientations; on the left, three native USD
# instances (instanceable references of one "rock" prim). Each prototype
# draws once (one indirect draw per prototype) however many times it
# appears; culling runs per instance on the GPU.
# /Render/instances (the default): all 144 trees and their 432 leaf balls,
# small far ones included (eldr:cullPixels 0.5).
# /Render/cullSmall: eldr:cullPixels 30: instances under 30 pixels on
# screen are skipped: the far rows thin out.

def Camera "cam"
{
    float focalLength = 24
    float xformOp:rotateX = -12
    double3 xformOp:translate = (0, 4, 12)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def DistantLight "sun"
{
    float inputs:intensity = 3
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-45, 35, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def DomeLight "sky"
{
    color3f inputs:color = (0.55, 0.65, 0.9)
    float inputs:intensity = 0.4
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/instances
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[[\"denoise\", {\"engine\": \"oidn\", \"use_albedo_input\": true, \"use_n_input\": true, \"forcecpu\": false, \"aovs\": [\"C\"]}]]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "instances"
    {
        rel camera = </cam>
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "cullSmall"
    {
        rel camera = </cam>
        custom float eldr:cullPixels = 30
        uniform int2 resolution = (960, 540)
    }
}

