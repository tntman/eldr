#usda 1.0
(
    renderSettingsPrimPath = "/Render/eldr_default"
    upAxis = "Y"
    metersPerUnit = 1
)

# Instancing: a PointInstancer of 12 x 12 "trees" whose prototype holds a
# trunk and a second, nested PointInstancer of three leaf balls, with
# per-instance scales and orientations; on the left, three native USD
# instances (instanceable references of one "rock" prim). Each prototype
# draws once (one indirect draw per prototype) however many times it
# appears; culling runs per instance on the GPU.
# /Render/instances (the default): all 144 trees and their 432 leaf balls,
# small far ones included (eldr:cullPixels 0.5).
# /Render/cullSmall: eldr:cullPixels 30: instances under 30 pixels on
# screen are skipped: the far rows thin out.

def Camera "cam"
{
    float focalLength = 24
    double3 xformOp:translate = (0, 4, 12)
    float xformOp:rotateX = -12
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def DistantLight "sun"
{
    float inputs:intensity = 3
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-45, 35, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def DomeLight "sky"
{
    color3f inputs:color = (0.55, 0.65, 0.9)
    float inputs:intensity = 0.4
}

def Mesh "ground"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-40, 0, -80), (-40, 0, 20), (40, 0, 20), (40, 0, -80)]
    color3f[] primvars:displayColor = [(0.35, 0.4, 0.3)]
}

