    metersPerUnit = 1
    upAxis = "Y"
)

over "Flattened_Prototype_2"
{
    def Cube "rock"
    {
        color3f[] primvars:displayColor = [(0.55, 0.5, 0.45)]
        double size = 1
        float3 xformOp:rotateXYZ = (20, 35, 10)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
}

