class Xform "rockSource"
{
    def Cube "rock"
    {
        color3f[] primvars:displayColor = [(0.55, 0.5, 0.45)]
        double size = 1
        float3 xformOp:rotateXYZ = (20, 35, 10)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
}

def Xform "rocks"
{
    def Xform "rockA" (
        instanceable = true
        add references = </Flattened_Prototype_2>
    )
    {
        double3 xformOp:translate = (-4, 0.4, 7)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "rockB" (
        instanceable = true
        add references = </Flattened_Prototype_2>
    )
    {
        float3 xformOp:scale = (1.3, 1.3, 1.3)
        double3 xformOp:translate = (-2.5, 0.5, 6.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "rockC" (
        instanceable = true
        add references = </Flattened_Prototype_2>
    )
    {
        float3 xformOp:scale = (0.6, 0.6, 0.6)
        double3 xformOp:translate = (-3.3, 0.3, 5.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

