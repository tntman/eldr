#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
    subLayers = [@../../tests/scenes/emissive.usda@]
    renderSettingsPrimPath = "/Render/eldr_default"
)

# Lane 40, Karma's colour limit. The Cornell box lit only by an emissive
# panel (40) and a warm bulb (60, 30, 8). "limit20": Karma's default limit of
# 20, as Karma renders it: the panel shows as 20, the bulb as (20, 10, 2.7),
# and their light on the walls is clamped as Karma's bounce samples are.
# "fullHdr": no limit on what the camera sees (the emitters keep 40 and 60),
# the bounce clamp kept at 20. "off": no limit at all.

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/limit20
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "limit20"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:gi = 1
    }
    def RenderSettings "fullHdr"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:gi = 1
        custom float eldr:colorLimit = 0
        custom float eldr:indirectClamp = 20
    }
    def RenderSettings "off"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:gi = 1
        custom float eldr:colorLimit = 0
    }
    def RenderSettings "karmaName5"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:gi = 1
        custom float karma:global:colorlimit = 5
    }
}
