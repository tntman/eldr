#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/graphsOn"
)

# Lane 38, MaterialX coverage. Top row: compositing nodes of a left-right
# ramp (fg, orange to blue) over a bottom-top ramp (bg, dark to light),
# unlit: plus, minus, difference, burn, dodge, screen, overlay, over
# (color4). Middle row: glTF PBR gold, glTF coat + sheen, glTF blend alpha,
# Disney plastic, Disney coated metal, surface_unlit. Bottom row, Karma's
# VEX nodes in the kma context: Ramp Const (bspline colours along u), Ramp
# Const (monotone cubic, constant, linear along u), hex tiling of the
# quadrants texture, Voronoi F1 (unlit), Voronoi flakes as a bump under a
# coat.

def Camera "cam"
{
    float focalLength = 30
    float horizontalAperture = 36
    float verticalAperture = 18
    double3 xformOp:translate = (0, 0, 20)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def DistantLight "sun"
{
    float inputs:intensity = 2.5
    float inputs:angle = 2
    double3 xformOp:rotateXYZ = (-35, 30, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def DomeLight "sky"
{
    color3f inputs:color = (0.45, 0.5, 0.6)
    float inputs:intensity = 0.6
}

class Mesh "_quad"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
    texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (interpolation = "vertex")
    uniform token subdivisionScheme = "none"
}

def Scope "mtl"
{
    def Material "plus"
    {
        token outputs:mtlx:surface.connect = </mtl/plus/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/plus/blend.outputs:out>
            token outputs:out
        }
        def Shader "fg"
        {
            uniform token info:id = "ND_ramplr_color3"
            color3f inputs:valuel = (1, 0.5, 0.1)
            color3f inputs:valuer = (0.1, 0.3, 1)
            color3f outputs:out
        }
        def Shader "bg"
        {
            uniform token info:id = "ND_ramptb_color3"
            color3f inputs:valueb = (0.1, 0.1, 0.1)
            color3f inputs:valuet = (0.9, 0.9, 0.9)
            color3f outputs:out
        }
        def Shader "blend"
        {
            uniform token info:id = "ND_plus_color3"
            color3f inputs:fg.connect = </mtl/plus/fg.outputs:out>
            color3f inputs:bg.connect = </mtl/plus/bg.outputs:out>
            float inputs:mix = 1
            color3f outputs:out
        }
    }

    def Material "minus"
    {
        token outputs:mtlx:surface.connect = </mtl/minus/surface.outputs:out>
