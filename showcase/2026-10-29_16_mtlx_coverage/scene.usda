    def Material "rampconst"
    {
        token outputs:kma:surface.connect = </mtl/rampconst/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/rampconst/ramp.outputs:out>
            token outputs:out
        }
        def Shader "uv"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "u"
        {
            uniform token info:id = "ND_extract_vector2"
            float2 inputs:in.connect = </mtl/rampconst/uv.outputs:out>
            int inputs:index = 0
            float outputs:out
        }
        def Shader "ramp"
        {
            uniform token info:id = "kma_rampconst_color"
            float inputs:t.connect = </mtl/rampconst/u.outputs:out>
            int inputs:vramp = 5
            float[] inputs:vkeys = [0, 0.25, 0.5, 0.75, 1]
            color3f[] inputs:vvalues = [(0.05, 0.05, 0.3), (0.9, 0.2, 0.1), (1, 0.9, 0.2), (0.2, 0.8, 0.3), (0.9, 0.9, 0.9)]
            token[] inputs:vbasis = ["bspline", "bspline", "bspline", "bspline", "bspline"]
            color3f outputs:out
        }
    }

    def Material "rampsteps"
    {
        token outputs:kma:surface.connect = </mtl/rampsteps/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/rampsteps/ramp.outputs:out>
            token outputs:out
        }
        def Shader "uv"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "u"
        {
            uniform token info:id = "ND_extract_vector2"
            float2 inputs:in.connect = </mtl/rampsteps/uv.outputs:out>
            int inputs:index = 0
            float outputs:out
        }
        def Shader "ramp"
        {
            uniform token info:id = "kma_rampconst_float"
            float inputs:t.connect = </mtl/rampsteps/u.outputs:out>
            int inputs:framp = 3
            float[] inputs:fkeys = [0.2, 0.5, 0.8]
            float[] inputs:fvalues = [0, 1, 0.3]
            token[] inputs:fbasis = ["monotonecubic", "constant", "linear"]
            float outputs:out
        }
        def Shader "grey"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </mtl/rampsteps/ramp.outputs:out>
            color3f outputs:out
        }
    }

    def Material "hextiling"
    {
        token outputs:kma:surface.connect = </mtl/hextiling/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/hextiling/rgb.outputs:out>
            token outputs:out
        }
        def Shader "hex"
        {
            uniform token info:id = "kma_color_hextiling"
            asset inputs:file = @../../tests/scenes/textures/quadrants.png@
            float inputs:size = 0.35
            float inputs:contrast = 0.725
            float4 outputs:out
        }
        def Shader "rgb"
        {
            uniform token info:id = "ND_convert_color4_color3"
            color4f inputs:in.connect = </mtl/hextiling/hex.outputs:out>
            color3f outputs:out
        }
    }

    def Material "voronoi"
    {
        token outputs:kma:surface.connect = </mtl/voronoi/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/voronoi/grey.outputs:out>
            token outputs:out
        }
        def Shader "v"
        {
            uniform token info:id = "kma_voronoinoise3d_float"
            vector3f inputs:freq = (4, 4, 4)
            int inputs:metric = 0
            float outputs:distance
        }
        def Shader "grey"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </mtl/voronoi/v.outputs:distance>
            color3f outputs:out
        }
    }

    def Material "flakes"
    {
        token outputs:kma:surface.connect = </mtl/flakes/surface.outputs:out>
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.5, 0.02, 0.02)
            float inputs:metalness = 0.6
            float inputs:specular_roughness = 0.25
            float inputs:coat = 1
            vector3f inputs:normal.connect = </mtl/flakes/bump.outputs:out>
            token outputs:out
        }
        def Shader "v"
        {
            uniform token info:id = "kma_voronoinoise3d_float"
            vector3f inputs:freq = (60, 60, 60)
            int inputs:metric = 1
            float outputs:distance
        }
        def Shader "bump"
        {
            uniform token info:id = "ND_bump_vector3"
            float inputs:height.connect = </mtl/flakes/v.outputs:distance>
            float inputs:scale = 0.004
            vector3f outputs:out
        }
    }
}

def Mesh "c_plus" (prepend apiSchemas = ["MaterialBindingAPI"]
