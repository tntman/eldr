#usda 1.0
(
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [
        @./geo.usda@
    ]
    upAxis = "Y"
)

# Many lights: 200 small coloured sphere lights (seeded random hues) hang
# just above a glossy floor around a ball, a box and a post, under a faint
# night dome. Clustered shading (up to 255 lights per cluster, cut off at 1% of
# mid-gray) lights each pixel with the lights that reach it.
# /Render/lights (the default): clustered. /Render/clustersOff: every light
# for every pixel, the same picture. /Render/localLightsOff: no
# local lights at all, only the night dome.

over "lights200"
{
    def SphereLight "l000"
    {
        color3f inputs:color = (0.374, 0.3, 1)
        float inputs:intensity = 60
        float inputs:radius = 0.04
        double3 xformOp:translate = (-5.7, 0.37, -3.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

