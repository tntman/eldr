def Camera "cam"
{
    float focalLength = 24
    float xformOp:rotateX = -22
    double3 xformOp:translate = (0, 4, 10)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def DomeLight "night"
{
    color3f inputs:color = (0.2, 0.3, 0.6)
    float inputs:intensity = 0.03
}

def Scope "mtl"
{
    def Material "matte"
    {
        token outputs:surface.connect = </mtl/matte/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
            float inputs:roughness = 0.7
            token outputs:surface
        }
    }

    def Material "glossy"
    {
        token outputs:surface.connect = </mtl/glossy/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.3, 0.3, 0.3)
            float inputs:roughness = 0.3
            token outputs:surface
        }
    }
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/lights
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[[\"denoise\", {\"engine\": \"oidn\", \"use_albedo_input\": true, \"use_n_input\": true, \"forcecpu\": false, \"aovs\": [\"C\"]}]]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "lights"
    {
        rel camera = </cam>
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "clustersOff"
    {
        rel camera = </cam>
        custom bool eldr:clusteredLights = 0
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "localLightsOff"
    {
        rel camera = </cam>
        custom bool eldr:localLights = 0
        uniform int2 resolution = (960, 540)
    }
}

