#usda 1.0
(
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [
        @./geo.usda@
    ]
    upAxis = "Y"
)

# Curves and points beyond showcase 2026-10-28_06: every basis of
# tests/scenes/curves.usda (polyline, periodic square, ribbon with normals,
# bspline, catmullRom, pinned bspline, bezier, periodic loop, points with
# vertex widths) plus a patch of 600 hair curves (bottom left, no material:
# Kajiya-Kay hair shading). The camera is pulled back to fit the patch.
# /Render/curves (the default): 6-sided tubes and icosahedron points.
# /Render/ribbons: camera-facing ribbons (eldr:curveRibbons).
# /Render/sprites: points as camera-facing discs (eldr:pointSprites).
# /Render/hairOff: the fur shaded as plain diffuse tubes (eldr:hairShading).

def Camera "cam"
{
    float focalLength = 24
    double3 xformOp:translate = (-0.5, -0.5, 22)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def DistantLight "sun"
{
    float inputs:intensity = 3
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-30, 25, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def DomeLight "sky"
{
    color3f inputs:color = (0.6, 0.7, 0.9)
    float inputs:intensity = 0.3
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/curves
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[[\"denoise\", {\"engine\": \"oidn\", \"use_albedo_input\": true, \"use_n_input\": true, \"forcecpu\": false, \"aovs\": [\"C\"]}]]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "curves"
    {
        rel camera = </cam>
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "ribbons"
    {
        rel camera = </cam>
        custom bool eldr:curveRibbons = 1
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "sprites"
    {
        rel camera = </cam>
        custom bool eldr:pointSprites = 1
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "hairOff"
    {
        rel camera = </cam>
        custom bool eldr:hairShading = 0
        uniform int2 resolution = (960, 540)
    }
}

