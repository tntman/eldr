#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
    subLayers = [@../../tests/scenes/curves.usda@]
)

# Curves and points beyond showcase 2026-10-28_06: every basis of
# tests/scenes/curves.usda (polyline, periodic square, ribbon with normals,
# bspline, catmullRom, pinned bspline, bezier, periodic loop, points with
# vertex widths) plus a patch of 600 hair curves (bottom left, no material:
# Kajiya-Kay hair shading). The camera is pulled back to fit the patch.
# /Render/curves (the default): 6-sided tubes and icosahedron points.
# /Render/ribbons: camera-facing ribbons (eldr:curveRibbons).
# /Render/sprites: points as camera-facing discs (eldr:pointSprites).
# /Render/hairOff: the fur shaded as plain diffuse tubes (eldr:hairShading).

over "cam"
{
    double3 xformOp:translate = (-0.5, -0.5, 22)
}

def DomeLight "sky"
{
    color3f inputs:color = (0.6, 0.7, 0.9)
    float inputs:intensity = 0.3
}

def Xform "furPatch"
{
    double3 xformOp:translate = (-7.4, -4.6, 0)
    float xformOp:rotateX = 35
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]

