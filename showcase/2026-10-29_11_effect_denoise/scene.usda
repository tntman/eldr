#usda 1.0
(
    subLayers = [@../../tests/scenes/emissive.usda@]
)

# Per-effect denoise on the ray-traced recipe (GI final gather, traced shadows
# and reflections) at 4, 16 and 64 film samples, raw against denoised.

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 4
    }
    # --- end standard settings ---
    def RenderSettings "raw4"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom int eldr:filmSamples = 4
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:rtShadows = 1
        custom bool eldr:rtReflections = 1
        custom float eldr:finalGatherDenoise = 0.0
        custom bool eldr:rtShadowDenoise = 0
        custom bool eldr:rtReflectionDenoise = 0
    }

    def RenderSettings "denoise4"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom int eldr:filmSamples = 4
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:rtShadows = 1
        custom bool eldr:rtReflections = 1
        custom float eldr:finalGatherDenoise = 1.0
        custom bool eldr:rtShadowDenoise = 1
        custom bool eldr:rtReflectionDenoise = 1
    }

    def RenderSettings "raw16"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom int eldr:filmSamples = 16
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:rtShadows = 1
        custom bool eldr:rtReflections = 1
        custom float eldr:finalGatherDenoise = 0.0
        custom bool eldr:rtShadowDenoise = 0
        custom bool eldr:rtReflectionDenoise = 0
    }

    def RenderSettings "denoise16"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom int eldr:filmSamples = 16
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:rtShadows = 1
        custom bool eldr:rtReflections = 1
        custom float eldr:finalGatherDenoise = 1.0
        custom bool eldr:rtShadowDenoise = 1
        custom bool eldr:rtReflectionDenoise = 1
    }

    def RenderSettings "raw64"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom int eldr:filmSamples = 64
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:rtShadows = 1
        custom bool eldr:rtReflections = 1
        custom float eldr:finalGatherDenoise = 0.0
        custom bool eldr:rtShadowDenoise = 0
        custom bool eldr:rtReflectionDenoise = 0
    }

    def RenderSettings "denoise64"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom int eldr:filmSamples = 64
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:rtShadows = 1
        custom bool eldr:rtReflections = 1
        custom float eldr:finalGatherDenoise = 1.0
        custom bool eldr:rtShadowDenoise = 1
        custom bool eldr:rtReflectionDenoise = 1
    }

    def RenderSettings "noFade64"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom int eldr:filmSamples = 64
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:rtShadows = 1
        custom bool eldr:rtReflections = 1
        custom float eldr:finalGatherDenoise = 1.0
        custom bool eldr:rtShadowDenoise = 1
        custom bool eldr:rtReflectionDenoise = 1
        custom int eldr:effectDenoiseSamples = 0
    }
}
