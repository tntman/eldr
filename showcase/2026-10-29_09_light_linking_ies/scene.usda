#usda 1.0
(
    renderSettingsPrimPath = "/Render/default"
    subLayers = [@../../tests/scenes/lightlink.usda@]
)

# Light linking and an IES spot on tests/scenes/lightlink.usda: the key light
# skips the right ball, the fill light's shadows skip the left ball, and a
# third light shines an asymmetric IES profile down between the balls. See
# README.md.

def SphereLight "iesSpot" (
    prepend apiSchemas = ["ShapingAPI"]
)
{
    color3f inputs:color = (1, 0.8, 0.55)
    float inputs:intensity = 30
    float inputs:radius = 0.05
    asset inputs:shaping:ies:file = @../../tests/scenes/textures/spot_asym.ies@
    double3 xformOp:translate = (1.1, 3, 1.5)
    float xformOp:rotateX = -90
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def Scope "Render"
{
    def RenderSettings "default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:finalQuality = 1
    }

    def RenderSettings "noLinking"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:finalQuality = 1
        custom bool eldr:lightLinking = 0
    }

    def RenderSettings "noIes"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:finalQuality = 1
        custom bool eldr:lightIes = 0
    }

    def RenderSettings "traced"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:finalQuality = 1
        custom bool eldr:rtShadows = 1
    }
}
