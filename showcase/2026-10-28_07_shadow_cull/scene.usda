#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
)

def Camera "cam"
{
    float focalLength = 30
    float2 clippingRange = (0.1, 2000)
    double3 xformOp:translate = (0, 25, 40)
    float xformOp:rotateX = -18
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def DistantLight "sun"
{
    float inputs:intensity = 3
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-25, 35, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def DomeLight "sky"
{
    float inputs:intensity = 0.3
}

def Scope "mtl"
{
    def Material "m"
    {
        token outputs:surface.connect = </mtl/m/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
            token outputs:surface
        }
    }
}

def Mesh "ground" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-300, 0, 100), (300, 0, 100), (300, 0, -400), (-300, 0, -400)]
    rel material:binding = </mtl/m>
}

