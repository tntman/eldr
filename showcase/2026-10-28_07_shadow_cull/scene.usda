    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom float eldr:shadowCullPixels = 8.0
    }

    def RenderSettings "cullOff"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom float eldr:shadowCullPixels = 0.0
    }
}
