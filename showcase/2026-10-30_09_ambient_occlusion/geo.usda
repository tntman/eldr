#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Y"
)

def Mesh "floor" (
    apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    rel material:binding = </mtl/white>
    point3f[] points = [(-3, 0, -3), (-3, 0, 4), (5, 0, 4), (5, 0, -3)]
}

def Mesh "backWall" (
    apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    rel material:binding = </mtl/white>
    point3f[] points = [(-3, 0, -3), (5, 0, -3), (5, 4, -3), (-3, 4, -3)]
}

def Mesh "sideWall" (
    apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    rel material:binding = </mtl/white>
    point3f[] points = [(-3, 0, -3), (-3, 4, -3), (-3, 4, 4), (-3, 0, 4)]
}

def Cube "boxLow" (
    apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </mtl/white>
    double size = 1.2
    double3 xformOp:translate = (-1.8, 0.6, -1.8)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Cube "boxHigh" (
    apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </mtl/white>
    double size = 0.8
    float xformOp:rotateY = 25
    double3 xformOp:translate = (-1.9, 1.6, -1.9)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY"]
}

def Cube "boxSide" (
    apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </mtl/white>
    double size = 0.7
    float xformOp:rotateY = 10
    double3 xformOp:translate = (-0.75, 0.35, -2.3)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY"]
}

def Sphere "ball" (
    apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </mtl/white>
    double radius = 0.6
    double3 xformOp:translate = (1.2, 0.6, -2.3)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

