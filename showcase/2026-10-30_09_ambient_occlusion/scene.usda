#usda 1.0
(
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [
        @./geo.usda@
    ]
    upAxis = "Y"
)

# Ambient light: a corner (floor and two walls), stacked boxes and a ball
# against the wall, lit only by a plain white dome (no texture, so no sun
# to extract). The dome's light is unoccluded sky light darkened by GTAO
# (screen-space ambient occlusion over eldr:aoRadius).
# /Render/ambient (the default): AO darkens the corner, the gaps between
# the boxes and under the ball. /Render/aoOff: flat sky light everywhere
# (eldr:ambientOcclusion off). /Render/aoWide: eldr:aoRadius 2 instead of
# 0.5: wider, softer darkening.

def Camera "cam"
{
    float focalLength = 28
    float3 xformOp:rotateXYZ = (-14, 18, 0)
    double3 xformOp:translate = (2.5, 2.2, 6.5)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}

def DomeLight "sky"
{
    color3f inputs:color = (1, 1, 1)
    float inputs:intensity = 0.5
}

def Scope "mtl"
{
    def Material "white"
    {
        token outputs:surface.connect = </mtl/white/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.75, 0.75, 0.75)
            float inputs:roughness = 0.9
            token outputs:surface
        }
    }
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/ambient
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "ambient"
    {
        rel camera = </cam>
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "aoOff"
    {
        rel camera = </cam>
        custom bool eldr:ambientOcclusion = 0
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "aoWide"
    {
        rel camera = </cam>
        custom float eldr:aoRadius = 2
        uniform int2 resolution = (960, 540)
    }
}

