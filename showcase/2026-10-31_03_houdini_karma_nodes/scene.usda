                        double3 default_value = (0.8, 0.8, 0.8)
                        string ogl_diff = "1"
                    }
                }
            )
            color3f inputs:base_color.connect = </Materials/PlasticRed/mtlxmix3.outputs:out>
            float inputs:coat (
                customData = {
                    dictionary HoudiniPreviewTags = {
