#usda 1.0
(
    renderSettingsPrimPath = "/Render/eldr_default"
    upAxis = "Y"
    metersPerUnit = 1
)
# Houdini 22's basic materials that use Karma's own nodes, on spheres:
# Plastic (kma_color_hextiling), SilkSurfaceGreen and Marble
# (kma_rampconst), CarPaintMetallic (kma_voronoinoise3d flakes as a bump),
# and AppleJuice (absorption over transmission_depth through the ball).
# /Render/graphsOn (the default) vs /Render/graphsOff
# (eldr:materialGraphs off: the graph-driven inputs keep their constants).
# The materials come from Houdini's install ($HFS/houdini/usd/materials).
def Camera "cam"
{
    float focalLength = 35
    float horizontalAperture = 36
    float verticalAperture = 20.25
    double3 xformOp:translate = (0, 0, 12)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def DomeLight "sky"
{
    float inputs:intensity = 0.5
}

def DistantLight "sun"
{
    float inputs:angle = 1
    float inputs:intensity = 2
    float3 xformOp:rotateXYZ = (-35, -30, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def Scope "Materials" (
    prepend references = @C:/Program Files/Side Effects Software/Houdini 22.0.466/houdini/usd/materials/basic_materials/basic_materials.usd@</Materials>
)
{
}

def Sphere "plastic" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    rel material:binding = </Materials/Plastic>
    double3 xformOp:translate = (-4.4, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "silk" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    rel material:binding = </Materials/SilkSurfaceGreen>
    double3 xformOp:translate = (-2.2, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "marble" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    rel material:binding = </Materials/Marble>
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "carPaint" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    rel material:binding = </Materials/CarPaintMetallic>
    double3 xformOp:translate = (2.2, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "appleJuice" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    rel material:binding = </Materials/AppleJuice>
    double3 xformOp:translate = (4.4, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/graphsOn
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }

    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }

    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---

    def RenderSettings "graphsOn"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }

    def RenderSettings "graphsOff"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:materialGraphs = 0
    }
}
