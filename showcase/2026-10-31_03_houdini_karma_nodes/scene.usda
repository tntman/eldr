    def Material "Plastic" (
        apiSchemas = ["MaterialXConfigAPI"]
        customData = {
            string HoudiniCatalogParentPath = "Plastics"
            dictionary houdini = {
                string dialogScript = '''{
    name    usdmaterial

    groupcollapsible {
        name    "folder1"
        label   "MaterialX Subnet"

        parm {
            name    "inherit_ctrl"
            label   "Inherit from Class"
            type    integer
            default { "2" }
            menu {
                "0" "Never"
                "1" "Always"
                "2" "Material Flag"
            }
            range   { 0 10 }
        }
        parm {
            name    "separator1"
            label   "separator1"
            type    separator
            default { "" }
        }
        parm {
            name    "tabmenumask"
            label   "Tab Menu Mask"
            type    string
            default { "MaterialX parameter collect subnet null subnetconnector" }
            parmtag { "spare_category" "Tab Menu" }
        }
    }


}'''
            }
        }
    )
    {
        string config:mtlx:version = "1.39"
        color3f inputs:color = (1, 1, 1) (
            displayName = "Color"
        )
        float inputs:folder1 = 1
        color3f inputs:label_color = (1, 1, 1) (
            displayName = "Label Color"
        )
        asset inputs:label_map = @@ (
            displayName = "Label Map"
        )
        float inputs:roughness = 0.125
        asset inputs:scratches_map = @@ (
            displayName = "Scratches Map"
        )
        float inputs:scratches_size = 1 (
            displayName = "Scratches Size"
        )
        float inputs:subsurface = 0.625 (
            displayName = "Subsurface Scattering"
        )
        float inputs:subsurface_scale = 0.00825 (
            displayName = "Subsurface Scale"
        )
        string inputs:tabmenumask = "karma USD ^mtlxramp* ^hmtlxramp* ^hmtlxcubicramp* MaterialX parameter constant collect null genericshader subnet subnetconnector suboutput subinput"
