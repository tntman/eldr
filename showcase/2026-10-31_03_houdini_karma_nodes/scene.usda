    def Material "Water" (
        apiSchemas = ["MaterialXConfigAPI"]
        customData = {
            string HoudiniCatalogParentPath = "Liquids"
        }
    )
    {
        string config:mtlx:version = "1.39"
        color3f inputs:color = (1, 1, 1) (
            displayName = "Color"
        )
        float inputs:depth = 0 (
            displayName = "Depth"
        )
        float inputs:IOR = 1.34 (
            displayName = "IOR"
        )
        token outputs:kma:displacement.connect = </Materials/Water/mtlxdisplacement.outputs:out>
        token outputs:kma:surface.connect = </Materials/Water/mtlxstandard_surface.outputs:out>
        token outputs:surface.connect = </Materials/Water/mtlxstandard_preview.outputs:surface>

        def Shader "mtlxstandard_surface" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1
                        string ogl_diff_intensity = "1"
                    }
                }
            )
            color3f inputs:base_color (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (0.8, 0.8, 0.8)
                        string ogl_diff = "1"
                    }
                }
            )
            float inputs:coat (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_coat_intensity = "1"
                    }
                }
            )
            float inputs:coat_roughness (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0.1
                        string ogl_coat_rough = "1"
                    }
                }
            )
            float inputs:emission (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_emit_intensity = "1"
                    }
                }
            )
            color3f inputs:emission_color (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (1, 1, 1)
                        string ogl_emit = "1"
                    }
                }
            )
            float inputs:metalness (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_metallic = "1"
                    }
                }
            )
            float inputs:specular (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1
                        string ogl_spec_intensity = "1"
                    }
                }
            )
            color3f inputs:specular_color (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (1, 1, 1)
                        string ogl_spec = "1"
                    }
                }
            )
            float inputs:specular_IOR = 1.34 (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1.5
                        string ogl_ior = "1"
                    }
                }
            )
            float inputs:specular_IOR.connect = </Materials/Water.inputs:IOR>
            float inputs:specular_roughness = 0 (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0.2
                        string ogl_rough = "1"
                    }
                }
            )
            float inputs:transmission = 1 (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_transparency = "1"
                    }
                }
            )
            color3f inputs:transmission_color.connect = </Materials/Water.inputs:color>
            float inputs:transmission_depth.connect = </Materials/Water.inputs:depth>
            token outputs:out
            uniform float2 ui:nodegraph:node:pos = (-5.50658, 4.41969)
        }

        def Shader "mtlxdisplacement" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_displacement_float"
            token outputs:out
            uniform float2 ui:nodegraph:node:pos = (-0.2883, -2.4334)
        }

        def Shader "mtlxstandard_preview" (
            customData = {
                bool HoudiniIsAutoCreatedShader = 1
            }
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoatRoughness = 0.1
            color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
            color3f inputs:diffuseColor.connect = </Materials/Water.inputs:color>
            float inputs:ior = 1.34
            float inputs:ior.connect = </Materials/Water.inputs:IOR>
            float inputs:opacity = 0.15
            float inputs:roughness = 0
            color3f inputs:specularColor = (1, 1, 1)
            token outputs:surface
        }
    }
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/graphsOn
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[[\"denoise\", {\"engine\": \"oidn\", \"use_albedo_input\": true, \"use_n_input\": true, \"forcecpu\": false, \"aovs\": [\"C\"]}]]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "graphsOn"
    {
        rel camera = </cam>
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "graphsOff"
    {
        rel camera = </cam>
        custom bool eldr:materialGraphs = 0
        uniform int2 resolution = (960, 540)
    }
}

