    def Material "PlasticRed" (
        apiSchemas = ["MaterialXConfigAPI"]
        customData = {
            string HoudiniCatalogParentPath = "Plastics"
            dictionary houdini = {
                string dialogScript = '''{
    name    usdmaterial

    groupcollapsible {
        name    "folder1"
        label   "MaterialX Subnet"

        parm {
            name    "inherit_ctrl"
            label   "Inherit from Class"
            type    integer
            default { "2" }
            menu {
                "0" "Never"
                "1" "Always"
                "2" "Material Flag"
            }
            range   { 0 10 }
        }
        parm {
            name    "separator1"
            label   "separator1"
            type    separator
            default { "" }
        }
        parm {
            name    "tabmenumask"
            label   "Tab Menu Mask"
            type    string
            default { "MaterialX parameter collect subnet null subnetconnector" }
            parmtag { "spare_category" "Tab Menu" }
        }
    }


}'''
            }
        }
    )
    {
        string config:mtlx:version = "1.39"
        color3f inputs:color = (0.825, 0, 0) (
            displayName = "Color"
        )
