#usda 1.0
(
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [
        @./geo.usda@
    ]
    upAxis = "Y"
)

# Houdini 22's basic materials that use Karma's own nodes, on spheres:
# Plastic (kma_color_hextiling), SilkSurfaceGreen and Marble
# (kma_rampconst), CarPaintMetallic (kma_voronoinoise3d flakes as a bump),
# and AppleJuice (absorption over transmission_depth through the ball).
# /Render/graphsOn (the default) vs /Render/graphsOff
# (eldr:materialGraphs off: the graph-driven inputs keep their constants).
# The materials come from Houdini's install ($HFS/houdini/usd/materials).

def Camera "cam"
{
    float focalLength = 35
    float horizontalAperture = 36
    float verticalAperture = 20.25
    double3 xformOp:translate = (0, 0, 12)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def DomeLight "sky"
{
    float inputs:intensity = 0.5
}

def DistantLight "sun"
{
    float inputs:angle = 1
    float inputs:intensity = 2
    float3 xformOp:rotateXYZ = (-35, -30, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def Scope "Materials"
{
    def Material "CarPaint" (
        apiSchemas = ["MaterialXConfigAPI"]
        customData = {
            string HoudiniCatalogParentPath = "Vehicle"
        }
    )
    {
        string config:mtlx:version = "1.39"
        float inputs:base_bump_height = 0.0002 (
            displayName = "Base Bump Height"
        )
        float inputs:base_bump_scale = 0 (
            displayName = "Base Bump Scale"
        )
        color3f inputs:base_color = (0.675, 0, 0) (
            displayName = "Base Color"
        )
        asset inputs:base_color_map = @@ (
            displayName = "Base Color Map"
        )
        float inputs:base_roughness = 0.005 (
            displayName = "Base Roughness"
        )
        color3f inputs:coat_color = (1, 1, 1) (
            displayName = "Coat Color"
        )
        asset inputs:coat_color_map = @@ (
            displayName = "Coat Color Map"
        )
        float inputs:coat_roughness = 0.0375 (
            displayName = "Coat Roughness"
        )
        token outputs:kma:surface.connect = </Materials/CarPaint/mtlxstandard_surface.outputs:out>
        token outputs:surface.connect = </Materials/CarPaint/mtlxstandard_preview.outputs:surface>

        def Shader "mtlxstandard_surface" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1
                        string ogl_diff_intensity = "1"
                    }
                }
            )
            color3f inputs:base_color = (1, 0, 0) (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (0.8, 0.8, 0.8)
                        string ogl_diff = "1"
                    }
                }
            )
            color3f inputs:base_color.connect = </Materials/CarPaint/kma_camerafalloff3.outputs:color>
            float inputs:coat = 0.5 (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_coat_intensity = "1"
                    }
                }
            )
            color3f inputs:coat_color.connect = </Materials/CarPaint/mtlximage2.outputs:out>
            float inputs:coat_IOR = 1.55
            float inputs:coat_roughness = 0.0375 (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0.1
                        string ogl_coat_rough = "1"
                    }
                }
            )
            float inputs:coat_roughness.connect = </Materials/CarPaint.inputs:coat_roughness>
            float inputs:emission (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_emit_intensity = "1"
                    }
                }
            )
            color3f inputs:emission_color (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (1, 1, 1)
                        string ogl_emit = "1"
                    }
                }
            )
            float inputs:metalness (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_metallic = "1"
                    }
                }
            )
            vector3f inputs:normal.connect = </Materials/CarPaint/mtlxbump1.outputs:out>
            float inputs:specular (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1
                        string ogl_spec_intensity = "1"
                    }
                }
            )
            color3f inputs:specular_color (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (1, 1, 1)
                        string ogl_spec = "1"
                    }
                }
            )
            float inputs:specular_IOR = 1.45 (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1.5
                        string ogl_ior = "1"
                    }
                }
            )
            float inputs:specular_roughness = 0.005 (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0.2
                        string ogl_rough = "1"
                    }
                }
            )
            float inputs:specular_roughness.connect = </Materials/CarPaint.inputs:base_roughness>
            float inputs:transmission (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_transparency = "1"
                    }
                }
            )
            token outputs:out
            uniform float2 ui:nodegraph:node:pos = (32.5683, -2.75929)
        }

        def Shader "kma_camerafalloff3" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_kma_camerafalloff"
            color3f inputs:basecolor.connect = </Materials/CarPaint/mtlxmultiply5.outputs:out>
            float inputs:bias = 0.383
            color3f inputs:edgecolor.connect = </Materials/CarPaint/mtlxcolorcorrect1.outputs:out>
            color3f outputs:color
            uniform float2 ui:nodegraph:node:pos = (25.1833, -2.4671)
        }

        def Shader "mtlxmultiply5" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_multiply_color3"
            color3f inputs:in1.connect = </Materials/CarPaint/mtlximage1.outputs:out>
            color3f inputs:in2.connect = </Materials/CarPaint.inputs:base_color>
            color3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (19.3416, -0.129122)
        }

        def Shader "mtlximage1" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (1, 1, 1)
            asset inputs:file.connect = </Materials/CarPaint.inputs:base_color_map>
            color3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (16.8642, -1.34282)
        }

        def Shader "mtlxcolorcorrect1" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_colorcorrect_color3"
            float inputs:exposure = -0.5
            float inputs:gamma = 0.3825
            color3f inputs:in.connect = </Materials/CarPaint/mtlxmultiply5.outputs:out>
            color3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (22.7955, 1.3586)
        }

        def Shader "mtlximage2" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (1, 1, 1)
            color3f inputs:default.connect = </Materials/CarPaint.inputs:coat_color>
            asset inputs:file.connect = </Materials/CarPaint.inputs:coat_color_map>
            color3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (21.903, -10.4488)
        }

        def Shader "mtlxbump1" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_bump_vector3"
            float inputs:height.connect = </Materials/CarPaint/kma_voronoinoise3d1.outputs:distance>
            float inputs:scale = 0.0002
            float inputs:scale.connect = </Materials/CarPaint.inputs:base_bump_height>
            vector3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (29.0237, -8.20341)
        }

        def Shader "kma_voronoinoise3d1" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "kma_voronoinoise3d_float"
            vector3f inputs:freq = (341, 341, 341)
            vector3f inputs:freq.connect = </Materials/CarPaint/mtlxmultiply4.outputs:out>
            int inputs:metric = 1
            float outputs:distance
            uniform float2 ui:nodegraph:node:pos = (24.8933, -8.20341)
        }

        def Shader "mtlxmultiply4" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_multiply_vector3FA"
            vector3f inputs:in1 = (341, 341, 341)
            float inputs:in2 = 345
            float inputs:in2.connect = </Materials/CarPaint/mtlxdivide1.outputs:out>
            vector3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (22.0925, -7.5071)
        }

        def Shader "mtlxdivide1" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_divide_float"
            float inputs:in1 = 1
            float inputs:in2.connect = </Materials/CarPaint.inputs:base_bump_scale>
            float outputs:out
            uniform float2 ui:nodegraph:node:pos = (20.0418, -4.81349)
        }

        def Shader "mtlxstandard_preview" (
            customData = {
                bool HoudiniIsAutoCreatedShader = 1
            }
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0.5
            float inputs:clearcoatRoughness = 0.0375
            float inputs:clearcoatRoughness.connect = </Materials/CarPaint.inputs:coat_roughness>
            color3f inputs:diffuseColor = (1, 0, 0)
            color3f inputs:diffuseColor.connect = </Materials/CarPaint.inputs:base_color>
            float inputs:ior = 1.45
            float inputs:roughness = 0.005
            float inputs:roughness.connect = </Materials/CarPaint.inputs:base_roughness>
            color3f inputs:specularColor = (1, 1, 1)
            token outputs:surface
        }
    }

    def Material "CarPaintMetallic" (
        apiSchemas = ["MaterialXConfigAPI"]
        customData = {
            string HoudiniCatalogParentPath = "Vehicle"
        }
    )
    {
        string config:mtlx:version = "1.39"
        float inputs:base_bump_height = 0.0001 (
            displayName = "Base Bump Height"
        )
        float inputs:base_bump_scale = 0 (
            displayName = "Base Bump Scale"
        )
        color3f inputs:base_color = (0, 0.5, 1) (
            displayName = "Base Color"
        )
        float inputs:base_color_bias = 0.3 (
            displayName = "Base Color Bias"
        )
        asset inputs:base_color_map = @@ (
            displayName = "Base Color Map"
        )
        color3f inputs:base_edge_color = (0, 0.07, 0.5) (
            displayName = "Base Edge Color"
        )
        float inputs:base_roughness = 0.005 (
            displayName = "Base Roughness"
        )
        color3f inputs:coat_color = (1, 1, 1) (
            displayName = "Coat Color"
        )
        asset inputs:coat_color_map = @@ (
            displayName = "Coat Color Map"
        )
        float inputs:coat_roughness = 0.0825 (
            displayName = "Coat Roughness"
        )
        color3f inputs:flake_color = (0.564, 1, 1) (
            displayName = "Flake Color"
        )
        float inputs:flake_presence = 0.25 (
            displayName = "Flake Presence"
        )
        float inputs:flake_scale = 1 (
            displayName = "Flake Scale"
        )
        token outputs:kma:surface.connect = </Materials/CarPaintMetallic/mtlxstandard_surface.outputs:out>
        token outputs:surface.connect = </Materials/CarPaintMetallic/mtlxstandard_preview.outputs:surface>

        def Shader "mtlxstandard_surface" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1
                        string ogl_diff_intensity = "1"
                    }
                }
            )
            color3f inputs:base_color = (1, 0, 0) (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (0.8, 0.8, 0.8)
                        string ogl_diff = "1"
                    }
                }
            )
            color3f inputs:base_color.connect = </Materials/CarPaintMetallic/mtlxmix5.outputs:out>
            float inputs:coat = 1 (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_coat_intensity = "1"
                    }
                }
            )
            color3f inputs:coat_color.connect = </Materials/CarPaintMetallic/mtlxmultiply8.outputs:out>
            float inputs:coat_IOR = 1.55
            float inputs:coat_roughness = 0.0825 (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0.1
                        string ogl_coat_rough = "1"
                    }
                }
            )
            float inputs:coat_roughness.connect = </Materials/CarPaintMetallic.inputs:coat_roughness>
            float inputs:emission (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_emit_intensity = "1"
                    }
                }
            )
            color3f inputs:emission_color (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (1, 1, 1)
                        string ogl_emit = "1"
                    }
                }
            )
            float inputs:metalness = 1 (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_metallic = "1"
                    }
                }
            )
            float inputs:metalness.connect = </Materials/CarPaintMetallic/mtlxinvert1.outputs:out>
            vector3f inputs:normal.connect = </Materials/CarPaintMetallic/mtlxbump1.outputs:out>
            float inputs:specular (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1
                        string ogl_spec_intensity = "1"
                    }
                }
            )
            color3f inputs:specular_color (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (1, 1, 1)
                        string ogl_spec = "1"
                    }
                }
            )
            float inputs:specular_IOR = 1.45 (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1.5
                        string ogl_ior = "1"
                    }
                }
            )
            float inputs:specular_roughness = 0.005 (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0.2
                        string ogl_rough = "1"
                    }
                }
            )
            float inputs:specular_roughness.connect = </Materials/CarPaintMetallic.inputs:base_roughness>
            float inputs:transmission (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_transparency = "1"
                    }
                }
            )
            token outputs:out
            uniform float2 ui:nodegraph:node:pos = (53.3131, -21.9038)
        }

        def Shader "mtlxmix5" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_mix_color3"
            color3f inputs:bg = (1, 0, 0)
            color3f inputs:bg.connect = </Materials/CarPaintMetallic/kma_camerafalloff5.outputs:color>
            color3f inputs:fg = (1, 1, 0.018000007)
            color3f inputs:fg.connect = </Materials/CarPaintMetallic.inputs:flake_color>
            float inputs:mix.connect = </Materials/CarPaintMetallic/mtlxclamp3.outputs:out>
            color3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (50.3131, -14.2088)
        }

        def Shader "kma_camerafalloff5" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_kma_camerafalloff"
            color3f inputs:basecolor.connect = </Materials/CarPaintMetallic/mtlxmultiply5.outputs:out>
            float inputs:bias = 0.265
            float inputs:bias.connect = </Materials/CarPaintMetallic.inputs:base_color_bias>
            color3f inputs:edgecolor.connect = </Materials/CarPaintMetallic.inputs:base_edge_color>
            float inputs:gain = 0.3
            color3f outputs:color
            uniform float2 ui:nodegraph:node:pos = (47.3131, -18.0688)
        }

        def Shader "mtlxmultiply5" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_multiply_color3"
            color3f inputs:in1.connect = </Materials/CarPaintMetallic/mtlximage1.outputs:out>
            color3f inputs:in2.connect = </Materials/CarPaintMetallic.inputs:base_color>
            color3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (38.8206, -14.6089)
        }

        def Shader "mtlximage1" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (1, 1, 1)
            asset inputs:file.connect = </Materials/CarPaintMetallic.inputs:base_color_map>
            color3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (35.8206, -13.8439)
        }

        def Shader "mtlxclamp3" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Materials/CarPaintMetallic/mtlxmultiply7.outputs:out>
            float outputs:out
            uniform float2 ui:nodegraph:node:pos = (47.3131, -21.8788)
        }

        def Shader "mtlxmultiply7" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Materials/CarPaintMetallic/kma_camerafalloff6.outputs:falloff>
            float inputs:in2.connect = </Materials/CarPaintMetallic/mtlxremap3.outputs:out>
            float outputs:out
            uniform float2 ui:nodegraph:node:pos = (44.3131, -21.8788)
        }

        def Shader "kma_camerafalloff6" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_kma_camerafalloff"
            color3f inputs:basecolor = (0, 0, 0)
            float inputs:bias = 0.3
            color3f inputs:edgecolor = (0, 0, 0)
            float outputs:falloff
            uniform float2 ui:nodegraph:node:pos = (41.3131, -21.5038)
        }

        def Shader "mtlxremap3" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_remap_float"
            float inputs:in.connect = </Materials/CarPaintMetallic/mtlxunifiednoise3d1.outputs:out>
            float inputs:inlow = 0.4
            float inputs:inlow.connect = </Materials/CarPaintMetallic/mtlxrange2.outputs:out>
            float outputs:out
            uniform float2 ui:nodegraph:node:pos = (41.3131, -24.1588)
        }

        def Shader "mtlxunifiednoise3d1" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_unifiednoise3d_float"
            vector3f inputs:freq.connect = </Materials/CarPaintMetallic/mtlxmultiply3.outputs:out>
            int inputs:type = 2
            float outputs:out
            uniform float2 ui:nodegraph:node:pos = (35.1902, -18.8423)
        }

        def Shader "mtlxmultiply3" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_multiply_vector3FA"
            vector3f inputs:in1 = (1201, 1201, 1201)
            float inputs:in2.connect = </Materials/CarPaintMetallic.inputs:flake_scale>
            vector3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (32.3131, -25.3738)
        }

        def Shader "mtlxrange2" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_range_float"
            float inputs:in.connect = </Materials/CarPaintMetallic.inputs:flake_presence>
            float inputs:outhigh = 0.1
            float inputs:outlow = 0.9999
            float outputs:out
            uniform float2 ui:nodegraph:node:pos = (38.3131, -27.6688)
        }

        def Shader "mtlxinvert1" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_invert_float"
            float inputs:amount = 0.35
            float inputs:in.connect = </Materials/CarPaintMetallic/mtlxclamp3.outputs:out>
            float outputs:out
            uniform float2 ui:nodegraph:node:pos = (50.3131, -29.9488)
        }

        def Shader "mtlxmultiply8" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_multiply_color3"
            color3f inputs:in1.connect = </Materials/CarPaintMetallic/mtlximage2.outputs:out>
            color3f inputs:in2.connect = </Materials/CarPaintMetallic.inputs:coat_color>
            color3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (40.514, -34.8051)
        }

        def Shader "mtlximage2" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (1, 1, 1)
            asset inputs:file.connect = </Materials/CarPaintMetallic.inputs:coat_color_map>
            color3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (37.514, -35.7825)
        }

        def Shader "mtlxbump1" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_bump_vector3"
            float inputs:height.connect = </Materials/CarPaintMetallic/kma_voronoinoise3d1.outputs:distance>
            float inputs:scale = 0.0001
            float inputs:scale.connect = </Materials/CarPaintMetallic.inputs:base_bump_height>
            vector3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (50.3131, -31.4788)
        }

        def Shader "kma_voronoinoise3d1" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "kma_voronoinoise3d_float"
            vector3f inputs:freq = (341, 341, 341)
            vector3f inputs:freq.connect = </Materials/CarPaintMetallic/mtlxmultiply4.outputs:out>
            int inputs:metric = 1
            float outputs:distance
            uniform float2 ui:nodegraph:node:pos = (47.3131, -31.4788)
        }

        def Shader "mtlxmultiply4" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_multiply_vector3FA"
            vector3f inputs:in1 = (351, 351, 351)
            float inputs:in2 = 345
            float inputs:in2.connect = </Materials/CarPaintMetallic/mtlxdivide1.outputs:out>
            vector3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (46.5975, -39.8196)
        }

        def Shader "mtlxdivide1" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_divide_float"
            float inputs:in1 = 1
            float inputs:in2.connect = </Materials/CarPaintMetallic.inputs:base_bump_scale>
            float outputs:out
            uniform float2 ui:nodegraph:node:pos = (43.5975, -39.8196)
        }

        def Shader "mtlxstandard_preview" (
            customData = {
                bool HoudiniIsAutoCreatedShader = 1
            }
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 1
            float inputs:clearcoatRoughness = 0.0825
            float inputs:clearcoatRoughness.connect = </Materials/CarPaintMetallic.inputs:coat_roughness>
            color3f inputs:diffuseColor = (1, 0, 0)
            color3f inputs:diffuseColor.connect = </Materials/CarPaintMetallic.inputs:base_color>
            float inputs:ior = 1.45
            float inputs:metallic = 1
            float inputs:roughness = 0.005
            float inputs:roughness.connect = </Materials/CarPaintMetallic.inputs:base_roughness>
            color3f inputs:specularColor = (1, 1, 1)
            token outputs:surface
        }
    }

    def Material "Wood" (
        apiSchemas = ["MaterialXConfigAPI"]
        customData = {
            string HoudiniCatalogParentPath = "Wood"
            dictionary houdini = {
                string dialogScript = '''{
    name    usdmaterial

    parm {
        name    "coat"
        label   "Add Coat"
        type    toggle
        default { "off" }
        parmtag { "parmvop" "1" }
    }
