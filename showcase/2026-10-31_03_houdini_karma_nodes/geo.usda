    apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </Materials/Marble>
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "carPaint" (
    apiSchemas = ["MaterialBindingAPI"]
