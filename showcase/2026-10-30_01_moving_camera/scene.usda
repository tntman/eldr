#usda 1.0
(
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [@../../tests/scenes/emissive.usda@]
)

# Moving camera mode: tumble this scene in usdview or Houdini with GI,
# SSGI, traced shadows and traced reflections on. /Render/moving (the
# defaults) renders at half size while the camera moves, one traced shadow
# ray per light, GI probes paused; /Render/full keeps everything while
# moving. Still frames are the same in both. /Render/abrupt turns off the
# smooth switch (frame budget, ramp, film warm start).

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/moving
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (1280, 720)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (1280, 720)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (1280, 720)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "moving"
    {
        rel camera = </cam>
        int2 resolution = (1280, 720)
        custom bool eldr:gi = 1
        custom bool eldr:ssgi = 1
        custom bool eldr:rtShadows = 1
        custom bool eldr:rtReflections = 1
    }

    def RenderSettings "full"
    {
        rel camera = </cam>
        int2 resolution = (1280, 720)
        custom bool eldr:gi = 1
        custom bool eldr:ssgi = 1
        custom bool eldr:rtShadows = 1
        custom bool eldr:rtReflections = 1
        custom float eldr:movingRenderScale = 1
        custom int eldr:movingShadowRays = 0
        custom bool eldr:movingGiPause = 0
    }

    # The smooth switch off: a fixed half size while moving, full quality
    # in one frame after the stop, the film from its first sample.
    def RenderSettings "abrupt"
    {
        rel camera = </cam>
        int2 resolution = (1280, 720)
        custom bool eldr:gi = 1
        custom bool eldr:ssgi = 1
        custom bool eldr:rtShadows = 1
        custom bool eldr:rtReflections = 1
        custom int eldr:rampFrames = 0
        custom float eldr:movingFrameBudget = 0
        custom float eldr:filmWarmStart = 0
    }
}
