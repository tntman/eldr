#usda 1.0
(
    renderSettingsPrimPath = "/Render/eldr_default"
    upAxis = "Y"
    metersPerUnit = 1
    subLayers = [@../../tests/scenes/emissive.usda@]
)

# Bloom and tonemapping: the Cornell box lit by a glowing panel (40) and a
# warm bulb (60, 30, 8) seen directly, so the image has values far over 1.
# Linear Beauty (eldr:productLinear, on) makes husk's and Houdini's beauty
# linear with no tonemap and no bloom, so every prim here turns it off;
# usdview and usdrecord tonemap either way. eldr:colorLimit 1000 keeps the
# emitters' full HDR (Karma's colour limit would clamp them at 20).
# /Render/aces: ACES (the default tonemapper), bloom 0.04 (the default).
# /Render/agx: eldr:tonemapper agx: softer highlights, the bulb's orange
# desaturates towards white instead of clipping to yellow.
# /Render/bloom: eldr:bloomIntensity 0.4: a wide glow around the panel and
# the bulb.
# /Render/linear: eldr:tonemapper none, bloom 0: exposed linear, clipped.

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/aces
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom float karma:global:colorlimit = 1000.0
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "aces"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:productLinear = 0
        custom float eldr:colorLimit = 1000
    }

    def RenderSettings "agx"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:productLinear = 0
        custom float eldr:colorLimit = 1000
        custom string eldr:tonemapper = "agx"
    }

    def RenderSettings "bloom"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:productLinear = 0
        custom float eldr:colorLimit = 1000
        custom float eldr:bloomIntensity = 0.4
    }

    def RenderSettings "linear"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:productLinear = 0
        custom float eldr:colorLimit = 1000
        custom string eldr:tonemapper = "none"
        custom float eldr:bloomIntensity = 0
    }
}
