#usda 1.0
(
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [
        @./geo.usda@
    ]
)

# Holdouts (mattes) and phantom objects, set per object. Eldr's
# primvars:eldr:object:* names win over primvars:karma:object:*.
# holdout.usda: /ball has karma holdoutmode 2 (matte), /box karma 1.
# /box: eldr 0 wins over karma 1, so it renders normally.

def Camera "cam"
{
    float focalLength = 30
    float xformOp:rotateX = -8
    double3 xformOp:translate = (0, 1.2, 6)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def DistantLight "sun"
{
    float inputs:intensity = 3
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-50, 30, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def DomeLight "sky"
{
    float inputs:intensity = 0.5
    asset inputs:texture:file = @StinsonBeach.hdr@
}

def Scope "passes"
{
    def RenderPass "holdouts" (
        apiSchemas = ["CollectionAPI:matte"]
    )
    {
        rel collection:matte:includes = </cone>
        rel renderSource = </passes/settings>
    }

    def RenderSettings "settings"
    {
        rel camera = </cam>
    }
}

def Scope "mtl"
{
    def Material "floor"
    {
        token outputs:surface.connect = </mtl/floor/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </mtl/floor/tex.outputs:rgb>
            float inputs:roughness = 0.8
            token outputs:surface
        }

        def Shader "tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @../../tests/scenes/textures/udim.1001.png@
            float2 inputs:st.connect = </mtl/floor/st.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "st"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/holdoutScene
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "holdoutScene"
    {
        rel camera = </cam>
        custom bool eldr:holdouts = 1
        uniform int2 resolution = (480, 270)
    }

    def RenderSettings "holdoutsOff"
    {
        rel camera = </cam>
        custom bool eldr:holdouts = 0
        uniform int2 resolution = (480, 270)
    }
}

