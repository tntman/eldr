#usda 1.0
(
    renderSettingsPrimPath = "/Render/eldr_default"
    upAxis = "Y"
    metersPerUnit = 1
    subLayers = [@../../tests/scenes/sunangle.usda@]
)

# Prims without a material: tests/scenes/sunangle.usda (a ground of
# displayColor 0.7, two posts, a beam and a ball without a displayColor)
# plus two balls with a displayColor, the right one with displayOpacity 0.5.
# /Render/karmaDefault (the default): Karma's default material, 0.4 x
# displayColor (white without one) and a faint highlight; the right ball
# is half see-through.
# /Render/lambertDefault (eldr:defaultMaterialKarma off): displayColor at
# full strength, about 2.3x as bright, and both balls opaque.

def Sphere "redBall"
{
    double radius = 0.5
    double3 xformOp:translate = (-1.4, 0.5, 2.5)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    color3f[] primvars:displayColor = [(0.8, 0.2, 0.1)]
}

def Sphere "halfBall"
{
    double radius = 0.5
    double3 xformOp:translate = (1.4, 0.5, 2.5)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    color3f[] primvars:displayColor = [(0.1, 0.3, 0.8)]
    float[] primvars:displayOpacity = [0.5]
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/karmaDefault
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "karmaDefault"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }

    def RenderSettings "lambertDefault"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:defaultMaterialKarma = 0
    }
}
