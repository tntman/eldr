#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Y"
)

def Mesh "floor" (
    apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    rel material:binding = </mtl/floor>
    point3f[] points = [(-9, -2.6, 4), (9, -2.6, 4), (9, -2.6, -4), (-9, -2.6, -4)]
    texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
        interpolation = "vertex"
    )
    uniform token subdivisionScheme = "none"
}

def Sphere "s_mixDiffuse" (
    apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </mtl/mixDiffuse>
    double radius = 1
    double3 xformOp:translate = (-6, 1.2, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

