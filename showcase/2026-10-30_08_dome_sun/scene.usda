#usda 1.0
(
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [
        @./geo.usda@
    ]
    upAxis = "Y"
)

# Dome sun extraction: tests/scenes/step4.usda (chrome, gold and matte
# objects on a ground) lit by StinsonBeach.hdr alone; its distant light is
# switched off. The HDRI's sun is a few bright texels: as image light alone
# they give no crisp shadow. Eldr takes texels brighter than
# eldr:domeSunThreshold (10) out of the dome and lights with them as a
# shadowed distant light of the same power and direction.
# /Render/domeSun (the default): sharp sun shadows from the HDRI.
# /Render/domeSunOff: the dome only (eldr:domeSun off): soft, shadowless
# sunlight, the objects lit from everywhere.
# StinsonBeach.hdr ships with USD: usdenv.cmd puts its folder on the
# resolver's search path (husk: set PXR_AR_DEFAULT_SEARCH_PATH to
# <USD>\lib\usd\hdx\resources\textures).

def Camera "cam"
{
    float focalLength = 28
    float xformOp:rotateX = -12
    double3 xformOp:translate = (0, 3, 11)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def DomeLight "env"
{
    float inputs:intensity = 1
    asset inputs:texture:file = @StinsonBeach.hdr@
}

def DistantLight "sun"
{
    float inputs:intensity = 0
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-50, 35, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def Scope "mtl"
{
    def Material "ground"
    {
        token outputs:surface.connect = </mtl/ground/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
            float inputs:roughness = 0.9
            token outputs:surface
        }
    }

    def Material "chrome"
    {
        token outputs:surface.connect = </mtl/chrome/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
            float inputs:metallic = 1
            float inputs:roughness = 0.08
            token outputs:surface
        }
    }

    def Material "gold"
    {
        token outputs:surface.connect = </mtl/gold/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 0.78, 0.34)
            float inputs:metallic = 1
            float inputs:roughness = 0.45
            token outputs:surface
        }
    }

    def Material "plastic"
    {
        token outputs:surface.connect = </mtl/plastic/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.1, 0.35, 0.8)
            float inputs:roughness = 0.35
            token outputs:surface
        }
    }

    def Material "stone"
    {
        token outputs:surface.connect = </mtl/stone/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.75, 0.7, 0.62)
            float inputs:roughness = 0.8
            token outputs:surface
        }
    }
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/domeSun
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[[\"denoise\", {\"engine\": \"oidn\", \"use_albedo_input\": true, \"use_n_input\": true, \"forcecpu\": false, \"aovs\": [\"C\"]}]]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "domeSun"
    {
        rel camera = </cam>
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "domeSunOff"
    {
        rel camera = </cam>
        custom bool eldr:domeSun = 0
        uniform int2 resolution = (960, 540)
    }
}

