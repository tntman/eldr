#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
    subLayers = [@../../tests/scenes/step4.usda@]
)

# Dome sun extraction: tests/scenes/step4.usda (chrome, gold and matte
# objects on a ground) lit by StinsonBeach.hdr alone; its distant light is
# switched off. The HDRI's sun is a few bright texels: as image light alone
# they give no crisp shadow. Eldr takes texels brighter than
# eldr:domeSunThreshold (10) out of the dome and lights with them as a
# shadowed distant light of the same power and direction.
# /Render/domeSun (the default): sharp sun shadows from the HDRI.
# /Render/domeSunOff: the dome only (eldr:domeSun off): soft, shadowless
# sunlight, the objects lit from everywhere.
# StinsonBeach.hdr ships with USD: usdenv.cmd puts its folder on the
# resolver's search path (husk: set PXR_AR_DEFAULT_SEARCH_PATH to
# <USD>\lib\usd\hdx\resources\textures).

over "sun"
{
    float inputs:intensity = 0
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "domeSun"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }

    def RenderSettings "domeSunOff"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:domeSun = 0
    }
}
