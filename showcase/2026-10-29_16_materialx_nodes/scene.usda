            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/minus/blend.outputs:out>
            float inputs:specular = 0
            token outputs:out
        }

        def Shader "fg"
        {
            uniform token info:id = "ND_ramplr_color3"
            color3f inputs:valuel = (1, 0.5, 0.1)
            color3f inputs:valuer = (0.1, 0.3, 1)
            color3f outputs:out
        }

        def Shader "bg"
        {
            uniform token info:id = "ND_ramptb_color3"
            color3f inputs:valueb = (0.1, 0.1, 0.1)
            color3f inputs:valuet = (0.9, 0.9, 0.9)
            color3f outputs:out
        }

        def Shader "blend"
        {
            uniform token info:id = "ND_minus_color3"
            color3f inputs:bg.connect = </mtl/minus/bg.outputs:out>
            color3f inputs:fg.connect = </mtl/minus/fg.outputs:out>
            float inputs:mix = 1
            color3f outputs:out
        }
    }

    def Material "difference"
