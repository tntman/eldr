    def Material "screen"
    {
        token outputs:mtlx:surface.connect = </mtl/screen/surface.outputs:out>

        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </mtl/screen/blend.outputs:out>
            float inputs:specular = 0
            token outputs:out
        }

        def Shader "fg"
        {
            uniform token info:id = "ND_ramplr_color3"
            color3f inputs:valuel = (1, 0.5, 0.1)
            color3f inputs:valuer = (0.1, 0.3, 1)
