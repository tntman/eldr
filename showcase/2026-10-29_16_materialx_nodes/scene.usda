        }
    }

    def Material "disneyCoatMetal"
    {
        token outputs:mtlx:surface.connect = </mtl/disneyCoatMetal/surface.outputs:out>

        def Shader "surface"
        {
            uniform token info:id = "ND_disney_principled"
            color3f inputs:baseColor = (0.9, 0.9, 0.92)
            float inputs:clearcoat = 1
            float inputs:clearcoatGloss = 0.95
            float inputs:metallic = 1
            float inputs:roughness = 0.5
