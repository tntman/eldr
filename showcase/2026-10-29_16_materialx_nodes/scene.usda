    def Material "gltfGold"
    {
        token outputs:mtlx:surface.connect = </mtl/gltfGold/surface.outputs:out>

        def Shader "surface"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            color3f inputs:base_color = (1, 0.77, 0.34)
            float inputs:metallic = 1
            float inputs:roughness = 0.3
            token outputs:out
        }
    }

    def Material "gltfCoatSheen"
    {
        token outputs:mtlx:surface.connect = </mtl/gltfCoatSheen/surface.outputs:out>

        def Shader "surface"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            color3f inputs:base_color = (0.1, 0.25, 0.6)
            float inputs:clearcoat = 1
            float inputs:clearcoat_roughness = 0.05
            float inputs:metallic = 0
            float inputs:roughness = 0.6
            color3f inputs:sheen_color = (0.8, 0.8, 0.8)
            token outputs:out
        }
    }

    def Material "gltfBlend"
    {
        token outputs:mtlx:surface.connect = </mtl/gltfBlend/surface.outputs:out>

        def Shader "surface"
        {
