#usda 1.0
(
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Mesh "ground"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-2000, 0, 500), (2000, 0, 500), (2000, 0, -5000), (-2000, 0, -5000)]
    color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
}

def Sphere "s200"
{
    color3f[] primvars:displayColor = [(0.9, 0.2, 0.2)]
    double radius = 25
    double3 xformOp:translate = (-60, 25, -200)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "s500"
{
    color3f[] primvars:displayColor = [(0.2, 0.9, 0.2)]
    double radius = 25
    double3 xformOp:translate = (-10, 25, -500)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "s1000"
{
    color3f[] primvars:displayColor = [(0.2, 0.2, 0.9)]
    double radius = 25
    double3 xformOp:translate = (60, 25, -1000)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Sphere "s2000"
{
    color3f[] primvars:displayColor = [(0.9, 0.9, 0.2)]
    double radius = 25
    double3 xformOp:translate = (160, 25, -2000)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Cube "mover"
{
    color3f[] primvars:displayColor = [(0.9, 0.5, 0.1)]
    double size = 30
    double3 xformOp:translate.timeSamples = {
        1: (-200, 90, -400),
        24: (200, 90, -400),
    }
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

