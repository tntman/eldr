#usda 1.0
(
    renderSettingsPrimPath = "/Render/planar"
    subLayers = [@../../tests/scenes/reflections.usda@]
    startTimeCode = 1
    endTimeCode = 3
    timeCodesPerSecond = 24
)

# A cube racing across the mirror floor in front of the chrome ball, 3 units
# a frame; the camera's shutter is open half a frame. Render frame 2.

over "cam"
{
    double shutter:open = -0.25
    double shutter:close = 0.25
}

def Cube "racer" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    double size = 0.8
    double3 xformOp:translate.timeSamples = {
        1: (-3, 0.9, 2.5),
        3: (3, 0.9, 2.5),
    }
    uniform token[] xformOpOrder = ["xformOp:translate"]
    rel material:binding = </mtl/orange>
}

over "mtl"
{
    def Material "orange"
    {
        token outputs:surface.connect = </mtl/orange/pbr.outputs:surface>
        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.9, 0.35, 0.05)
            color3f inputs:emissiveColor = (0.6, 0.2, 0.02)
            float inputs:roughness = 0.5
            token outputs:surface
        }
    }
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (640, 360)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (640, 360)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (640, 360)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    # The mirror renders each film sample at its shutter time: the floor's
    # reflection of the cube blurs as the cube does.
    def RenderSettings "planar"
    {
        rel camera = </cam>
        int2 resolution = (640, 360)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:planarReflections = 1
        custom bool eldr:planarMotionBlur = 1
        custom bool eldr:reflectionProbe = 1
        custom bool eldr:rtReflections = 0
        custom bool eldr:ssr = 0
    }
    # The mirror at the frame's time: a sharp reflection under a blurred cube.
    def RenderSettings "frozen"
    {
        rel camera = </cam>
        int2 resolution = (640, 360)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:planarReflections = 1
        custom bool eldr:planarMotionBlur = 0
        custom bool eldr:reflectionProbe = 1
        custom bool eldr:rtReflections = 0
        custom bool eldr:ssr = 0
    }
    # Traced reflections (floor and ball) from each sample's TLAS.
    def RenderSettings "traced"
    {
        rel camera = </cam>
        int2 resolution = (640, 360)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:planarReflections = 0
        custom bool eldr:reflectionProbe = 0
        custom bool eldr:rtReflections = 1
    }
}
