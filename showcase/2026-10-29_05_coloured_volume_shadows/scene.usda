#usda 1.0
(
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [
        @./geo.usda@
    ]
    upAxis = "Y"
)

# volume.usda (a grey smoke cloud lit by the sun and a dome) with its fire
# replaced by orange-brown soot: an absorbing MaterialX volume that lets red
# through and stops blue, so its shadow on the floor is orange. Settings
# prims flip how the shadow and the cloud's multiple scattering are made.

def Camera "cam"
{
    float focalLength = 30
    float xformOp:rotateX = -8
    double3 xformOp:translate = (0, 1.4, 9)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def DistantLight "sun"
{
    float inputs:intensity = 3
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-35, 40, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def DomeLight "sky"
{
    float inputs:intensity = 0.5
    asset inputs:texture:file = @StinsonBeach.hdr@
}

def Scope "mtl"
{
    def Material "soot"
    {
        token outputs:mtlx:volume.connect = </mtl/soot/volume.outputs:out>

        def Shader "volume"
        {
            uniform token info:id = "ND_volume"
            token inputs:vdf.connect = </mtl/soot/vdf.outputs:out>
            token outputs:out
        }

        def Shader "vdf"
        {
            uniform token info:id = "ND_absorption_vdf"
            vector3f inputs:absorption.connect = </mtl/soot/absorption.outputs:out>
            token outputs:out
        }

        def Shader "density"
        {
            uniform token info:id = "ND_geompropvalue_float"
            string inputs:geomprop = "density"
            float outputs:out
        }

        def Shader "absorption"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            vector3f inputs:in1 = (0.15, 0.6, 1.2)
            float inputs:in2.connect = </mtl/soot/density.outputs:out>
            vector3f outputs:out
        }
    }
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/maps
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "maps"
    {
        rel camera = </cam>
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "traced"
    {
        rel camera = </cam>
        custom bool eldr:rtShadows = 1
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "halfResolution"
    {
        rel camera = </cam>
        custom int eldr:volumeResolution = 2
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "shadowsOff"
    {
        rel camera = </cam>
        custom bool eldr:volumeShadows = 0
        uniform int2 resolution = (960, 540)
    }
}

