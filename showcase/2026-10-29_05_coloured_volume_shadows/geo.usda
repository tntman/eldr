#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Y"
)

def Cube "floor"
{
    color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
    double size = 1
    float3 xformOp:scale = (14, 0.1, 10)
    double3 xformOp:translate = (0, -2.05, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}

def Sphere "orb"
{
    color3f[] primvars:displayColor = [(0.8, 0.2, 0.1)]
    double radius = 0.6
    double3 xformOp:translate = (-1, 0.9, 1)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Volume "cloud"
{
    rel field:density = </cloud/density>
    float xformOp:rotateY = 35
    double3 xformOp:translate = (-2, 0.1, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY"]

    def OpenVDBAsset "density"
    {
        token fieldName = "density"
        asset filePath = @../../tests/scenes/volume.vdb@
    }
}

def Volume "ball"
{
    rel field:density = </ball/density>
    double3 xformOp:translate = (0.4, -1.4, 2)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def OpenVDBAsset "density"
    {
        int fieldIndex = 1
        token fieldName = "density"
        asset filePath = @../../tests/scenes/volume.vdb@
    }
}

def Volume "soot" (
    apiSchemas = ["MaterialBindingAPI"]
)
{
    rel field:density = </soot/density>
    rel material:binding = </mtl/soot>
    float3 xformOp:scale = (0.8, 0.8, 0.8)
    double3 xformOp:translate = (2.2, -0.2, 0.3)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

    def OpenVDBAsset "density"
    {
        token fieldName = "density"
        asset filePath = @../../tests/scenes/volume.vdb@
    }
}

