#usda 1.0
(
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [
        @./geo.usda@
    ]
    upAxis = "Y"
)

# Textures, UDIMs and colour spaces.
# Middle: tests/scenes/colorspace.usda: each column pairs a colour authored
# in ACEScg (top, tagged lin_ap1_scene) with the same colour pre-converted
# to linear Rec.709 (bottom); Eldr shades in linear Rec.709, so each pair
# matches. Left column constants, right column 16-bit textures.
# Right: a MaterialX image with udim.<UDIM>.png on uvs 0..2: tiles 1001
# (bottom left), 1002 (bottom right), 1011 (top left); 1012 is missing and
# reads the image's default (black).
# Bottom: a floor tiling quadrants.png 40 times towards the horizon.
# /Render/textures (the default): anisotropic filtering 16x: the tiles stay
# crisp far down the floor.
# /Render/aniso1: eldr:anisotropy 1 (trilinear only): the far floor blurs
# to a grey-brown smear.

def Camera "cam"
{
    float focalLength = 28
    float xformOp:rotateX = -10
    double3 xformOp:translate = (1.2, 1.2, 11)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def DistantLight "sun"
{
    float inputs:intensity = 3
    bool inputs:normalize = 1
}

def Scope "mtl"
{
    def Material "constantAp1"
    {
        token outputs:surface.connect = </mtl/constantAp1/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.5, 0.3, 0.2) (
                colorSpace = "lin_ap1_scene"
            )
            float inputs:roughness = 1
            token outputs:surface
        }
    }

    def Material "constantRec709"
    {
        token outputs:surface.connect = </mtl/constantRec709/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.64934, 0.275, 0.1799)
            float inputs:roughness = 1
            token outputs:surface
        }
    }

    def Material "textureAp1"
    {
        token outputs:surface.connect = </mtl/textureAp1/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </mtl/textureAp1/tex.outputs:rgb>
            float inputs:roughness = 1
            token outputs:surface
        }

        def Shader "tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @../../tests/scenes/textures/acescg.png@ (
                colorSpace = "lin_ap1_scene"
            )
            float3 outputs:rgb
        }
    }

    def Material "textureRec709"
    {
        token outputs:surface.connect = </mtl/textureRec709/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </mtl/textureRec709/tex.outputs:rgb>
            float inputs:roughness = 1
            token outputs:surface
        }

        def Shader "tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @../../tests/scenes/textures/rec709.png@
            token inputs:sourceColorSpace = "raw"
            float3 outputs:rgb
        }
    }
}

def DomeLight "sky"
{
    float inputs:intensity = 0.5
}

def Scope "mtl69"
{
    def Material "udim"
    {
        token outputs:mtlx:surface.connect = </mtl69/udim/surface.outputs:out>

        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 1
            color3f inputs:base_color.connect = </mtl69/udim/image.outputs:out>
            float inputs:specular_roughness = 0.6
            token outputs:out
        }

        def Shader "image"
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @../../tests/scenes/textures/udim.<UDIM>.png@ (
                colorSpace = "srgb_texture"
            )
            color3f outputs:out
        }
    }

    def Material "tiles"
    {
        token outputs:surface.connect = </mtl69/tiles/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </mtl69/tiles/tex.outputs:rgb>
            float inputs:roughness = 0.9
            token outputs:surface
        }

        def Shader "tex"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @../../tests/scenes/textures/quadrants.png@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </mtl69/tiles/st.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "st"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/textures
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "textures"
    {
        rel camera = </cam>
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "aniso1"
    {
        rel camera = </cam>
        custom int eldr:anisotropy = 1
        uniform int2 resolution = (960, 540)
    }
}

