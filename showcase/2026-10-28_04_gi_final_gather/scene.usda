#usda 1.0
(
    subLayers = [@../../tests/scenes/emissive.usda@]
)

# For the rect-light look: sublayer ../../tests/scenes/cornell.usda instead.

def Scope "Render"
{
    def RenderSettings "probesOnly"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:gi = 1
        custom int eldr:finalGather = 0
    }

    def RenderSettings "finalGather"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:finalQuality = 1
        custom bool eldr:gi = 1
        custom int eldr:finalGather = 1
    }

    def RenderSettings "finalGatherNoRelocation"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:finalQuality = 1
        custom bool eldr:gi = 1
        custom int eldr:finalGather = 1
        custom bool eldr:giRelocation = 0
    }

    def RenderSettings "finalGatherDistance0"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:finalQuality = 1
        custom bool eldr:gi = 1
        custom int eldr:finalGather = 1
        custom float eldr:finalGatherDistance = 0.0
    }

    def RenderSettings "finalGatherDistance05"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:finalQuality = 1
        custom bool eldr:gi = 1
        custom int eldr:finalGather = 1
        custom float eldr:finalGatherDistance = 0.5
    }

    def RenderSettings "ssgi"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:ssgi = 1
    }

    def RenderSettings "giPlusSsgi"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:finalQuality = 1
        custom bool eldr:gi = 1
        custom int eldr:finalGather = 1
        custom bool eldr:ssgi = 1
    }
}
