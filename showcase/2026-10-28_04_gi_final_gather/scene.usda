#usda 1.0
(
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [@../../tests/scenes/emissive.usda@]
)

# For the rect-light look: sublayer ../../tests/scenes/cornell.usda instead.

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/probesOnly
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "probesOnly"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 0
    }

    def RenderSettings "finalGather"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
    }

    def RenderSettings "finalGatherNoRelocation"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:giRelocation = 0
    }

    def RenderSettings "finalGatherDistance0"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
        custom float eldr:finalGatherDistance = 0.0
    }

    def RenderSettings "finalGatherDistance05"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
        custom float eldr:finalGatherDistance = 0.5
    }

    def RenderSettings "denoise0"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
        custom float eldr:finalGatherDenoise = 0.0
    }

    def RenderSettings "denoise1"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
        custom float eldr:finalGatherDenoise = 1.0
    }

    def RenderSettings "rays1"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
        custom int eldr:finalGatherRays = 1
    }

    def RenderSettings "rays4"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
        custom int eldr:finalGatherRays = 4
    }

    def RenderSettings "ssgi"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:ssgi = 1
    }

    def RenderSettings "giPlusSsgi"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:gi = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:ssgi = 1
    }
}
