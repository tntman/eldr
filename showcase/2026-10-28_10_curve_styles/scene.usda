#usda 1.0
(
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [@../../tests/scenes/curves.usda@]
)

# Per-object curve and point styles: width scale, tubes or ribbons, sphere
# points. Each curve sets Karma's name and Eldr's with different values:
# Eldr reads primvars:eldr:object:* first, Karma reads its own, so the
# eldr_default and karma pictures differ where both are set.

# width_scale: eldr 0.4 wins over karma 3
over "bezier"
{
    float primvars:karma:object:width_scale = 3
    float primvars:eldr:object:width_scale = 0.4
}

# karma only: Eldr reads it too
over "bspline"
{
    float primvars:karma:object:width_scale = 2.5
}

# curve_style: eldr 1 (tubes) wins over karma 0 (ribbons)
over "catmullRom"
{
    int primvars:karma:object:curve_style = 0
    int primvars:eldr:object:curve_style = 1
}

over "points"
{
    int primvars:eldr:object:point_style = 1
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/styles
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "styles"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
    }

    # Every curve without its own curve_style as ribbons: catmullRom keeps
    # its eldr curve_style 1 (tubes).
    def RenderSettings "ribbons"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:curveRibbons = 1
    }
}
