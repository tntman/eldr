#usda 1.0
(
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [
        @./geo.usda@
    ]
)

# IES profiles (UsdLux shaping:ies:file, eldr:lightIes): a warm spot with an
# asymmetric 40 degree profile (tests/scenes/textures/spot_asym.ies) shines
# down between the balls of tests/scenes/lightlink.usda; its pool on the
# floor leans towards the light's -X (phi 0), as in Karma.

def Camera "cam"
{
    float focalLength = 24
    float xformOp:rotateX = -18
    double3 xformOp:translate = (0, 3, 8)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def SphereLight "key"
{
    rel collection:lightLink:excludes = </balls/right>
    uniform bool collection:lightLink:includeRoot = 1
    float inputs:intensity = 60
    float inputs:radius = 0.2
    double3 xformOp:translate = (-3, 5, 3)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def SphereLight "fill"
{
    rel collection:shadowLink:excludes = </balls/left>
    uniform bool collection:shadowLink:includeRoot = 1
    color3f inputs:color = (0.6, 0.8, 1)
    float inputs:intensity = 40
    float inputs:radius = 0.2
    double3 xformOp:translate = (5, 2, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Scope "mtl"
{
    def Material "matte"
    {
        token outputs:surface.connect = </mtl/matte/pbr.outputs:surface>

        def Shader "pbr"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
            float inputs:roughness = 0.8
            token outputs:surface
        }
    }
}

def SphereLight "iesSpot" (
    apiSchemas = ["ShapingAPI"]
)
{
    color3f inputs:color = (1, 0.8, 0.55)
    float inputs:intensity = 2
    float inputs:radius = 0.05
    asset inputs:shaping:ies:file = @../../tests/scenes/textures/spot_asym.ies@
    float xformOp:rotateX = -90
    double3 xformOp:translate = (1.1, 3, 1.5)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/ies
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "ies"
    {
        rel camera = </cam>
        custom bool eldr:autoExposure = 0
        custom bool eldr:caustics = 1
        custom bool eldr:filmRestart = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "noIes"
    {
        rel camera = </cam>
        custom bool eldr:autoExposure = 0
        custom bool eldr:caustics = 1
        custom bool eldr:filmRestart = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:lightIes = 0
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        uniform int2 resolution = (960, 540)
    }
}

