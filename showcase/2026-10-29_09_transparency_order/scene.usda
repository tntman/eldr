#usda 1.0
(
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/eldr_default"
    subLayers = [
        @./geo.usda@
    ]
    upAxis = "Y"
)

# tests/scenes/transparency_order.usda: a translucent red quad in front of
# and behind blue glass, and smoke balls behind two panes and between two
# panes. Settings prims flip how translucent layers are ordered and seen.

# Bottom left: two overlapping translucent quads nearer than all the glass
# (no refracting mesh between them in the back-to-front walk), yellow
# behind cyan. Sorted (eldr:oit 0) blends them in order; weighted
# blended OIT averages them by depth weight, so the overlap shifts colour.

def Camera "cam"
{
    float focalLength = 24
    double3 xformOp:translate = (0, 0.3, 9)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def DistantLight "sun"
{
    float inputs:intensity = 3
    bool inputs:normalize = 1
    float3 xformOp:rotateXYZ = (-40, 30, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def DomeLight "sky"
{
    color3f inputs:color = (0.6, 0.7, 1)
    float inputs:intensity = 0.4
}

def Scope "mtl"
{
    def Material "grey"
    {
        token outputs:surface.connect = </mtl/grey/surface.outputs:surface>

        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
            float inputs:roughness = 0.8
            token outputs:surface
        }
    }

    def Material "red"
    {
        token outputs:surface.connect = </mtl/red/surface.outputs:surface>

        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.9, 0.1, 0.1)
            float inputs:opacity = 0.5
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }

    def Material "blueGlass"
    {
        token outputs:mtlx:surface.connect = </mtl/blueGlass/surface.outputs:out>

        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:specular_roughness = 0.05
            bool inputs:thin_walled = 1
            float inputs:transmission = 1
            color3f inputs:transmission_color = (0.3, 0.5, 1)
            token outputs:out
        }
    }

    def Material "greenGlass"
    {
        token outputs:mtlx:surface.connect = </mtl/greenGlass/surface.outputs:out>

        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:specular_roughness = 0.05
            bool inputs:thin_walled = 1
            float inputs:transmission = 1
            color3f inputs:transmission_color = (0.55, 0.9, 0.55)
            token outputs:out
        }
    }

    def Material "cyan"
    {
        token outputs:surface.connect = </mtl/cyan/surface.outputs:surface>

        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.1, 0.8, 0.9)
            float inputs:opacity = 0.7
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }

    def Material "yellow"
    {
        token outputs:surface.connect = </mtl/yellow/surface.outputs:surface>

        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.95, 0.85, 0.1)
            float inputs:opacity = 0.7
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    # main settings prim: /Render/default
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (960, 540)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "default"
    {
        rel camera = </cam>
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "sorted"
    {
        rel camera = </cam>
        custom bool eldr:oit = 0
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "oneLayer"
    {
        rel camera = </cam>
        custom int eldr:refractionLayers = 1
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "volumesOverGlass"
    {
        rel camera = </cam>
        custom bool eldr:volumeUnderTransparency = 0
        uniform int2 resolution = (960, 540)
    }

    def RenderSettings "final"
    {
        rel camera = </cam>
        custom bool eldr:autoExposure = 0
        custom bool eldr:caustics = 1
        custom bool eldr:filmRestart = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        uniform int2 resolution = (960, 540)
    }
}

