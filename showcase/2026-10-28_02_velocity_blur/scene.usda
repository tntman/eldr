#usda 1.0
(
    subLayers = [@../../tests/scenes/motion_blur.usda@]
    startTimeCode = 24
    endTimeCode = 24
)

# Velocity blur needs vblur > 0. eldr: names win over karma: ones.
over "mesh_velocitiesOnly"
{
    over "mesh"
    {
        int primvars:eldr:object:vblur = 1
    }
}

over "mesh_velocitiesAccelerations"
{
    over "mesh"
    {
        int primvars:eldr:object:vblur = 2
    }
}

# karma only: Eldr reads it too
over "pointsVelocities"
{
    over "points"
    {
        int primvars:karma:object:vblur = 1
    }
}

# both: eldr (0, no velocity blur) wins over karma (1)
over "curvesVelocities"
{
    over "curves"
    {
        int primvars:karma:object:vblur = 1
        int primvars:eldr:object:vblur = 0
    }
}

over "inst_velocities"
{
    over "instancer"
    {
        int primvars:eldr:object:instance_vblur = 1
    }
}

over "inst_angularVelocities"
{
    over "instancer"
    {
        int primvars:karma:object:instance_vblur = 1
    }
}

def Scope "Render"
{
    # --- standard settings (houdini/make_showcase_hip.py; rewritten on every run) ---
    def RenderSettings "eldr_default"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
    }
    def RenderSettings "eldr_final"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:caustics = 1
        custom bool eldr:denoise = 1
        custom bool eldr:filmRestart = 1
        custom int eldr:filmSamples = 256
        custom bool eldr:finalGather = 1
        custom bool eldr:gi = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom int eldr:rtShadowLights = 16
        custom int eldr:rtShadowSamples = 1
        custom bool eldr:rtShadows = 1
    }
    def RenderSettings "karma"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom string karma:global:imagefilter = "[\"denoise\",{\"engine\":\"oidn\",\"use_n_input\":true,\"use_albedo_input\":true}]"
        custom int karma:global:pathtracedsamples = 256
    }
    # --- end standard settings ---
    def RenderSettings "blurOn"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:motionBlur = 1
    }

    def RenderSettings "blurOff"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:motionBlur = 0
    }

    def RenderSettings "blurFinal"
    {
        rel camera = </cam>
        int2 resolution = (480, 270)
        custom bool eldr:filmRestart = 1
        custom bool eldr:rtReflections = 1
        custom bool eldr:rtRefraction = 1
        custom bool eldr:rtHitShadows = 1
        custom bool eldr:finalGather = 1
        custom bool eldr:caustics = 1
        custom int eldr:rtShadowSamples = 1
        custom int eldr:rtShadowLights = 16
        custom bool eldr:autoExposure = 0
        custom bool eldr:motionBlurTimeSamples = 1
    }

    def RenderSettings "cameraBlur"
    {
        rel camera = </camMoving>
        int2 resolution = (480, 270)
        custom bool eldr:motionBlur = 1
    }
}
