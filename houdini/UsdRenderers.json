{
    "HdVkRendererPlugin": {
        "valid": true,
        "menulabel": "Eldr",
        "menupriority": 30,
        "depthstyle": "opengl",
        "needsselection": true,
        "statsdatapaths": {
            "percentDone": "$.percentDone",
            "peakMemory": "$.peakMemory",
            "renderStage": "$.rendererStage",
            "gpuTime": "$.gpuTimeMs",
            "triangles": "$.trianglesDrawn",
            "instances": "$.instancesDrawn",
            "drawCalls": "$.drawCalls",
            "gpuMemory": "$.gpuMemoryUsed",
            "textureMemory": "$.textureMemory",
            "taaSamples": "$.numCompletedSamples"
        },
        "viewstats": ["gpuTime", "triangles", "instances", "drawCalls", "gpuMemory", "textureMemory", "taaSamples"]
    }
}
